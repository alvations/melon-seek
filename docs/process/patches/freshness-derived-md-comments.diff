+test('HTML comments are dropped (generated-block markers never show on the page)', () => {
+  const md = 'Before.\n\n<!-- freshness:begin x/y -->\n\n| a | b |\n|---|---|\n| 1 | 2 |\n\n<!-- freshness:end x/y -->\n\n<!--\nmulti-line\n-->\nAfter.\n\n```\n<!-- kept in code -->\n```';
+  const { html } = mdToHtml(md);
+  assert.doesNotMatch(html, /freshness:|multi-line/);
