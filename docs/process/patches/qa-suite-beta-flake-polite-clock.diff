+/**
+ * Run `promise` on a virtual clock (node:test mock timers for setTimeout and Date, enabled by the caller): advance
+ * 1 ms per turn of the event loop until it settles. The spacing is then measured in the clock polite.js reads, so a
+ * loaded machine (a preempted process, a late timer) cannot shrink a measured gap below the one the code kept
+ * (qa-suite-beta T-13: "gaps 27,42" at load 10-12).
+ */
+async function onVirtualClock(promise) {
+  let done = false;
+  const p = Promise.resolve(promise).finally(() => { done = true; });
+  for (let i = 0; !done && i < 600000; i++) {
+    await new Promise((r) => setImmediate(r));
+    if (!done) mock.timers.tick(1);
+  }
+  return p;
+}
 
