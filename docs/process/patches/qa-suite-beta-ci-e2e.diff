--- /dev/null
+++ b/.github/scripts/e2e-summary.mjs
@@ -0,0 +1,67 @@
+// Merge the e2e shard logs (scripts/e2e.js --shard=i/n) into one result, for .github/workflows/e2e.yml.
+//
+//   node .github/scripts/e2e-summary.mjs [--expected <file>] [--summary <file>] <shard log> [...]
+//
+// --expected: one entry per line, `<ID> <owner or decision>` (e.g. `V-33 fix-viz-5`); a test whose name holds `[<ID>]`
+// (or `[<ID>,` / `, <ID>]` in a list of IDs), or starts with it after the group (`Compstimate: T21 cold server`), is
+// red by design until its lane lands. An entry whose reason starts with `flaky` is a known flake: it may pass or fail.
+// Lines starting with # are notes.
+// Exit 1 when a test fails that no entry expects, when a shard log has no final "e2e: N/M passed" line (it timed out or
+// crashed), or when an expected-red test passes (the entry is stale: remove it). Exit 0 otherwise.
+import fs from 'node:fs';
+
+const args = process.argv.slice(2);
+const opt = (k) => { const i = args.indexOf(k); if (i < 0) return null; const v = args[i + 1]; args.splice(i, 2); return v; };
+const expectedFile = opt('--expected');
+const summaryFile = opt('--summary');
+const logs = args;
+
+const expected = new Map();
+if (expectedFile && fs.existsSync(expectedFile)) {
+  for (const line of fs.readFileSync(expectedFile, 'utf8').split('\n')) {
+    const t = line.trim();
+    if (!t || t.startsWith('#')) continue;
+    const [id, ...why] = t.split(/\s+/);
+    expected.set(id, why.join(' '));
+  }
+}
+const idsOf = (name) => {
+  const ids = [...name.matchAll(/\[([^\]]+)\]/g)].flatMap((m) => m[1].split(/,\s*/)).map((x) => x.trim());
+  const lead = /^[^:\[]+: ([A-Z][A-Z0-9]*-?\d+[a-z]?)\b/.exec(name); // the older names: "Compstimate: T21 cold server"
+  return lead ? [...ids, lead[1]] : ids;
+};
+const flaky = (id) => /^flaky\b/i.test(expected.get(id) || '');
+const expectedFor = (name) => idsOf(name).find((id) => expected.has(id)) || null;
+
+const tests = [];
+const unfinished = [];
+for (const f of logs) {
+  const text = fs.readFileSync(f, 'utf8');
+  const lines = text.split('\n');
+  if (!/^e2e: \d+\/\d+ passed/m.test(text)) unfinished.push(f);
+  lines.forEach((l, i) => {
+    let m = /^ {2}✓ (.*?) \((\d+)ms\)$/.exec(l);
+    if (m) return void tests.push({ log: f, name: m[1], ok: true, ms: Number(m[2]) });
+    m = /^ {2}✗ (.*?)(?: \((\d+)ms\))?$/.exec(l);
+    if (m) return void tests.push({ log: f, name: m[1], ok: false, ms: m[2] ? Number(m[2]) : null, err: (lines[i + 1] || '').trim() });
+    m = /^ {2}- (.*) \(skipped: (.*)\)$/.exec(l);
+    if (m) tests.push({ log: f, name: m[1], ok: true, skipped: m[2] });
+  });
+}
+const failed = tests.filter((t) => !t.ok);
+const unexpected = failed.filter((t) => !expectedFor(t.name));
+const known = failed.filter((t) => expectedFor(t.name));
+const stale = tests.filter((t) => t.ok && !t.skipped && expectedFor(t.name) && !flaky(expectedFor(t.name)));
+const skipped = tests.filter((t) => t.skipped);
+const minutes = tests.reduce((a, t) => a + (t.ms || 0), 0) / 60000;
+
+const out = [];
+out.push(`### E2E: ${tests.length} tests in ${logs.length} shard(s), ${tests.length - failed.length - skipped.length} passed, ${failed.length} failed (${known.length} expected), ${skipped.length} skipped; ${minutes.toFixed(0)} min of test time`);
+if (unfinished.length) out.push(`\n**Shards that did not finish:** ${unfinished.join(', ')}`);
+if (unexpected.length) { out.push('\n**Unexpected failures**'); for (const t of unexpected) out.push(`- ${t.name}\n  \`${String(t.err || '').slice(0, 200)}\``); }
+if (stale.length) { out.push('\n**Expected red but passing (take the entry off docs/process/e2e-expected-red.txt)**'); for (const t of stale) out.push(`- [${expectedFor(t.name)}] ${t.name}`); }
+if (known.length) { out.push('\n<details><summary>Expected: red by design or a known flake</summary>\n'); for (const t of known) out.push(`- [${expectedFor(t.name)}: ${expected.get(expectedFor(t.name))}] ${t.name}`); out.push('\n</details>'); }
+const text = out.join('\n');
+console.log(text);
+if (summaryFile) fs.appendFileSync(summaryFile, text + '\n');
+process.exit(unexpected.length || unfinished.length || stale.length ? 1 : 0);
--- /dev/null
+++ b/.github/workflows/e2e.yml
@@ -0,0 +1,119 @@
+name: E2E suite (sharded)
+
+# The full browser suite (node scripts/e2e.js, about 900 tests and 2 hours on one machine) ran nowhere in CI until
+# 2026-10-23 (docs/process/qa-suite-beta.md, T-14): CI ran `npm test` on a build with no data, so every data-dependent
+# check skipped, and the e2e suite ran only on the sandbox. This runs it on the archived crawl (as webkit-phone.yml
+# does), in 4 shards in parallel (scripts/e2e.js --shard=i/4, about 30-45 min each), and fails on a failure that is not
+# a known red-by-design test (docs/process/e2e-expected-red.txt: a reviewer's [ID] test waiting for its fix lane).
+# Manual, nightly, and on pull requests that touch the app or the tests. Never on wip/** checkpoints.
+
+on:
+  workflow_dispatch:
+  schedule:
+    - cron: '41 3 * * *'
+  pull_request:
+    paths: ['public/**', 'server/**', 'scripts/**', 'test/e2e/**', '.github/workflows/e2e.yml', '.github/scripts/e2e-summary.mjs', 'docs/process/e2e-expected-red.txt']
+
+permissions:
+  contents: read
+
+concurrency:
+  group: e2e-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Build the site with real data
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false # read-only job: the token is not left in .git/config (REVIEW.md V12)
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - name: Latest archived crawl (data/snapshots, data/beta/snapshots)
+        run: node scripts/cycle/local-data.js
+      - name: Build
+        run: |
+          node scripts/build-static.js --out dist
+          test -f dist/beta/index.html && test -f dist/beta/api/jobs/amazon.json
+      # The server-mode groups read data/snapshots and data/beta/snapshots; the static groups read dist/.
+      - name: Pack the inputs
+        run: tar -czf e2e-input.tgz dist data/snapshots data/beta/snapshots
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: e2e-input
+          path: e2e-input.tgz
+          retention-days: 3
+
+  e2e:
+    name: E2E shard ${{ matrix.shard }}/4
+    needs: build
+    runs-on: ubuntu-latest
+    timeout-minutes: 75
+    strategy:
+      fail-fast: false
+      matrix:
+        shard: [1, 2, 3, 4]
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false # read-only job: the token is not left in .git/config (REVIEW.md V12)
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          name: e2e-input
+      - run: tar -xzf e2e-input.tgz
+      - name: Playwright (not a repo dependency) and Chromium
+        run: |
+          npm i --no-save playwright@1.63.0
+          npx playwright install --with-deps chromium
+      # --timings: a test's duration in test/e2e/timings.log (a past run's log, refreshed by hand) balances the shards
+      # by time; without it they split by test count. --max-skips: a build without a board turns its tests into skips.
+      - name: node scripts/e2e.js --shard=${{ matrix.shard }}/4
+        env:
+          NODE_PATH: ${{ github.workspace }}/node_modules
+          # A fresh runner has a cold data/cache: the server re-normalizes every board the crawl stored at an older
+          # normalizer version (D-20 took 101 s of the default 120 s on a cold cache, qa-suite-beta section 6).
+          E2E_TEST_TIMEOUT: '240000'
+        run: |
+          set -o pipefail
+          timings=""; [ -f test/e2e/timings.log ] && timings="--timings=test/e2e/timings.log"
+          node scripts/e2e.js --shard=${{ matrix.shard }}/4 $timings --max-skips=20 | tee e2e-shard-${{ matrix.shard }}.log
+        continue-on-error: true # the summary job decides: known red-by-design failures are expected
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        if: always()
+        with:
+          name: e2e-shard-${{ matrix.shard }}
+          path: e2e-shard-${{ matrix.shard }}.log
+          retention-days: 14
+
+  summary:
+    name: E2E summary
+    needs: e2e
+    if: always()
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          persist-credentials: false # read-only job: the token is not left in .git/config (REVIEW.md V12)
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 22
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          pattern: e2e-shard-*
+          merge-multiple: true
+      # Every shard's results in one table; exit 1 on a failure that is not in docs/process/e2e-expected-red.txt,
+      # on a shard that never finished, or on a test that passes while listed as expected red (its lane landed:
+      # take it off the list).
+      - run: node .github/scripts/e2e-summary.mjs --expected docs/process/e2e-expected-red.txt --summary "$GITHUB_STEP_SUMMARY" e2e-shard-*.log
