diff --git a/.github/workflows/webkit-phone.yml b/.github/workflows/webkit-phone.yml
new file mode 100644
index 0000000..313346f
--- /dev/null
+++ b/.github/workflows/webkit-phone.yml
@@ -0,0 +1,128 @@
+name: WebKit phone checks
+
+# docs/process/qa-mobile-beta-2.md (the second mobile QA pass on beta, 2026-10-11). The sandbox the QA agents use
+# has only Chromium, so the phone checks of the company list (M-28 to M-30) and the other scroll areas are run here
+# on WebKit, where installing a browser is fine.
+#   - webkit: test/e2e/beta-mobile-qa-2.e2e.js on Playwright WebKit with an iPhone profile (BETA_QA2_ENGINE=webkit).
+#     Playwright has no touch-drag outside Chromium, so the swipes are wheel scrolls at the same point; the scroll
+#     chaining rules (overscroll-behavior, nested scroll boxes) are the same for both.
+#   - ios-simulator: Safari in the iOS Simulator. Real swipes on the company list with `idb ui swipe`, a real
+#     on-screen keyboard, screenshots before and after (test/e2e/webkit/ios-sim-menu.mjs).
+# Manual only: it needs the data-archive branch for real data, and the macOS job is slow.
+
+on:
+  workflow_dispatch:
+    inputs:
+      ios_devices:
+        description: 'Simulator devices, comma separated (names from `xcrun simctl list devicetypes`)'
+        default: 'iPhone 16,iPhone SE (3rd generation)'
+
+permissions:
+  contents: read
+
+concurrency:
+  group: webkit-phone-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  build:
+    name: Build the site with real data
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - name: Latest archived crawl (data/snapshots, data/beta/snapshots)
+        run: node scripts/cycle/local-data.js
+      - name: Build
+        run: |
+          node scripts/build-static.js --out dist
+          test -f dist/beta/index.html && test -f dist/beta/api/jobs/apple.json
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        with:
+          name: site-dist
+          path: dist
+          retention-days: 3
+
+  webkit:
+    name: Playwright WebKit, iPhone profile
+    needs: build
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 22
+          cache: npm
+      - run: npm ci
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          name: site-dist
+          path: dist
+      - name: Playwright (not a repo dependency) and its browsers
+        run: |
+          npm i --no-save playwright@1.63.0
+          npx playwright install --with-deps webkit chromium
+      - name: Phone tests on WebKit
+        env:
+          BETA_QA2_ENGINE: webkit
+          BETA_QA2_DIST: dist
+        run: node scripts/e2e.js --grep='^Beta mobile QA 2' | tee webkit-e2e.log
+        continue-on-error: true # the [M-n] tests fail until the fix lane lands; the log and screenshots are the result
+      - name: Same tests on Chromium, for comparison
+        env:
+          BETA_QA2_DIST: dist
+        run: node scripts/e2e.js --grep='^Beta mobile QA 2' | tee chromium-e2e.log
+        continue-on-error: true
+      - name: Summary
+        if: always()
+        run: |
+          {
+            echo '### Beta mobile QA 2 on WebKit'; echo '```'; grep -E '^\s+(✓|✗|-) |^e2e:' webkit-e2e.log || true; echo '```'
+            echo '### The same on Chromium'; echo '```'; grep -E '^\s+(✓|✗|-) |^e2e:' chromium-e2e.log || true; echo '```'
+          } >> "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        if: always()
+        with:
+          name: webkit-phone-results
+          path: |
+            webkit-e2e.log
+            chromium-e2e.log
+            docs/screenshots/qa-mobile-beta-2/e2e-*.png
+
+  ios-simulator:
+    name: Safari in the iOS Simulator (real swipes)
+    needs: build
+    runs-on: macos-15
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
+        with:
+          node-version: 22
+      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c # v8.0.1
+        with:
+          name: site-dist
+          path: dist
+      - name: idb (Facebook's iOS Development Bridge) for touch input
+        run: |
+          brew tap facebook/fb
+          brew install facebook/fb/idb-companion
+          python3 -m pip install --break-system-packages fb-idb
+          idb --help > /dev/null
+      - name: Swipe the company list in Simulator Safari
+        env:
+          IOS_DEVICES: ${{ inputs.ios_devices }}
+        run: node test/e2e/webkit/ios-sim-menu.mjs --dist dist --out ios-sim
+      - name: Summary
+        if: always()
+        run: |
+          { echo '### iOS Simulator Safari: company menu'; echo '```'; cat ios-sim/result.txt 2>/dev/null || echo 'no result'; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        if: always()
+        with:
+          name: ios-simulator-results
+          path: ios-sim
diff --git a/test/e2e/webkit/ios-sim-menu.mjs b/test/e2e/webkit/ios-sim-menu.mjs
new file mode 100644
index 0000000..730ee80
--- /dev/null
+++ b/test/e2e/webkit/ios-sim-menu.mjs
@@ -0,0 +1,152 @@
+#!/usr/bin/env node
+// iOS Simulator Safari check of the phone company menu (docs/process/qa-mobile-beta-2.md, M-28 to M-30), for the
+// macOS job of .github/workflows/webkit-phone.yml. Needs Xcode (xcrun simctl) and idb (`idb ui tap|swipe`).
+//
+//   node test/e2e/webkit/ios-sim-menu.mjs --dist dist --out ios-sim [--devices "iPhone 16,iPhone SE (3rd generation)"]
+//
+// For each device it boots a simulator, opens /melon-seek/beta/#c=apple in Safari and then, with real touch input:
+//   1. taps the company menu button (a real tap, so it also shows whether opening it brings up the keyboard: M-29);
+//   2. swipes up on the company rows 6 times;
+//   3. taps the search box (the real on-screen keyboard opens) and swipes the rows 6 times again.
+// Screenshots go to <out>/<device>-<step>.png, every measurement to <out>/<device>.json, and one line per step to
+// <out>/result.txt. A step fails when the last company ("Shield AI") is not fully visible after the swipes, or when
+// the sheet sits outside the visible area with the keyboard up. The page itself is the build, unchanged; the
+// server adds test/e2e/webkit/qa-probe.js to beta/index.html so the page can report its geometry.
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { fileURLToPath } from 'node:url';
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const arg = (n, d) => { const i = process.argv.indexOf(`--${n}`); return i > 0 ? process.argv[i + 1] : d; };
+const DIST = path.resolve(arg('dist', 'dist'));
+const OUT = path.resolve(arg('out', 'ios-sim'));
+const DEVICES = (arg('devices', process.env.IOS_DEVICES || 'iPhone 16,iPhone SE (3rd generation)')).split(',').map((s) => s.trim()).filter(Boolean);
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+fs.mkdirSync(OUT, { recursive: true });
+const results = [];
+const say = (line) => { console.log(line); results.push(line); fs.writeFileSync(path.join(OUT, 'result.txt'), results.join('\n') + '\n'); };
+
+/* ---------------------------------------------------------------- server: the build plus the probe */
+const MIME = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.csv': 'text/csv', '.woff2': 'font/woff2' };
+let log = [];
+let cmd = { id: 0 };
+const server = http.createServer((req, res) => {
+  const u = new URL(req.url, 'http://x');
+  if (u.pathname === '/qa-log' && req.method === 'POST') {
+    let b = ''; req.on('data', (c) => { b += c; }); req.on('end', () => { try { log.push(JSON.parse(b)); } catch { /* ignore */ } res.end('ok'); });
+    return;
+  }
+  if (u.pathname === '/qa-cmd') { res.setHeader('content-type', 'application/json'); return res.end(JSON.stringify(cmd.id > Number(u.searchParams.get('after') || 0) ? cmd : {})); }
+  if (u.pathname === '/melon-seek/qa-probe.js') { res.setHeader('content-type', 'text/javascript'); return res.end(fs.readFileSync(path.join(HERE, 'qa-probe.js'))); }
+  if (!u.pathname.startsWith('/melon-seek/')) { res.writeHead(302, { location: '/melon-seek/' }); return res.end(); }
+  let p = path.join(DIST, decodeURIComponent(u.pathname.slice('/melon-seek/'.length)));
+  if (!p.startsWith(DIST)) { res.writeHead(403); return res.end(); }
+  if (fs.existsSync(p) && fs.statSync(p).isDirectory()) p = path.join(p, 'index.html');
+  if (!fs.existsSync(p)) { res.writeHead(404); return res.end(); }
+  let body = fs.readFileSync(p);
+  if (p === path.join(DIST, 'beta', 'index.html')) body = Buffer.from(String(body).replace('</body>', '<script src="/melon-seek/qa-probe.js"></script></body>'));
+  res.writeHead(200, { 'content-type': MIME[path.extname(p)] || 'application/octet-stream', 'cache-control': 'no-store' });
+  res.end(body);
+});
+await new Promise((r) => server.listen(0, '127.0.0.1', r));
+const ORIGIN = `http://127.0.0.1:${server.address().port}`;
+console.log(`serving ${DIST} at ${ORIGIN}/melon-seek/`);
+
+const sh = (cmdName, args) => execFileSync(cmdName, args, { encoding: 'utf8', stdio: ['ignore', 'pipe', 'inherit'] });
+const waitFor = async (pred, ms = 30000) => { const t0 = Date.now(); for (;;) { const hit = log.slice().reverse().find(pred); if (hit) return hit; if (Date.now() - t0 > ms) return null; await sleep(250); } };
+const send = (name) => { cmd = { id: cmd.id + 1, name }; };
+
+function udidFor(name) {
+  const all = JSON.parse(sh('xcrun', ['simctl', 'list', 'devices', 'available', '-j'])).devices;
+  for (const list of Object.values(all)) for (const d of list) if (d.name === name) return d.udid;
+  const type = JSON.parse(sh('xcrun', ['simctl', 'list', 'devicetypes', '-j'])).devicetypes.find((t) => t.name === name);
+  if (!type) throw new Error(`no simulator device type "${name}"`);
+  const runtime = JSON.parse(sh('xcrun', ['simctl', 'list', 'runtimes', '-j'])).runtimes.filter((r) => r.isAvailable && /iOS/.test(r.name)).pop();
+  return sh('xcrun', ['simctl', 'create', `qa-${name}`, type.identifier, runtime.identifier]).trim();
+}
+
+let failed = 0;
+for (const device of DEVICES) {
+  const tag = device.replace(/\W+/g, '-').replace(/-+$/, '');
+  const measures = [];
+  let udid;
+  try {
+    udid = udidFor(device);
+    try { sh('xcrun', ['simctl', 'boot', udid]); } catch { /* already booted */ }
+    sh('xcrun', ['simctl', 'bootstatus', udid, '-b']);
+    const idb = (...a) => sh('idb', ['ui', ...a, '--udid', udid]);
+    const snap = (step) => { try { sh('xcrun', ['simctl', 'io', udid, 'screenshot', path.join(OUT, `${tag}-${step}.png`)]); } catch (e) { console.log('screenshot failed', e.message); } };
+    log = [];
+    sh('xcrun', ['simctl', 'openurl', udid, `${ORIGIN}/melon-seek/beta/#c=apple`]);
+    const ready = await waitFor((e) => e.kind === 'ready', 120000);
+    if (!ready) throw new Error('the page never showed a card (no "ready" from the probe)');
+    measures.push(ready);
+    await sleep(1500);
+    snap('1-landing');
+    // 1. a real tap on the company menu button. The page fills the screen (viewport-fit=cover), so CSS px are points;
+    // the probe's touchstart gives the exact offset, and the tap is repeated once if it missed.
+    const [bl, bt, br, bb] = ready.data.btn;
+    let off = { x: 0, y: 0 };
+    let tapAt = { x: (bl + br) / 2, y: (bt + bb) / 2 };
+    for (let attempt = 0; attempt < 2; attempt++) {
+      log = log.filter((e) => e.kind !== 'touch' && e.kind !== 'geom');
+      idb('tap', String(Math.round(tapAt.x)), String(Math.round(tapAt.y)));
+      const t = await waitFor((e) => e.kind === 'touch', 5000);
+      if (t) off = { x: tapAt.x - t.data.x, y: tapAt.y - t.data.y };
+      const g0 = await waitFor((e) => e.kind === 'geom', 5000);
+      if (g0?.data?.open) break;
+      // Missed: aim again with the offset the probe measured from this tap.
+      tapAt = { x: (bl + br) / 2 + off.x, y: (bt + bb) / 2 + off.y };
+      await sleep(800);
+    }
+    let g = (await waitFor((e) => e.kind === 'geom', 5000))?.data;
+    if (!g?.open) { send('open-menu'); await sleep(1500); g = (await waitFor((e) => e.kind === 'geom' && e.data.open, 5000))?.data; say(`${device}: the real tap missed the menu button; opened it from the page instead`); }
+    measures.push({ step: 'menu-open', off, g });
+    snap('2-menu-open');
+    say(`${device}: menu open: focus "${g?.focus}", keyboard ${g?.kbOpen ? 'UP' : 'down'} (visual viewport ${g?.vv}), ${g?.fullRows?.length} rows fully visible`);
+    // 2. and 3.: swipe the rows, before and after the keyboard opens
+    const swipeRows = async (label) => {
+      let cur = g;
+      for (let i = 0; i < 6; i++) {
+        const top = Math.max(cur.list[1], cur.body[1], cur.vv ? cur.vv[0] : 0), bottom = Math.min(cur.list[3], cur.body[3], cur.vv ? cur.vv[0] + cur.vv[1] : 9999);
+        if (bottom - top < 24) break;
+        const x = (cur.list[0] + cur.list[2]) / 2 + off.x;
+        log = log.filter((e) => e.kind !== 'geom');
+        idb('swipe', String(Math.round(x)), String(Math.round(top + (bottom - top) * 0.85 + off.y)), String(Math.round(x)), String(Math.round(top + (bottom - top) * 0.15 + off.y)), '--duration', '0.35');
+        cur = (await waitFor((e) => e.kind === 'geom', 5000))?.data || cur;
+        measures.push({ step: `${label}-swipe-${i + 1}`, g: cur });
+      }
+      return cur;
+    };
+    const a = await swipeRows('rows');
+    snap('3-menu-swiped');
+    const passA = a.lastSeen >= 0.99;
+    if (!passA) failed++;
+    say(`${device}: ${passA ? 'PASS' : 'FAIL'} swipes on the rows: ${a.last} ${Math.round(a.lastSeen * 100)}% visible (list ${a.listScroll}, sheet body ${a.bodyScroll}, page ${a.page})`);
+    // the keyboard: a real tap on the search box
+    log = log.filter((e) => e.kind !== 'geom');
+    idb('tap', String(Math.round((a.search[0] + a.search[2]) / 2 + off.x)), String(Math.round((a.search[1] + a.search[3]) / 2 + off.y)));
+    await sleep(2000);
+    g = (await waitFor((e) => e.kind === 'geom', 5000))?.data || a;
+    measures.push({ step: 'keyboard', g });
+    snap('4-keyboard');
+    const sheetVisible = !g.vv || (g.pop[1] >= g.vv[0] - 1 && g.pop[3] <= g.vv[0] + g.vv[1] + 1);
+    if (!sheetVisible) failed++;
+    say(`${device}: ${sheetVisible ? 'PASS' : 'FAIL'} keyboard up: sheet ${g.pop[1]}-${g.pop[3]} in a visual viewport from ${g.vv?.[0]} tall ${g.vv?.[1]}, ${g.fullRows?.length} rows fully visible`);
+    const b = await swipeRows('keyboard');
+    snap('5-keyboard-swiped');
+    const passB = b.lastSeen >= 0.99;
+    if (!passB) failed++;
+    say(`${device}: ${passB ? 'PASS' : 'FAIL'} keyboard up, swipes on the rows: ${b.last} ${Math.round(b.lastSeen * 100)}% visible (list ${b.listScroll}, sheet body ${b.bodyScroll})`);
+  } catch (e) {
+    failed++;
+    say(`${device}: ERROR ${e.message}`);
+  } finally {
+    fs.writeFileSync(path.join(OUT, `${tag}.json`), JSON.stringify({ device, udid, measures, log }, null, 1));
+    if (udid) { try { sh('xcrun', ['simctl', 'shutdown', udid]); } catch { /* ignore */ } }
+  }
+}
+server.close();
+process.exit(failed ? 1 : 0);
diff --git a/test/e2e/webkit/qa-probe.js b/test/e2e/webkit/qa-probe.js
new file mode 100644
index 0000000..d3e71d0
--- /dev/null
+++ b/test/e2e/webkit/qa-probe.js
@@ -0,0 +1,52 @@
+// In-page probe for the iOS Simulator job (test/e2e/webkit/ios-sim-menu.mjs). The driver's server adds it to
+// /melon-seek/beta/index.html only; it is never part of a build. It reports to the driver with same-origin fetches:
+//   - every touchstart's client point (the driver calibrates screen points to CSS px with one tap);
+//   - after each touch ends, the company menu's geometry (as test/e2e/beta-mobile-qa-2.e2e.js menuGeom measures it);
+//   - it runs the driver's commands ("open-menu", "close-menu", "reset") polled from /qa-cmd.
+(function () {
+  const post = (kind, data) => fetch('/qa-log', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ kind, data, t: Date.now() }) }).catch(() => {});
+  const geom = () => {
+    const pop = document.querySelector('#popover');
+    if (!pop || pop.hidden) return { open: false };
+    const body = pop.querySelector('.pop-body'), list = pop.querySelector('.company-list');
+    if (!list) return { open: true, list: null };
+    const items = [...list.querySelectorAll('.company-item')];
+    const last = items[items.length - 1];
+    const vv = window.visualViewport;
+    const edge = vv ? vv.height + vv.offsetTop : innerHeight;
+    const seen = (e) => {
+      const r = e.getBoundingClientRect(), lr = list.getBoundingClientRect(), br = body.getBoundingClientRect();
+      const top = Math.max(r.top, lr.top, br.top, vv ? vv.offsetTop : 0), bottom = Math.min(r.bottom, lr.bottom, br.bottom, edge);
+      return Math.max(0, bottom - top) / r.height;
+    };
+    const R = (e) => { const r = e.getBoundingClientRect(); return [Math.round(r.left), Math.round(r.top), Math.round(r.right), Math.round(r.bottom)]; };
+    return {
+      open: true, pop: R(pop), body: R(body), list: R(list), search: R(pop.querySelector('input.fsearch')),
+      vv: vv ? [Math.round(vv.offsetTop), Math.round(vv.height)] : null, inner: [innerWidth, innerHeight], page: [scrollX, scrollY],
+      bodyScroll: [Math.round(body.scrollTop), body.scrollHeight - body.clientHeight],
+      listScroll: [Math.round(list.scrollTop), list.scrollHeight - list.clientHeight],
+      last: last && last.querySelector('.company-item-name').textContent, lastSeen: last ? Math.round(seen(last) * 100) / 100 : 0,
+      fullRows: items.filter((i) => seen(i) > 0.99).map((i) => i.querySelector('.company-item-name').textContent),
+      focus: document.activeElement && (document.activeElement.className || document.activeElement.tagName),
+      kbOpen: document.body.classList.contains('kb-open'),
+    };
+  };
+  addEventListener('touchstart', (e) => { const t = e.touches[0]; post('touch', { x: t.clientX, y: t.clientY }); }, { passive: true, capture: true });
+  addEventListener('touchend', () => setTimeout(() => post('geom', geom()), 900), { passive: true, capture: true });
+  const ready = setInterval(() => {
+    if (document.querySelector('#resultsList .card[data-id]')) { clearInterval(ready); const b = document.querySelector('#companyMenuBtn').getBoundingClientRect(); post('ready', { btn: [b.left, b.top, b.right, b.bottom].map(Math.round), ua: navigator.userAgent, inner: [innerWidth, innerHeight], dpr: devicePixelRatio, screen: [screen.width, screen.height] }); }
+  }, 300);
+  let seq = 0;
+  setInterval(async () => {
+    try {
+      const r = await fetch(`/qa-cmd?after=${seq}`);
+      const cmd = await r.json();
+      if (!cmd || !cmd.id) return;
+      seq = cmd.id;
+      if (cmd.name === 'open-menu') { if (document.querySelector('#popover').hidden) document.querySelector('#companyMenuBtn').click(); }
+      if (cmd.name === 'close-menu') { const x = document.querySelector('#popover .pop-head .icon-btn'); if (x) x.click(); }
+      if (cmd.name === 'blur') document.activeElement && document.activeElement.blur();
+      setTimeout(() => post('geom', geom()), 900);
+    } catch { /* driver gone */ }
+  }, 400);
+})();
