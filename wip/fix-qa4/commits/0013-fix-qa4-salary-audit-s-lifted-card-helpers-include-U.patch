 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/test/salary-audit.test.js b/test/salary-audit.test.js
index 2bb847b..5e19944 100644
--- a/test/salary-audit.test.js
+++ b/test/salary-audit.test.js
@@ -51,7 +51,9 @@ const CARD = ['payPill', 'salaryRange', 'money', 'moneyRange', 'payRanges', 'ran
