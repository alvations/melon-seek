++  if (Array.isArray(s.ranges) && s.ranges.length >= 2) {
++    const span = Math.min(...s.ranges.map((r) => Number(r.min))) === s.min && Math.max(...s.ranges.map((r) => Number(r.max ?? r.min))) === s.max;
