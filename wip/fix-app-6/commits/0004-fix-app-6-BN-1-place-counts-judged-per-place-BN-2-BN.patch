+ * locations (a country-only posting covers many cities the same way).
+ */
+function judgeAtPlace(F, jobs) {
+  const specs = new Map();
+  const specOf = (k) => {
+    let s = specs.get(k);
+    if (!s) { const l = new Set([k]); s = { ...F, l, lCover: placeCover(l, jobs) }; specs.set(k, s); }
+    return s;
