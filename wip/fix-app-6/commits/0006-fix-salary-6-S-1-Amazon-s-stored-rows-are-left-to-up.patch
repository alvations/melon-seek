 ## 1. Brief
 - Prompt: [prompts/fix-salary-6.md](prompts/fix-salary-6.md). S-1 (persona-beta-2-45-54): pay posted for two or more
diff --git a/server/normalize.js b/server/normalize.js
index 3ddb506..6adfa9d 100644
--- a/server/normalize.js
+++ b/server/normalize.js
@@ -323,6 +323,8 @@ function labelPlaces(label) {
 export function tieRangePlaces(salary, locations = [], text = '') {
   const rs = salary && Array.isArray(salary.ranges) ? salary.ranges : null;
   if (!rs || rs.length < 2 || rs.some((r) => r && Array.isArray(r.locations) && r.locations.length)) return salary;
+  // Amazon's pay-table rows ("USA, TX, Wink", "CAN, ON, Toronto") are tied by its own adapter (DQ-33), never here.
+  if (rs.some((r) => r && /^[A-Z]{3},\s/.test(String(r.label || '')))) return salary;
   let rows = rs.map((r) => ({ ...r }));
   // Scale AI: unnamed rows that the text names, by their figures.
   if (rows.some((r) => !r.label) && text) {
@@ -461,8 +463,9 @@ export function relabelJobs(jobs) {
     } else if (j.salary || j.salaryRaw) {
       const ctx = { text, title, employmentType: j.employmentType || '', countries: [...new Set((j.locations || []).map((l) => l && l.country).filter(Boolean))] };
       if (j.salary) next.salary = safe(() => relabelSalary(j.salary, ctx), j.salary);
-      // S-1 (fix-salary-6): stored structured rows named for places are tied to them, as fresh ones are.
-      if (next.salary) next.salary = safe(() => tieRangePlaces(next.salary, next.locations || [], text), next.salary);
+      // S-1 (fix-salary-6): stored structured rows named for places are tied to them, as fresh ones are. Amazon's stored
+      // rows are its pay table's, which server/sources/upgrade.js#upgradeAmazonJobs re-reads and ties itself (DQ-33).
+      if (next.salary && !String(j.id || '').startsWith('amazon:')) next.salary = safe(() => tieRangePlaces(next.salary, next.locations || [], text), next.salary);
       if (j.salaryRaw) next.salaryRaw = safe(() => relabelSalary(j.salaryRaw, ctx), j.salaryRaw);
     }
     changed = true;
diff --git a/test/fix-salary-6.test.js b/test/fix-salary-6.test.js
index 7ff78e4..6673b3c 100644
--- a/test/fix-salary-6.test.js
+++ b/test/fix-salary-6.test.js
@@ -260,6 +260,14 @@ test('S-1 main site: Scale AI\'s unnamed Greenhouse rows are named and tied by t
   assert.equal(payAt(j, at(j, 'St. Louis')).min, 135200);
 });
 
+test('S-1 Amazon\'s stored pay-table rows are left to its own upgrade (DQ-33): never tied by their labels here', () => {
+  const locations = locsOf(['Canton, Mississippi, USA', 'Wink, Texas, USA']);
+  const sal = { min: 62400, max: 112320, mid: 87360, currency: 'USD', interval: 'year', text: 'USA, TX, Wink - 30.00 - 54.00 USD hourly', kind: 'hourly', zones: 2, source: 'structured', originalInterval: 'hour',
+    ranges: [{ min: 27, max: 48, currency: 'USD', interval: 'hour', label: 'USA, MS, Canton' }, { min: 30, max: 54, currency: 'USD', interval: 'hour', label: 'USA, TX, Wink' }] };
+  const [j] = relabelJobs([{ id: 'amazon:10386388', company: 'amazon', title: 'Data Center Technician', locations, descriptionHtml: '<p>x</p>', salary: sal }]);
+  assert.deepEqual(j.salary.ranges.map((r) => r.locations), [undefined, undefined], 'server/sources/upgrade.js#upgradeAmazonJobs ties and annualizes them from the stored table');
+});
+
 /* ------------------------------------------------------------------ the card and the drawer (public/app.js) */
