   body.is-previewing .results { --sheet-peek: 156px; }
 }
 
+/* M-48: the card's "5 places" / "2 levels" line keeps to the 12 px floor, on one line. */
+.sal-sub { font-size: 12px; white-space: nowrap; }
+
+/* M-51: the job page's meta line: each item carries its "·" (app.js metaPart), and the line is shifted left by one
+   "·" and its gap and clipped there, so the "·" that starts a line (and the first one) never shows and none is left at
+   a line's end. The level badge and the tag, which have no "·", step back in by the same 12 px. */
+.d-meta { margin-left: -12px; clip-path: inset(0 0 0 12px); }
+.d-meta-part { display: inline-flex; align-items: baseline; gap: 6px; }
+.d-meta-part > .sep { flex: none; width: 6px; text-align: center; }
+.d-meta > .sen, .d-meta > .tag { margin-left: 12px; }
+
+/* M-52: touch screens wider than 860 px (a large phone in landscape, the Razr inner screen in landscape, the Surface
+   Duo spanned) keep the desktop layout with touch-sized controls: 44 px targets, and 16 px fields so iOS does not zoom
+   the page into a field it focuses. A mouse (pointer: fine) keeps the desktop sizes. */
+@media (pointer: coarse) and (min-width: 861px) {
+  .company-menu-btn, .search input, .topbar .seg button, .data-badge, .chip, .seg--sm button,
+  .select-field select, .quiet-select select { height: 44px; min-height: 44px; }
+  .icon-btn, .theme-btn { width: 44px; height: 44px; }
+  .data-badge { border-radius: 22px; }
+  .search input, .select-field select, .quiet-select select, .fsearch, input.range-val,
+  .popover input, .popover select, .board-form input, .board-form select, #insightsHost input, #insightsHost select { font-size: 16px; }
+  .fsearch { height: 44px; }
+  .check, .radio, .company-item { min-height: 44px; }
+}
+
 /* M-40 meets fix-data-3's longer names ("Non-Technical Project, Program and Product Management": its end was cut by
    0.42 px at 360 px, and more on narrower phones): a split name that fits whole in two lines flows as one text
    (app.js fitCheckLabels); on the narrowest phones in 13 px, then 12 px, with tighter gaps in its row. */
