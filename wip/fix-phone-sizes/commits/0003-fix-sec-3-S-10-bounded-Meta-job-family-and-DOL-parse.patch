+    let text = null;
+    if (c === '>' || (c !== undefined && WS_CH.test(c))) {
+      if (c === '>') gt = i + 2;
+      else if (gt !== -1 && gt < i + 3) gt = b.indexOf('>', i + 3);
+      if (gt === -1) break; // no tag can close
+      if (gt + 1 <= lastClose) { // <t …>text</t>
+        const e = b.indexOf('</t>', gt + 1);
+        text = b.slice(gt + 1, e);
