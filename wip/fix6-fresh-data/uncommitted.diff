+/**
+ * fix6-fresh-data: the blocks that are a near copy of a team paragraph (a word or two changed) but
+ * too rare to count on their own. Google's AI and Infrastructure paragraph reads "We're the driving
+ * force behind Google's groundbreaking innovations…" on 377 postings and "the driving team" on 68,
+ * each a team paragraph, but "the driving channel" on only 3 (2 roles), so on the 2026-10-16 crawl
+ * its "…development of our TPUs, Vertex AI for Google Cloud…" tagged a data-centre technician
+ * "TPUs" and "GCP". A near copy shares a sentence of at least `minChars` with the team paragraph,
+ * is within 10% of its length in words, and shares at least 90% of its words (counted with
+ * repeats). A paragraph that only shares a sentence or two with a team paragraph keeps its own.
+ * `team`: team-paragraph hashes; `texts`: block hash -> boilerplate key. Returns the new hashes.
+ */
+const NEAR_COPY_SHARE = Number(globalThis.process?.env?.NCS || 0.9);
+const sentencesOf = (key) => key.split(/(?<=[.!?])\s+/);
+function nearCopyOf(team, texts, minChars) {
+  const found = [];
+  if (!team.size) return found;
+  const bySentence = new Map(); // long sentence -> team hashes whose paragraph has it
+  for (const h of team) {
+    const key = texts.get(h);
+    if (!key) continue;
+    for (const s of sentencesOf(key)) {
+      if (s.length < minChars) continue;
+      const list = bySentence.get(s) || [];
+      if (list.length < 50) list.push(h);
+      bySentence.set(s, list);
+    }
+  }
+  if (!bySentence.size) return found;
+  const words = (key) => { const m = new Map(); let n = 0; for (const w of key.split(' ')) { if (w) { m.set(w, (m.get(w) || 0) + 1); n++; } } return { m, n }; };
+  const near = (a, b) => {
+    if (Math.min(a.n, b.n) < NEAR_COPY_SHARE * Math.max(a.n, b.n)) return false;
+    let common = 0;
+    for (const [w, c] of a.m) common += Math.min(c, b.m.get(w) || 0);
+    return common >= NEAR_COPY_SHARE * Math.max(a.n, b.n);
+  };
+  for (const [h, key] of texts) {
+    if (team.has(h)) continue;
+    const cands = new Set();
+    for (const s of sentencesOf(key)) if (s.length >= minChars) for (const t of bySentence.get(s) || []) cands.add(t);
+    if (!cands.size) continue;
+    const mine = words(key);
+    for (const t of cands) if (near(mine, words(texts.get(t)))) { found.push(h); break; }
+  }
+  return found;
+}
