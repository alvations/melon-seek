From 430f0004d632070bf686244c8902e1a815bfc45a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 22:45:19 +0000
Subject: [PATCH 4/6] fix-density: Details is a 44px tap target on phones
 without growing the line; tests read the estimate's and the compare card's
 Details

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 public/viz/viz.css            | 4 ++--
 test/e2e/fix-estimates.e2e.js | 3 ++-
 test/e2e/fix3-compare.e2e.js  | 4 +++-
 test/e2e/ui.e2e.js            | 3 ++-
 4 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/public/viz/viz.css b/public/viz/viz.css
index 071f0d5..c0fd142 100644
--- a/public/viz/viz.css
+++ b/public/viz/viz.css
@@ -142,8 +142,8 @@
 .ms-note__list p { margin: 0; font: inherit; color: inherit; }
 .ms-note__list a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
 @media (max-width: 860px) {
-  /* A 44px-tall tap target that takes no room of its own: the line stays one line tall. */
-  .ms-note__more::before { content: ""; position: absolute; left: -8px; right: -8px; top: 50%; height: 44px; transform: translateY(-50%); }
+  /* A 44px-tall tap target that takes no room of its own (negative margins): the line stays one line tall. */
+  .ms-note__more { min-height: 44px; padding: 0 8px; margin: -14px -8px; display: inline-flex; align-items: center; align-self: center; }
 }
 
 .ms-chart__scroll {
diff --git a/test/e2e/fix-estimates.e2e.js b/test/e2e/fix-estimates.e2e.js
index a89649a..01a4f52 100644
--- a/test/e2e/fix-estimates.e2e.js
+++ b/test/e2e/fix-estimates.e2e.js
@@ -194,7 +194,8 @@ export function registerFixEstimatesTests(suite) {
     await sleep(300);
     const text = (await card.innerText()).replace(/\s+/g, ' ');
     assert(!/xAI\s*\d+\s*\$5\dK/.test(text), `xAI business operations still shows internship pay: "${text.slice(0, 300)}"`);
-    assert(/Internships, fixed-term programmes and on-target earnings/.test(text), 'foot does not say what is left out');
+    // fix-density: the foot is in the card caption's Details list.
+    assert(/Internships, fixed-term programmes and on-target earnings/.test(await card.evaluate((e) => e.textContent)), 'foot does not say what is left out');
     await shot(page, 'after-p10-compare-bizops');
     await fam.selectOption('swe');
     const levels = await lvl.locator('option').allInnerTexts();
diff --git a/test/e2e/fix3-compare.e2e.js b/test/e2e/fix3-compare.e2e.js
index 19d57ba..16fdab1 100644
--- a/test/e2e/fix3-compare.e2e.js
+++ b/test/e2e/fix3-compare.e2e.js
@@ -162,7 +162,7 @@ export function registerFix3CompareTests(suite) {
     const st = await setup(ctx);
     const { page, errors } = await open(ctx, st, { url: `${st.beta}/#c=google&m=insights` });
     let t = await cardText(await compareCard(page));
-    assert(/^Posted pay in the US\b/.test(t.sub) && /for the same kind of role/.test(t.sub), `subtitle: ${t.sub}`); // fix-density: the line, then its Details
+    assert(/^Posted pay in the US\b/.test(t.sub) && /for the same kind of role/i.test(t.sub), `subtitle: ${t.sub}`); // fix-density: the line, then its Details
     assert(/Only pay for roles in the US is compared\./.test(t.foot), `foot: ${t.foot}`);
     assert(!/every location each company lists/.test(t.foot), 'the old "every location" line is gone');
     await page.goto(`${st.beta}/#c=google&m=insights&l=Dublin`); await ready(page);
@@ -252,6 +252,8 @@ export function registerFix3CompareTests(suite) {
     const { page, errors } = await open(ctx, st, { url: `${st.beta}/#c=google&m=insights`, device: PHONE });
     const card = await compareCard(page);
     if (await card.locator('select').nth(0).locator('option[value="design"]').count()) { await card.locator('select').nth(0).selectOption('design'); await sleep(300); }
+    // fix-density: the level line is in the caption's Details list; open it.
+    if (await card.locator('.msi-card__sub > .ms-note__more').count()) { await card.locator('.msi-card__sub > .ms-note__more').click(); await sleep(200); }
     const m = await page.evaluate(() => {
       const c = document.querySelector('#compsCardHost .ms-compare');
       const l = c.querySelector('.msi-compare__levels');
diff --git a/test/e2e/ui.e2e.js b/test/e2e/ui.e2e.js
index 3a03700..43d9a7e 100644
--- a/test/e2e/ui.e2e.js
+++ b/test/e2e/ui.e2e.js
@@ -1082,7 +1082,8 @@ const resetBtn = (page) => page.locator('#compHost').getByRole('button', { name:
 async function readDrawerComp(page) {
   const block = page.locator('#drawer .d-comp');
   if (!(await block.count())) return null;
-  const t = (await block.innerText()).replace(/\s+/g, ' ');
+  // fix-density: the basis, accuracy and "approx USD" are in the block's Details list, so read every text node.
+  const t = (await block.evaluate((e) => { const w = document.createTreeWalker(e, NodeFilter.SHOW_TEXT); const out = []; while (w.nextNode()) out.push(w.currentNode.textContent); return out.join(' '); })).replace(/\s+/g, ' ');
   const mid = t.match(/(?:≈|about)\s*(\$[\d.,]+[KM]?)/);
   const rng = t.match(/\((\$[\d.,]+[KM]?)\s*[–-]\s*\$?([\d.,]+[KM]?)/);
   const conf = t.match(/,\s*([A-Za-z]+) confidence\)/);
