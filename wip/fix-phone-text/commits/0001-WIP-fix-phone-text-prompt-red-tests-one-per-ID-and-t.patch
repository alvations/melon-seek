+// Fix lane fix-phone-text (docs/process/fix-phone-text.md): the phone page's text. The user (2026-10-16):
+// "Whatever was done with the ui/UX it needs to go through the mobile and desktop QC QA again. The mobile page
+// on the beta site is totally broken". The round-3 reviewers found text that runs to 3-5 lines, text cut
+// mid-word and numbers ellipsized (docs/process/qa-mobile-beta-3.md M-33 to M-46, docs/process/ux-review-beta-2.md
+// UX-35 to UX-62, docs/REVIEW.md A-9).
+//
+// The rule (fix-density's, now enforced): on a phone at 390x844 and 360x740, every caption, note or explainer is
+// ONE line, with any further facts behind its Details; no text is cut mid-word except a long proper name in a list
+// row that also shows the whole name on tap and keyboard (ALLOW below); numbers are never cut.
+//
+// Tests tagged "[M-n]", "[UX-n]" or "[A-n]" encode one finding each. "[guard]" scans every big-tech board at both
+// phone sizes in light and dark: every visible caption is measured (lines from its text's line boxes, and from its
+// height over its line-height) and every text box that clips is measured to the sub-pixel (an ellipsis box cuts at
+// 0.01 px over, any other clipping box at 0.5 px), unlike M-27's whole-pixel scrollWidth check.
+//
+// The tests serve the build (FIX_PHONE_TEXT_DIST, else BETA_QA_DIST, else dist/) under /melon-seek/ the way GitHub
+// Pages does; every other host is aborted. They use standard Playwright APIs only (touchscreen.tap, click, keyboard),
+// so they run under any engine. Run alone under WebKit (the webkit job of .github/workflows/webkit-phone.yml):
+//   node test/e2e/fix-phone-text.e2e.js --browser=webkit [--grep=re]
+// FIX_PHONE_TEXT_SHOTS=<dir> saves a screenshot of each failing case there.
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import zlib from 'node:zlib';
+import { fileURLToPath } from 'node:url';
+import { ROOT, assert, skip } from './harness.js';
+import { unpackJobs } from '../../public/api.js';
+
+const IOS = 'Mozilla/5.0 (iPhone; CPU iPhone OS 17_5 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.5 Mobile/15E148 Safari/604.1';
+const ANDROID = 'Mozilla/5.0 (Linux; Android 14; Pixel 7) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/129.0.0.0 Mobile Safari/537.36';
+const P390 = { width: 390, height: 844 };
+const P360 = { width: 360, height: 740 };
+const D1440 = { width: 1440, height: 900 };
+const WORDS = 12;
+const BOARDS = ['amazon', 'apple', 'google', 'meta', 'microsoft', 'netflix', 'nvidia'];
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const MIME = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.csv': 'text/csv', '.txt': 'text/plain', '.woff2': 'font/woff2' };
+
+/**
+ * Text that may be cut, each with the reason. Only a long proper name inside a list row qualifies, and only where a
+ * tap and the keyboard both give the whole name. A number or an amount is never allowed (checked separately).
+ */
+export const ALLOW = [
+  { sel: '#resultsList .card .card-dept, #resultsList .card .dept, #resultsList .card .card-meta > span', why: 'a card\'s department or place name: the card is a button, and a tap or Enter opens the job page with the whole name' },
+  { sel: '#chartHost .ms-crow__name, #chartHost .ms-row__title, #chartHost .ms-row__label, #chartHost .ms-legend__name', why: 'a chart row\'s or legend\'s group name: the row is a button (tap or Enter), whose chip and list title give the whole name' },
+  { sel: '#filterBody .check-label, #popover .check-label', why: 'M-40, owned by the fix-phone-controls lane (a filter row\'s label; the row is a checkbox): left to that lane, listed here so this guard stays about text' },
+  { sel: '.company-list .company-item, .company-list .company-item *', why: 'a company name in the company menu (a list row; the button opens the board, whose top bar names it)' },
+  { sel: '#drawer .ms-comps__name, #drawer .ms-comps__label', why: 'a company name in "Same role elsewhere" (a listbox row; a tap or Enter opens that company\'s roles)' },
+];
+
+/* ------------------------------------------------------------------ the build and pages */
+
+const distDir = () => path.resolve(process.env.FIX_PHONE_TEXT_DIST || process.env.BETA_QA_DIST || path.join(ROOT, 'dist'));
+let shared = null;
+/** Serve the build under /melon-seek/ (gzip, like Pages); null without a beta build. */
+async function serveDist() {
+  if (shared) return shared;
+  const dist = distDir();
+  if (!fs.existsSync(path.join(dist, 'beta', 'index.html')) || !fs.existsSync(path.join(dist, 'beta', 'api', 'jobs'))) return null;
+  const server = http.createServer((req, res) => {
+    const u = new URL(req.url, 'http://x');
+    if (!u.pathname.startsWith('/melon-seek/')) { res.writeHead(302, { location: '/melon-seek/' }); return res.end(); }
+    let rel;
+    try { rel = decodeURIComponent(u.pathname.slice('/melon-seek/'.length)); } catch { res.writeHead(400); return res.end(); }
+    let p = path.join(dist, rel);
+    if (p !== dist && !p.startsWith(dist + path.sep)) { res.writeHead(403); return res.end(); }
+    if (fs.existsSync(p) && fs.statSync(p).isDirectory()) p = path.join(p, 'index.html');
+    if (!fs.existsSync(p)) { res.writeHead(404); return res.end(); }
+    const type = MIME[path.extname(p)] || 'application/octet-stream';
+    const body = fs.readFileSync(p);
+    const gz = /text|javascript|json|svg|csv/.test(type) && /gzip/.test(req.headers['accept-encoding'] || '') && body.length > 1024;
+    res.writeHead(200, { 'content-type': type, ...(gz ? { 'content-encoding': 'gzip' } : {}) });
+    res.end(gz ? zlib.gzipSync(body) : body);
+  });
+  await new Promise((r) => server.listen(0, '127.0.0.1', r));
+  server.unref();
+  const origin = `http://127.0.0.1:${server.address().port}`;
+  shared = { origin, dist, beta: `${origin}/melon-seek/beta/`, main: `${origin}/melon-seek/` };
+  return shared;
+}
+const hasBoard = (st, slug, site = 'beta') => fs.existsSync(path.join(st.dist, site, 'api', 'jobs', `${slug}.json`));
+
+const lists = new Map();
+/** A board's postings, unpacked from the build's static list (the same objects the page gets). */
+async function boardJobs(st, slug, site = 'beta') {
+  const key = `${site}/${slug}`;
+  if (!lists.has(key)) {
+    const f = path.join(st.dist, site, 'api', 'jobs', `${slug}.json`);
+    if (!fs.existsSync(f)) skip(`no ${slug} list in this build`);
+    lists.set(key, await unpackJobs(JSON.parse(fs.readFileSync(f, 'utf8'))));
+  }
+  return lists.get(key);
+}
+
+/**
+ * A fresh page. vp: a phone (isMobile, hasTouch) unless it is wider than 860 px. site 'beta' or 'main'.
+ * Returns { page, go(hash), hash(hash), errors }: go() loads the page and waits for the board's list; hash() changes
+ * the hash in place (the board stays loaded) and waits a little.
+ */
+async function open(ctx, { vp = P390, theme = 'light', site = 'beta' } = {}) {
+  const st = await serveDist();
+  if (!st) skip('no beta build (npm run build, or FIX_PHONE_TEXT_DIST=<dir>)');
+  const mobile = vp.width <= 860;
+  const context = await ctx.browser.newContext({ viewport: vp, colorScheme: theme, ...(mobile ? { isMobile: true, hasTouch: true, deviceScaleFactor: 2, userAgent: vp.width <= 360 ? ANDROID : IOS } : {}) });
+  ctx.cleanup.push(() => context.close().catch(() => {}));
+  await context.route((u) => !u.href.startsWith(st.origin) && !u.href.startsWith('data:') && !u.href.startsWith('blob:'), (r) => r.abort('blockedbyclient'));
+  const page = await context.newPage();
+  const errors = [];
+  page.on('pageerror', (e) => errors.push(`pageerror: ${e.message}`));
+  const base = site === 'main' ? st.main : st.beta;
+  const ready = () => page.waitForFunction(() => {
+    const t = document.querySelector('#resultsTitle');
+    return t && !/Loading/.test(t.textContent) && /\d|No roles/.test(t.textContent) && (document.querySelector('#resultsList .card[data-id]') || /\b0 roles|No roles/.test(t.textContent));
+  }, null, { timeout: 90000 });
+  return {
+    st, page, errors, mobile,
+    async go(h, settle = 700) {
+      await page.goto('about:blank');
+      await page.goto(`${base}${h ? `#${h}` : ''}`);
+      await ready();
+      await sleep(settle);
+    },
+    async hash(h, settle = 700) {
+      await page.evaluate((x) => { location.hash = x; }, h);
+      await ready();
+      await sleep(settle);
+    },
+  };
+}
+async function tap(page, sel, wait = 500) {
+  const loc = page.locator(`${sel} >> visible=true`).first();
+  await loc.scrollIntoViewIfNeeded().catch(() => {});
+  const b = await loc.boundingBox();
+  assert(b, `${sel} has no box`);
+  const mobile = await page.evaluate(() => matchMedia('(pointer: coarse)').matches || 'ontouchstart' in window);
+  if (mobile) await page.touchscreen.tap(b.x + b.width / 2, b.y + b.height / 2);
+  else await loc.click();
+  await sleep(wait);
+}
+const sheetState = (page) => page.evaluate(() => document.body.dataset.sheet);
+async function sheetTo(page, s) { for (let i = 0; i < 4 && (await sheetState(page)) !== s; i++) await tap(page, '#sheetHandle', 600); }
+async function shot(page, name) {
+  const dir = process.env.FIX_PHONE_TEXT_SHOTS;
+  if (!dir) return;
+  fs.mkdirSync(dir, { recursive: true });
+  try { await page.screenshot({ path: path.join(dir, `${name}.png`), timeout: 15000 }); } catch { /* evidence only */ }
+}
+/** Open every fold in the job page (Same role elsewhere, Listing, …) and wait for the comps chart. */
+async function openFolds(page) {
+  await page.evaluate(() => { for (const d of document.querySelectorAll('#drawer details.d-fold')) d.open = true; });
+  await page.waitForFunction(() => !document.querySelector('#drawer .comps-body .sk'), null, { timeout: 15000 }).catch(() => {});
+  await sleep(500);
+}
+async function openJob(s, slug, id) {
+  await s.hash(`c=${slug}&job=${encodeURIComponent(id)}`, 900);
+  await s.page.waitForSelector('#drawer:not([hidden]) #drawerTitle', { timeout: 20000 });
+  await openFolds(s.page);
+}
+const topPaidId = (page) => page.evaluate(() => document.querySelector('#resultsList .card[data-id]')?.dataset.id);
+
+/* ------------------------------------------------------------------ the scanner (runs in the page) */
+
+/** Captions, notes and explainers: what the one-line rule covers. */
+export const CAPTION_SEL = [
+  '.fnote', '.ms-note', '.juice-scale', '#tagline', '.comps-note', '.comps-caveat', '.ms-comps__note', '.comps-asof',
+  '[class*="__sub"]', '[class*="__note"]', '[class*="__explain"]', '[class*="__auto"]', '[class*="__accuracy"]',
+  '[class*="__asof"]', '[class*="-asof"]', '[class*="caption"]', '[class*="caveat"]', '.d-pct-text', '.juice-head-net',
+  '.juice-none', '.listing-lines li', '.d-pool', '.badge-details > p', '.badge-details dd', '.badge-csv', '.badge-beta',
+  '.state-card p', '.d-updated', '.d-posted', '.d-sal-top .muted',
+].join(', ');
+
+/**
+ * In the page: { lines: [...], cut: [...] } under the roots. lines: captions over one line or WORDS words (an .ms-note
+ * is measured by its line, without its Details). cut: any text box that cuts its text, or an input that cuts its
+ * placeholder, unless ALLOW names it (never when the text is a number or an amount).
+ */
+function scanText({ roots, captionSel, allow, words }) {
+  const rootEls = roots.flatMap((r) => [...document.querySelectorAll(r)]);
+  const seen = new Set();
+  const vis = (e) => {
+    if (e.closest('[hidden], .ms-note__list, .sr-only, [role="tooltip"], .ms-viz-tip, .msi-tip, #toast')) return false;
+    const r = e.getBoundingClientRect();
+    if (r.width < 2 || r.height < 2 || r.right <= 0 || r.left >= innerWidth) return false;
+    const cs = getComputedStyle(e);
+    return cs.visibility !== 'hidden' && +cs.opacity > 0.05;
+  };
+  const name = (e) => `${e.tagName.toLowerCase()}${e.id ? `#${e.id}` : ''}${typeof e.className === 'string' && e.className.trim() ? `.${e.className.trim().split(/\s+/).slice(0, 2).join('.')}` : ''}`;
+  const textOf = (e) => (e.innerText || e.textContent || '').replace(/\s+/g, ' ').trim();
+  const isAmount = (t) => /[$€£¥₹]\s?\d|\d\s?[KkM]\b|^\s*[\d.,%–—-]+\s*$/.test(t);
+  /** Line boxes of the element's text, grouped by their vertical middle (the way fix-density counts). */
+  const rectLines = (e) => {
+    const mids = [];
+    const w = document.createTreeWalker(e, NodeFilter.SHOW_TEXT);
+    for (let n; (n = w.nextNode());) {
+      if (!n.textContent.trim() || n.parentElement.closest('.ms-note__more, .ms-note__list, [hidden], .sr-only')) continue;
+      const r = document.createRange();
+      r.selectNodeContents(n);
+      for (const x of r.getClientRects()) {
+        if (x.width < 0.5 || x.height < 0.5) continue;
+        const m = x.top + x.height / 2;
+        if (!mids.some((t) => Math.abs(t - m) < 6)) mids.push(m);
+      }
+    }
+    return mids.length;
+  };
+  /** Lines from the box's height over its line-height, for a plain block of inline text only. */
+  const heightLines = (e) => {
+    const cs = getComputedStyle(e);
+    if (!/^(block|list-item)$/.test(cs.display) || (cs.minHeight !== '0px' && cs.minHeight !== 'auto')) return 0;
+    if ([...e.querySelectorAll('*')].some((c) => c.getClientRects().length && getComputedStyle(c).display !== 'inline')) return 0;
+    const lh = parseFloat(cs.lineHeight) || parseFloat(cs.fontSize) * 1.2;
+    const hgt = e.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
+    return Math.round(hgt / lh);
+  };
+  const lines = [];
+  const caps = rootEls.flatMap((r) => [...(r.matches(captionSel) ? [r] : []), ...r.querySelectorAll(captionSel)]).filter((e) => !seen.has(e) && seen.add(e) && vis(e));
+  const capSet = new Set(caps);
+  for (const e of caps) {
+    // The outermost caption only (a .muted span inside a .fnote is the same line).
+    let up = e.parentElement, inner = false;
+    while (up) { if (capSet.has(up)) { inner = true; break; } up = up.parentElement; }
+    if (inner) continue;
+    const lineEl = e.classList.contains('ms-note') ? e.querySelector(':scope > .ms-note__line') : e;
+    if (!lineEl || !vis(lineEl)) continue;
+    const text = textOf(lineEl);
+    if (!text) continue;
+    const n = Math.max(rectLines(lineEl), heightLines(lineEl));
+    const wc = text.split(' ').filter((x) => /[\p{L}\p{N}]/u.test(x)).length;
+    if (n > 1 || wc > words) lines.push({ sel: name(e), text: text.slice(0, 170), lines: n, words: wc });
+  }
+  const cut = [];
+  const allowed = (e) => allow.find((a) => e.matches(a.sel));
+  for (const root of rootEls) {
+    for (const e of [root, ...root.querySelectorAll('*')]) {
+      if (seen.has(`cut:${name(e)}:${textOf(e)}`)) continue;
+      if (e.tagName === 'INPUT') {
+        if (!e.placeholder || e.value || !vis(e)) continue;
+        const cs = getComputedStyle(e);
+        const c = document.createElement('canvas').getContext('2d');
+        c.font = `${cs.fontStyle} ${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
+        const need = c.measureText(e.placeholder).width, have = e.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
+        if (need > have + 0.5) cut.push({ sel: name(e), text: `placeholder "${e.placeholder}"`, over: +(need - have).toFixed(2) });
+        continue;
+      }
+      if (![...e.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim()) || !vis(e)) continue;
+      // The box that clips this text: the element, or for an inline element its nearest non-inline ancestor.
+      let box = e;
+      while (box.parentElement && getComputedStyle(box).display === 'inline') box = box.parentElement;
+      const cs = getComputedStyle(box);
+      const ell = cs.textOverflow === 'ellipsis' && cs.overflowX !== 'visible';
+      const clips = /hidden|clip/.test(cs.overflowX);
+      const clamp = cs.webkitLineClamp && cs.webkitLineClamp !== 'none';
+      if (!ell && !clips && !clamp) continue;
+      const br = box.getBoundingClientRect();
+      const left = br.left + parseFloat(cs.borderLeftWidth) + parseFloat(cs.paddingLeft);
+      const right = br.right - parseFloat(cs.borderRightWidth) - parseFloat(cs.paddingRight);
+      const r = document.createRange();
+      r.selectNodeContents(e);
+      const tr = r.getBoundingClientRect();
+      const over = Math.max(left - tr.left, tr.right - right, box.scrollWidth - box.clientWidth);
+      const vOver = clamp ? box.scrollHeight - box.clientHeight : 0;
+      if (!(over > (ell ? 0.01 : 0.5) || vOver > 1)) continue;
+      const text = textOf(e);
+      seen.add(`cut:${name(e)}:${text}`);
+      const a = allowed(e);
+      if (a && !isAmount(text)) continue;
+      cut.push({ sel: name(e), text: text.slice(0, 120), over: +Math.max(over, vOver).toFixed(2), ...(a ? { why: 'an amount is never cut, even in an allowed row' } : {}) });
+    }
+  }
+  return { lines, cut };
+}
+async function scan(page, roots) {
+  return page.evaluate(scanText, { roots: [].concat(roots), captionSel: CAPTION_SEL, allow: ALLOW.map(({ sel }) => ({ sel })), words: WORDS });
+}
+/** One message per problem, for an assertion. */
+function report(res, where) {
+  return [
+    ...res.lines.map((m) => `${where} ${m.sel}: ${m.lines > 1 ? `${m.lines} lines` : ''}${m.lines > 1 && m.words > WORDS ? ', ' : ''}${m.words > WORDS ? `${m.words} words` : ''}: "${m.text}"`),
+    ...res.cut.map((m) => `${where} ${m.sel}: cut off by ${m.over} px${m.why ? ` (${m.why})` : ''}: "${m.text}"`),
+  ];
+}
+/** Only what sel matches (and what is inside it), measured with the guard's rules: for the one-ID tests. */
+function captions(page, sel) {
+  return page.evaluate(scanText, { roots: [sel], captionSel: `${CAPTION_SEL}, ${sel}`, allow: [], words: WORDS });
+}
+/** Measure sel with the guard's rules (lines, words and cuts), as messages. */
+async function check(page, sel, where) {
+  return report(await captions(page, sel), where);
+}
+
+/* ------------------------------------------------------------------ the guard: one walk over a board */
+
+/** Postings to open on each board: the top-paid one, one with no pay, a stated minimum, a pool, a long-open one. */
+async function picks(st, slug) {
+  const jobs = await boardJobs(st, slug);
+  return {
+    noPay: jobs.find((j) => !j.salary && !j.salaryFlag),
+    minimum: jobs.find((j) => j.salary?.kind === 'minimum' && j.salary.currency !== 'USD'),
+    pool: jobs.find((j) => j.pool === true),
+    longOpen: jobs.find((j) => j.salary && j.ageDays >= 180),
+    ote: jobs.find((j) => j.salary?.kind === 'ote'),
+  };
+}
+
+async function guardWalk(s, slug) {
+  const { page } = s;
+  const p = await picks(s.st, slug);
+  const out = [];
+  const look = async (where, roots) => { out.push(...report(await scan(page, roots), where)); };
+  await s.go(`c=${slug}`);
+  const top = await topPaidId(page);
+  await look('first screen', ['.topbar', '.quickbar', '#vizToolbar', '#tagline', '#vizArea']);
+  await sheetTo(page, 'half');
+  await look('list (half sheet)', ['#results']);
+  await sheetTo(page, 'full');
+  await look('list (full sheet)', ['#results']);
+  await sheetTo(page, 'peek');
+  await s.hash(`c=${slug}&v=ranges`, 900);
+  await look('Ranges', ['#vizToolbar', '#vizArea']);
+  await s.hash(`c=${slug}&m=map`, 1200);
+  await look('map', ['#vizToolbar', '#vizArea']);
+  await s.hash(`c=${slug}&m=insights`, 900);
+  await page.waitForSelector('#insightsHost .msi-stat', { timeout: 60000 }).catch(() => {});
+  await page.waitForSelector('#compHost .ms-comp__card, #compHost .ms-comp__empty', { timeout: 60000 }).catch(() => {});
+  await sleep(600);
+  await look('Insights', ['#main']);
+  for (const [what, id] of [['top-paid job', top], ['job with no pay', p.noPay?.id], ['stated minimum', p.minimum?.id], ['general application', p.pool?.id], ['open 180+ days', p.longOpen?.id], ['on-target earnings', p.ote?.id]]) {
+    if (!id) continue;
+    await openJob(s, slug, id);
+    await look(`job page, ${what} (${id})`, ['#drawer']);
+  }
+  await s.hash(`c=${slug}`, 900);
+  await tap(page, '#filtersToggle', 900);
+  await page.evaluate(() => { for (const d of document.querySelectorAll('#filterBody details')) d.open = true; });
+  await sleep(500);
+  await look('filter sheet', ['#filters']);
+  await page.keyboard.press('Escape');
+  await sleep(500);
+  if (await page.evaluate(() => !document.querySelector('#filters')?.matches('.is-open, [data-open="true"]'))) { /* closed */ }
+  await s.hash(`c=${slug}`, 600);
+  await tap(page, '#dataBadge', 900);
+  await look('data badge popover', ['#popover']);
+  await page.keyboard.press('Escape');
+  await sleep(400);
+  await page.evaluate(() => document.querySelector('#quickChips [data-pop=more]')?.scrollIntoView({ inline: 'center' }));
+  await sleep(250);
+  await tap(page, '#quickChips [data-pop=more]', 900);
+  await look('More sheet', ['#popover']);
+  await page.keyboard.press('Escape');
+  await sleep(400);
+  await tap(page, '#companyMenuBtn', 900);
+  await look('company menu', ['#popover']);
+  await page.keyboard.press('Escape');
+  return out;
+}
