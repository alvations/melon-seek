 @media (max-width: 860px) { .stats-line .stat--nopay { display: inline; } }
 /* M-38: the percentile line is fitted to one line (app.js fitOneLine); when nothing fits it wraps, never "…". */
 .d-pct-text.is-wrapped { white-space: normal; overflow: visible; text-overflow: clip; }
-/* The tagline under 360 px: its shortest line ("melon·seek · Beta: 7 big-tech sites"; the full line is its title). */
