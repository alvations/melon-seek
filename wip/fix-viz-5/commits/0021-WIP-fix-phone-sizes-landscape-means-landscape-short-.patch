    =================================================================== */
 /* A-3: at 200% zoom (640 x 450 CSS px) the one-row top bar keeps the company name whole on the beta site:
-   the badge takes its shortest label and the logo gives its room (the Beta tag and the menu carry identity). */
-@media (max-width: 860px) and (max-height: 500px) {
+   the badge takes its shortest label and the logo gives its room (the Beta tag and the menu carry identity).
+   fix-phone-sizes: the one-row top bar's rule, so landscape and at least 560 px wide, like it. */
+@media (max-width: 860px) and (max-height: 500px) and (orientation: landscape) and (min-width: 560px) {
   html[data-channel="beta"] .data-badge .badge-label::before { content: attr(data-micro); }
   html[data-channel="beta"] .brand { display: none; }
   html[data-channel="beta"] .company-bar { flex: 0 0 auto; max-width: 240px; } /* the search box gives way first */
@@ -1459,3 +1462,145 @@ html[data-mode="map"] .tagline, html[data-mode="insights"] .tagline { display: n
    arrow, which would point past the pin; the Juice household's meaning, one muted line under its buttons. */
 .ms-map .leaflet-tooltip.ms-map-tip--slid::before { display: none; }
 .juice-hh-note { margin: 6px 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+/* ===================================================================
+   fix-phone-sizes (docs/process/fix-phone-sizes.md, 2026-10-17): every size in test/e2e/phone-sizes.mjs, from the
+   folded Galaxy Fold (280 px) to the Surface Duo spanned (1114 px), the Razr cover screen and landscape.
+   Each finding is its own rule block. test/e2e/phone-matrix.e2e.js checks them all.
+   =================================================================== */
+/* Short screens that are not landscape (the Razr cover screen, 352x355): the two-row top bar stays, since one row needs
+   about 500 px; the rows and the toolbar get tighter, and the chart keeps its room the way landscape does (no stats
+   line, strip or notes line; a shorter peek row). */
+@media (max-width: 559px) and (max-height: 500px) {
+  :root { --m-topbar: calc(4px + var(--m-row) + 4px + var(--m-row) + 4px + env(safe-area-inset-top)); --m-quickbar: 52px; --sheet-peek: 64px; --sheet-half: .45; }
+  .topbar { padding-top: calc(4px + env(safe-area-inset-top)); padding-bottom: 4px; row-gap: 4px; }
+  .topbar::after { margin-top: -4px; }
+  .viz-toolbar { padding-top: 4px; padding-bottom: 4px; }
+  .stats-line, .tagline { display: none; }
+  .ms-chart__hist, .ms-chart__foot { display: none; }
+  .results-head { min-height: 40px; }
+  .sheet-handle { height: 20px; }
+  body.kb-open .popover--company .pop-head { display: none; }
+  body.kb-open .popover--company .pop-body { padding-top: 10px; }
+}
+
+/* The company name is whole at every width (the 280–352 px phones, M-45 at 380–392 px, Microsoft at 441–460 px).
+   Row 1 gives way in this order: the badge's longer label (479 px and below: "● Oct 16"), 16 px of spacing (399 px and
+   below: the gaps, the menu's and the badge's padding; the logo stays by the Beta tag, I-2 and M-27), the logo on the
+   beta site (379 px and below, as before), the logo on the main site and the Beta tag (359 px and below: the line above
+   the chart says "melon·seek · Beta", and the badge's sheet says it is the beta site, with a link to the main site),
+   then the badge's date (319 px and below: the dot stays, the date and source are in its sheet). The theme button
+   stays (44 px). */
+@media (max-width: 479px) {
+  .data-badge .badge-label::before { content: attr(data-micro); }
+}
+@media (max-width: 399px) {
+  .topbar { column-gap: 6px; }
+  .company-menu-btn { padding: 0 8px 0 10px; }
+  .data-badge, .data-badge.is-demo { padding: 0 10px; }
+}
+@media (max-width: 359px) {
+  .brand, .beta-tag { display: none; }
+}
+@media (max-width: 319px) {
+  .data-badge:not(.is-demo) .badge-label { display: none; }
+  .data-badge:not(.is-demo) { min-width: var(--m-row); padding: 0; justify-content: center; }
+}
+
+/* The one-row landscape top bar keeps the name whole on both sites (A-3 did it for the beta site only; "Anthropic" was
+   cut at 560–600 px on the main site): the badge's shortest label, the search box gives way first, tighter tabs. Below
+   640 px the logo and the Beta tag go too, as in portrait at 359 px. */
+@media (max-width: 860px) and (max-height: 500px) and (orientation: landscape) and (min-width: 560px) {
+  .data-badge .badge-label::before { content: attr(data-micro); }
+  .company-bar { flex: 0 0 auto; max-width: 240px; }
+  .topbar .seg button { padding: 0 6px; }
+}
+@media (max-width: 639px) and (max-height: 500px) and (orientation: landscape) and (min-width: 560px) {
+  .brand, .beta-tag { display: none; }
+}
+
+/* Row 2 (search, Chart / Map / Insights) stays one row down to 320 px with tighter tabs; at 319 px and below the view
+   switch takes its own full-width row (three equal tabs), and the top bar's height says three rows. */
+@media (max-width: 359px) {
+  .topbar .seg button { padding: 0 8px; }
+  .search { flex-basis: 100px; }
+}
+@media (max-width: 319px) {
+  :root { --m-topbar: calc(6px + var(--m-row) + 6px + var(--m-row) + 6px + var(--m-row) + 6px + env(safe-area-inset-top)); }
+  .search { flex: 1 1 100%; }
+  .topbar .seg { flex: 1 1 100%; }
+  .topbar .seg button { flex: 1 1 0; justify-content: center; }
+}
+
+/* The search box: while it is empty its clear button takes no room, so the placeholder app.js picked (fitSearchHint)
+   shows whole ("Search roles" was cut to "Search role" at 352 px: the hidden button kept 14 px). */
+.search input:placeholder-shown::-webkit-search-cancel-button { display: none; }
+
+/* The chart toolbar at 319 px and below: Clusters | Ranges and the Group select fit the width (the select ran to
+   x 301 on a 280 px screen). */
+@media (max-width: 319px) {
+  .viz-controls { gap: 4px; }
+  .seg--sm button { padding: 0 8px; font-size: 13px; }
+  .quiet-select select { max-width: none; padding: 0 18px 0 4px; background-position: right 0 center; }
+}
+
+/* The line above the chart is one line with nothing cut off: 12 px text at 339 px and below; at 319 px and below the
+   beta line drops its "melon·seek ·" (the Beta line itself stays). */
+@media (max-width: 339px) {
+  .tagline { font-size: 12px; }
+}
+@media (max-width: 319px) {
+  html[data-channel="beta"] .tagline-brand, html[data-channel="beta"] .tagline-sep { display: none; }
+}
+
+/* Cards: when a long pay pill ("$296K–497K · 2 places") would leave the title less than 8em, the pill goes under the
+   title instead of pushing the card wider than the screen (280–320 px). */
+@media (max-width: 860px) {
+  .card-top { flex-wrap: wrap; row-gap: 4px; }
+  .card-title { flex: 1 1 8em; }
+}
+
+/* The job page's Apply button: its label wraps instead of pushing the button off the screen (it was 346–363 px of
+   one line, so the job page was wider than phones of 363 px and less). */
+@media (max-width: 860px) {
+  .drawer-foot .apply { min-width: 0; height: auto; min-height: 48px; padding-top: 6px; padding-bottom: 6px; white-space: normal; text-align: center; line-height: 1.25; }
+}
+
+/* The map's Pay | Juice box at 379 px and below: the pay scale and its "Median pay · Details" line go under the switch
+   (the scale's 168 px ran past the box and the screen: to x 363 on a 344 px phone, and "Details" to x 322 on 320). */
+@media (max-width: 379px) {
+  .ms-map .ms-modes.ms-modes--pay { flex-wrap: wrap; }
+  .ms-modes--pay .ms-modes__pay { flex: 1 1 100%; }
+}
+
+/* Dual screens (the Surface Duo spanned: two 540 px screens, a 34 px hinge at 540–574). env(viewport-segment-*) are the
+   screens' edges. The chart and the filters are on the left screen, the list and the job page on the right, and
+   nothing lies on the hinge: the top bar and the quick bar put their right-hand controls on the right screen, the
+   toast shows on the right screen, and popovers open on their control's screen (app.js positionPopover). */
+@media (horizontal-viewport-segments: 2) {
+  .layout, body.filters-collapsed .layout {
+    display: grid;
+    grid-template-columns: env(viewport-segment-width 0 0) calc(env(viewport-segment-left 1 0) - env(viewport-segment-right 0 0)) env(viewport-segment-width 1 0);
+    grid-template-areas: "main . results";
+  }
+  .filters, body.filters-collapsed .filters { width: env(viewport-segment-width 0 0); }
+  .drawer { width: env(viewport-segment-width 1 0); }
+  /* The right-hand group starts 8 px into the right screen; its margin keeps the left group 8 px clear of the hinge. */
+  .topbar-right {
+    flex: none; width: calc(env(viewport-segment-width 1 0) - 24px);
+    margin-left: calc(env(viewport-segment-left 1 0) - env(viewport-segment-right 0 0));
+  }
+  .topbar-right .seg { margin-right: auto; }
+  .quickbar-end {
+    flex: none; width: calc(env(viewport-segment-width 1 0) - 24px); justify-content: flex-start;
+    margin-left: calc(env(viewport-segment-left 1 0) - env(viewport-segment-right 0 0) + 8px);
+  }
+  .quick-chips { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 18px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 18px), transparent); padding-right: 18px; }
+  .toast { left: calc(env(viewport-segment-left 1 0) + env(viewport-segment-width 1 0) / 2); }
+  /* The line above the chart takes its own line under Clusters | Ranges and Group, so it is whole on a 540 px screen. */
+  .tagline { flex: 1 1 100%; margin: 0; text-align: left; }
+}
+
+/* The search box's "/" key hint never takes a tap meant for the box (it covered the box's right end on the Duo's
+   narrow search), and touch screens without a keyboard don't show it. */
+.search kbd { pointer-events: none; }
+@media (hover: none) { .search kbd { display: none; } }
