+
+/* ===================================================================
+   fix-ui-6 phase 2 (docs/process/ux-density-6.md §3.3, the user 2026-10-24: "make sure that the amount of information
+   scales as per phone iPad sizes from iPhone mini up to like iPhone 18 pro max or even iPhone Duo"). app.js setFit sets
+   <html data-fit> by the visible height (short ≤ 500, compact 501–699, tall 700–959, tablet ≥ 960 on the phone layout;
+   wide over 860 px) and data-chart-fold; markReturning sets data-returning. Nothing is removed: what folds is one tap
+   away (the chart's Details, the sheet, a row's tap), and every posting and pay row stays.
+   =================================================================== */
+/* D-4, D-5, D-7, D-8: the folded chart on compact and short screens and the Duo's chart screen (chart.js reads it). */
+:root[data-chart-fold] { --ms-fold: 1; }
+/* D-3: on a return visit the line that says what the site is for gives its row to the chart (phones, tablets in the
+   phone layout, the Duo's chart screen). Its words stay in the page title, the logo's and the Beta tag's titles. */
+@media (max-width: 860px) { :root[data-returning] .tagline { display: none; } }
+:root[data-returning][data-chart-fold] .tagline { display: none; }
+/* D-2: the median once on the screen, in the chart's own caption, in Chart view at every size. Phones: no stats line in
+   Chart view (the sheet's count row has the count, the caption's Details the share); tablets and wider: the count and the
+   share. What leaves the screen stays in the page for a screen reader (the stats line is the page's summary), as the
+   visually hidden "Group:" label does. Map view and Insights keep the stats line's median (the map has no caption). */
+:root[data-mode="chart"] .stats-line :is(.stat--median, .stat-sep:has(+ .stat--median)) {
+  position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
+}
+@media (max-width: 860px) {
+  :root[data-mode="chart"]:not([data-fit="tablet"]) .stats-line {
+    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
+  }
+  :root[data-mode="chart"][data-fit="tablet"] .stats-line { flex: 1 1 auto; }
+  :root[data-mode="chart"][data-fit="tablet"] .stats-line :is(.stat--count, .stat--share, .stat-sep:not(:has(+ .stat--median))) { display: inline; }
+  :root[data-mode="chart"][data-fit="tablet"] .viz-controls { width: auto; }
+}
+/* D-1: the sheet's peek is the grip (20 px) and the count row (48 px), a 68 px drag zone, and the first card down to its
+   pay (app.js fitSheet measures it); the Juice line (UX-35) explains the cards' Juice badges, below the peek, so it shows
+   from half up. */
