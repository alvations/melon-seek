+/* ---------- folded (fix-ui-6, ux-density-6 D-4, D-5, D-7, D-8) ----------
+   On compact and short screens the host sets --ms-fold: 1 (styles.css) and chart.js folds the chart: the strip and the
+   Ranges legend show only while the caption's Details is open; the notes line is that Details' first item, so the chart
+   has one Details, at the caption's end; opened, the caption, the list and the strip scroll with the rows. */
+.ms-chart--fold:not(.is-unfolded) .ms-chart__hist, .ms-chart--fold:not(.is-unfolded) .ms-chart__head { display: none; }
+.ms-chart--fold.is-unfolded .ms-chart__hist { display: block; }
+.ms-chart--fold.is-unfolded .ms-chart__sticky { position: relative; }
+.ms-chart--fold .ms-chart__caprow { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 0; }
+.ms-chart--fold:not(.ms-chart--narrow) .ms-chart__caprow { padding-left: 16px; padding-right: 16px; }
+.ms-chart--fold .ms-chart__caprow[hidden] { display: none; }
+.ms-chart__capnote.ms-note { display: contents; }
+.ms-chart--fold .ms-chart__capsep { white-space: pre; }
+.ms-chart__capnote .ms-note__more { margin-left: auto; }
+.ms-chart__foldlist.ms-note__list { width: auto; min-width: 0; contain: none; margin: 2px 0 6px; padding: 0 12px 0 28px; font-size: 12px; white-space: normal; }
+.ms-chart--fold:not(.ms-chart--narrow) .ms-chart__foldlist.ms-note__list { padding-left: 32px; }
+/* A folded row: the line from its lowest to its highest posted pay (an end without a cap runs on past the axis, where the
+   "‹N" / "›N" chips count the roles), the band (its middle half) and the median tick over it; no circles. */
+.ms-crow__range {
+  position: absolute; top: 50%;
+  height: 2px; margin-top: -1px;
+  border-radius: 1px;
+  background: var(--c);
+  pointer-events: none;
+}
+.ms-crow__range::before, .ms-crow__range::after {
+  content: ""; position: absolute; top: -4px;
+  width: 2px; height: 10px; border-radius: 1px;
+  background: var(--c);
+}
+.ms-crow__range::before { left: -1px; }
+.ms-crow__range::after { right: -1px; }
+.ms-crow__range--lo-out::before, .ms-crow__range--hi-out::after { display: none; }
+.ms-crow__span { position: absolute; top: 0; bottom: 0; border-radius: 8px; cursor: pointer; outline: none; pointer-events: auto; }
+.ms-crow__span.is-hover, .ms-crow__span.is-selected { box-shadow: inset 0 0 0 2px var(--c); }
+.ms-crow__span.is-highlighted { box-shadow: inset 0 0 0 2px var(--_text); }
+.ms-crow__span.is-active { box-shadow: inset 0 0 0 2px var(--_accent); }
