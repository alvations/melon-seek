diff --git a/public/app.js b/public/app.js
index 93a1cf1..3dff0ee 100644
--- a/public/app.js
+++ b/public/app.js
@@ -2895,6 +2895,7 @@ function setFit() {
   root.dataset.fit = fit;
   const twoScreens = matchMedia('(horizontal-viewport-segments: 2)').matches || matchMedia(DUO_SPANNED).matches;
   root.toggleAttribute('data-chart-fold', fit === 'short' || fit === 'compact' || (fit === 'wide' && twoScreens && h < 700));
+  syncStatsFold();
 }
 
 /**
@@ -3066,6 +3067,24 @@ function renderKpis() {
   statsNotes = details;
   chart?.setNotes?.(fold ? details : []);
   renderNote(el, { line: [...line.flatMap((p, i) => (i ? [h('span', { class: 'stat-sep', 'aria-hidden': 'true' }, '·'), p] : [p])), noPay], details: fold ? [] : details, key: 'stats-line' });
+  syncStatsFold();
+}
+/**
+ * ux-density-6 D-2 (fix-ui-6 phase 2): in Chart view the chart's caption says the median, so the stats line's median leaves
+ * the screen, and on the phone layout short of a tablet the whole line (the sheet's count row has the count, the caption's
+ * Details the share). Both stay for a screen reader (.sr-only): the stats line is the page's summary. Map view and
+ * Insights keep it. Run after each render of the line and when the size class changes.
+ */
+function syncStatsFold() {
+  const el = $('#statsLine');
+  if (!el) return;
+  const chart = S.m === 'chart';
+  el.classList.toggle('sr-only', chart && isMobile() && document.documentElement.dataset.fit !== 'tablet');
+  for (const m of el.querySelectorAll('.stat--median')) {
+    m.classList.toggle('sr-only', chart);
+    const sep = m.previousElementSibling;
+    if (sep?.classList.contains('stat-sep')) sep.classList.toggle('sr-only', chart);
+  }
 }
 let statsNotes = []; // UX-57: the stats line's facts, for the chart notes
 
diff --git a/public/styles.css b/public/styles.css
index fa5269f..8f51ead 100644
--- a/public/styles.css
+++ b/public/styles.css
@@ -1822,17 +1822,11 @@ html[data-mode="map"] .tagline, html[data-mode="insights"] .tagline { display: n
    phone layout, the Duo's chart screen). Its words stay in the page title, the logo's and the Beta tag's titles. */
 @media (max-width: 860px) { :root[data-returning] .tagline { display: none; } }
 :root[data-returning][data-chart-fold] .tagline { display: none; }
-/* D-2: the median once on the screen, in the chart's own caption, in Chart view at every size. Phones: no stats line in
-   Chart view (the sheet's count row has the count, the caption's Details the share); tablets and wider: the count and the
-   share. What leaves the screen stays in the page for a screen reader (the stats line is the page's summary), as the
-   visually hidden "Group:" label does. Map view and Insights keep the stats line's median (the map has no caption). */
-:root[data-mode="chart"] .stats-line :is(.stat--median, .stat-sep:has(+ .stat--median)) {
-  position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
-}
+/* D-2: the median once on the screen, in the chart's own caption, in Chart view at every size (app.js syncStatsFold
+   moves the stats line's median, and on the phone layout short of a tablet the whole line, to .sr-only: the sheet's count
+   row has the count, the caption's Details the share, and a screen reader keeps the summary). Tablets and wider show the
+   count and the share; Map view and Insights keep the stats line's median (the map has no caption). */
 @media (max-width: 860px) {
-  :root[data-mode="chart"]:not([data-fit="tablet"]) .stats-line {
-    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
