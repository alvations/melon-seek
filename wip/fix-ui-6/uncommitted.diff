+  .topbar { flex-wrap: nowrap; }
+  .topbar::after { display: none; }
+  .company-bar { flex: 0 0 auto; max-width: 260px; }
+  .search { order: 3; flex: 1 1 0; min-width: 0; }
+  .topbar .seg { order: 4; }
+  .data-badge { order: 5; }
+  .theme-btn { order: 6; }
+  .data-badge .badge-label::before { content: attr(data-micro); }
+}
+@media (min-width: 640px) and (max-width: 759px) {
+  html[data-channel="beta"] .brand { display: none; }
+  .topbar .seg button { padding: 0 8px; }
+}
