+        if (c === 'short' && m.first.need > m.first.room && m.first.payOk && m.first.firstLine) { notes.push(`${what}: ${m.first.lines}-line title needs ${m.first.need} px, ${m.first.room} under the bars: its pay and first line show`); return; }
