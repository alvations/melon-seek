+// fix-app-6 (fix wave 6, 2026-10-23; docs/process/fix-app-6.md): the persona reviews' wave-2 findings in the app's filters,
+// facet counts and headline medians, BN-1 to BN-7. public/app.js is a browser module, so its pure parts are cut out of
+// its source and run here with synthetic postings shaped like the real ones (ids in the comments), as
+// test/fix-pay-at-place.test.js does. The browser checks on the 2026-10-16 crawl are test/e2e/fix-app-6.e2e.js.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import * as shared from '../public/features/shared.js';
+import * as roles from '../public/features/roles.js';
+import * as insights from '../public/features/insights.js';
+import * as mapViz from '../public/viz/map.js';
+import { toUSD, FX_PER_USD, formatMoney } from '../public/viz/palette.js';
+import { seniorityFromPay } from '../server/keywords.js';
+
+const APP = fs.readFileSync(new URL('../public/app.js', import.meta.url), 'utf8');
+/** The source of `function name(` or `const name = ` in public/app.js (one line, or to its closing brace), or null. */
+function fnSource(name) {
+  const m = new RegExp(`^(?:function ${name}\\(|const ${name} = |let ${name} = )`, 'm').exec(APP);
+  if (!m) return null;
+  const line = APP.slice(m.index, APP.indexOf('\n', m.index));
+  if (!/^function /.test(line) && !/(?:=>|=)\s*\{\s*$/.test(line)) return line;
+  let depth = 0;
+  for (let i = APP.indexOf('{', m.index); i < APP.length; i++) {
+    if (APP[i] === '{') depth++;
+    else if (APP[i] === '}' && --depth === 0) return APP.slice(m.index, APP.indexOf('\n', i) > 0 ? APP.indexOf('\n', i) : i + 1);
+  }
+  return null;
+}
+
+/* ------------------------------------------------------------ the app's filter machine, lifted */
+
+const MACHINE = ['salActive', 'salWhy', 'jgFails', 'AT_PLACE', 'failures', 'derive', 'judgeAtPlace', 'countPlaces', 'coverIndexes', 'coverIndex',
+  'placeIndexes', 'placeIndex', 'placeCover', 'coveredBy', 'coverLoc', 'locMatches', 'filterSpec', 'placePayCache', 'placePay', 'payHere', 'usdHere',
+  'gradeOf', 'shownJuice', 'empKey', 'isMinimum', 'shiftRange', 'senKey', 'senKeys', 'locKey', 'stats', 'quantile', 'isOte', 'isPartTime',
+  'isPartTimeHourly', 'FACET_OFF', 'activeFacets', 'andList', 'dropFacet', 'emptyState', 'plural', 'money', 'CUR_SYM',
+  'held', 'facetSnap', 'dropHeld', 'heldLabels', 'heldLabel', 'heldToast', 'HELD_OF', 'settleKeep', 'clearFilters', 'clearPopoverFacet'];
+const BODY = MACHINE.map(fnSource).filter(Boolean).join('\n');
+function machine() {
+  // eslint-disable-next-line no-new-func
+  return new Function('shared', 'roles', 'palette', `
+    const { payAt, payLocations, notBasePay, headlineMedian, medianText, currencyWords, mainPayCurrency, isTermUnstated } = shared;
+    const { displayLevel, levelLabel, postedLevels } = roles;
+    const { toUSD, formatMoney } = palette;
+    let data = { status: 'ready', jobs: [] }, S = null, area = null, viewSpec = null, pendingKeep = null, derived = { fc: null };
+    const toasts = [];
+    const toast = (t) => toasts.push(t);
+    const commit = () => {}, clearArea = () => {}, set = (patch) => { Object.assign(S, patch); };
+    const $ = () => ({ value: '' });
+    const h = (tag, props, ...kids) => ({ tag, props, kids });
+    const fitOneLine = (el, variants) => ({ variants });
+    const queryMatchers = (q) => (q ? q.split(/\\s+/).filter(Boolean).map((w) => new RegExp(w, 'i')) : []);
+    const deptKey = (j) => j.department || 'No department';
+    const brandKey = (j) => j.brand || 'Google';
+    const famOf = () => null;
+    const senLabel = (k) => levelLabel(k), empLabel = (k) => k;
+    const gradeKey = (j) => (j.juice && j.juice.best ? j.juice.best.grade : null);
+    const keyOnBoard = (p, jobs) => (jobs.some((j) => j._locKeys.includes(p)) ? p : null);
+    const locOnBoard = (x, jobs) => jobs.some((j) => j._locKeys.includes(x));
+    const quickLabel = () => 'pay', hasListingDates = () => true;
+    const KW_CATS = [{ key: 'kr', cat: 'responsibilities' }, { key: 'kf', cat: 'fit' }, { key: 'ks', cat: 'skills' }];
+    const FAMILY_LABEL = {};
+    const FILTER_KEYS = ['q', 'smin', 'smax', 'so', 'd', 'b', 'l', 's', 'e', 'r', 'p', 'ho', 'rf', 'kr', 'kf', 'ks', 'jg'];
+    const DEFAULTS = { q: '', smin: null, smax: null, so: false, d: [], b: [], l: [], s: [], e: [], r: 'any', p: 0, ho: false, rf: '', kr: [], kf: [], ks: [], jg: [] };
+    ${BODY}
+    return {
+      toasts,
+      load(jobs) { data = { status: 'ready', jobs, company: { name: 'Board' } }; },
+      run(st) { S = { ...structuredClone(DEFAULTS), ...st }; const r = derive(); derived = r; return r; },
+      stats: (list) => stats(list, viewSpec),
+      empty(st, fc) { S = { ...structuredClone(DEFAULTS), ...st }; derived = { fc }; return emptyState(); },
+      keep: { get S() { return S; }, set S(v) { S = v; }, get held() { return held; }, switchTo(name, from, jobs) {
+        pendingKeep = { name, from, places: new Map(S.l.map((x) => [x, x])) }; data = { status: 'ready', jobs, company: { name } }; settleKeep(); },
+        clear: () => clearFilters(), reset: (id) => clearPopoverFacet(id) },
+    };`)(shared, roles, { toUSD, formatMoney });
+}
+
+/* ------------------------------------------------------------ fixtures */
+
+let seq = 0;
+const city = (c, country, region = null, lat = 50, lng = 10) => ({ name: region ? `${c}, ${region}` : `${c}, ${country}`, city: c, region, country, lat, lng, remote: false });
+const nation = (country, name) => ({ name, city: null, region: null, country, lat: 52, lng: 19, remote: false });
+const WAW = city('Warsaw', 'PL'), KRK = city('Krakow', 'PL'), WRO = city('Wrocław', 'PL'), DUB = city('Dublin', 'IE'), LON = city('London', 'GB');
+const TOR = city('Toronto', 'CA', 'ON'), VAN = city('Vancouver', 'CA', 'BC'), SEA = city('Seattle', 'US', 'WA'), MIL = city('Milan', 'IT');
+const ATL = city('Atlanta', 'US', 'GA'), POLAND = nation('PL', 'Poland');
+const sal = (min, max, currency = 'USD', extra = {}) => ({ min, max, mid: (min + max) / 2, currency, interval: 'year', text: `${min}-${max} ${currency}`, ...extra });
+/** A posting as app.js prepare() leaves it (the fields the filters read). */
+function job({ locs, salary = null, dept = 'Software', seniority = 'Senior', basis = 'title', type = 'Full-time', remote = false, age = 3, juice = null, title = 'Engineer', company = 'google' }) {
+  const j = { id: `${company}:${++seq}`, company, title, department: dept, seniority, seniorityBasis: basis, employmentType: type, remote, locations: locs, salary,
+    keywords: { responsibilities: [], fit: [], skills: [] }, ageDays: age };
+  j._usd = salary ? { min: toUSD(salary.min, salary.currency), max: toUSD(salary.max, salary.currency), mid: toUSD(salary.mid, salary.currency) } : null;
+  j._mid = j._usd?.mid ?? null;
+  j._payLocs = shared.payLocations(j);
+  j._locKeys = locs.map((l) => (l.remote ? l.name || 'Remote' : l.city || l.name || 'Unknown'));
+  j._age = age;
+  j._hay = `${title} ${dept}`.toLowerCase();
+  j.juice = juice;
+  return j;
+}
+const times = (n, f) => Array.from({ length: n }, (_, i) => f(i));
+
+// Google's Warsaw and Dublin roles (BN-1): a PLN line covers the Polish places only, a euro line the Irish ones.
+function googleBoard() {
+  return [
+    ...times(6, () => job({ locs: [WAW], salary: sal(180000, 260000, 'PLN') })), // about $48K–69K: passes a $40K floor
+    ...times(2, () => job({ locs: [WAW], salary: sal(90000, 120000, 'PLN') })), // about $24K–32K: under it
+    ...times(3, () => job({ locs: [WAW, DUB], salary: sal(200000, 280000, 'PLN') })), // Warsaw's pay; none posted for Dublin
+    ...times(2, () => job({ locs: [WAW, LON], salary: sal(200000, 280000, 'PLN') })), // none for London
+    ...times(4, () => job({ locs: [DUB], salary: sal(90000, 130000, 'EUR') })),
+    ...times(2, () => job({ locs: [DUB, KRK], salary: sal(95000, 120000, 'EUR') })), // Dublin's pay; none for Krakow
+    ...times(3, () => job({ locs: [KRK], salary: sal(170000, 230000, 'PLN') })),
+    ...times(1, () => job({ locs: [WAW, KRK], salary: sal(100000, 140000, 'PLN') })), // under the floor at both
+    ...times(2, () => job({ locs: [WRO, WAW], salary: sal(160000, 220000, 'PLN'), dept: 'Sales', seniority: 'Mid', basis: 'title', remote: true, age: 40 })),
+    ...times(2, () => job({ locs: [POLAND], salary: sal(160000, 240000, 'PLN'), dept: 'Sales' })), // only a country: counts for its cities
+    ...times(2, () => job({ locs: [LON], salary: null })),
+  ];
+}
+// Amazon's rows per place (BN-1): Seattle and Vancouver priced on rows of their own.
+function amazonBoard() {
+  const rows = (a, b) => [{ min: a[0], max: a[1], currency: 'USD', interval: 'year', locations: [SEA.name] }, { min: b[0], max: b[1], currency: 'CAD', interval: 'year', locations: [VAN.name] }];
+  const two = (us, ca) => job({ company: 'amazon', locs: [SEA, VAN], salary: { ...sal(us[0], us[1]), ranges: rows(us, ca) } });
+  return [
+    ...times(4, () => two([150000, 200000], [60000, 70000])), // Vancouver about $43K–50K: under a $55K floor, Seattle over it
+    ...times(3, () => two([150000, 200000], [90000, 120000])), // over it at both
+    ...times(5, () => job({ company: 'amazon', locs: [TOR], salary: sal(80000, 110000, 'CAD') })),
+    ...times(2, () => job({ company: 'amazon', locs: [TOR], salary: sal(50000, 60000, 'CAD') })),
+    ...times(3, () => job({ company: 'amazon', locs: [SEA], salary: sal(120000, 160000) })),
+  ];
+}
+
+/** Every key of the board's places, as the Location list could list them. */
+const allKeys = (jobs) => [...new Set(jobs.flatMap((j) => j._locKeys))];
+/** BN-1's rule: the count each place shows is the roles shown after picking that place alone. */
+function checkPlaces(m, jobs, st, what) {
+  const { fc } = m.run(st);
+  const bad = [];
+  for (const k of allKeys(jobs)) {
+    const listed = fc.l.get(k) || 0;
+    const alone = m.run({ ...st, l: [k] }).filtered.length;
+    if (listed !== alone && (listed || alone)) bad.push(`${k}: listed ${listed}, alone ${alone}`);
+  }
+  assert.deepEqual(bad, [], `${what}: ${bad.join('; ')}`);
+}
+
+/* ------------------------------------------------------------ BN-1 */
+
+test('BN-1 Google + Warsaw + a $40K floor (PLN 150,000): each place counts what picking it alone shows', () => {
+  const m = machine();
+  const jobs = googleBoard();
+  m.load(jobs);
+  const { fc } = m.run({ l: ['Warsaw'], smin: 40000 });
+  // The reviewer's case: Dublin read 2 (Warsaw's pay of the Warsaw-and-Dublin roles), really 4 + 2.
+  assert.equal(fc.l.get('Dublin') || 0, m.run({ l: ['Dublin'], smin: 40000 }).filtered.length, 'Dublin');
+  assert.equal(m.run({ l: ['Dublin'], smin: 40000 }).filtered.length, 6);
+  assert.equal(fc.l.get('London') || 0, 0, 'London: no pay posted there, so nothing passes a pay floor');
+  checkPlaces(m, jobs, { l: ['Warsaw'], smin: 40000 }, 'Warsaw picked');
+  checkPlaces(m, jobs, { l: ['Warsaw', 'Dublin'], smin: 40000 }, 'Warsaw and Dublin picked');
+  checkPlaces(m, jobs, { smin: 40000 }, 'no place picked');
+  checkPlaces(m, jobs, { l: ['Krakow'], smin: 40000, smax: 60000 }, 'a floor and a ceiling');
+});
+
+test('BN-1 Amazon + Toronto + a floor: Vancouver and Seattle count at their own rows (amazon:10371179-like rows per place)', () => {
