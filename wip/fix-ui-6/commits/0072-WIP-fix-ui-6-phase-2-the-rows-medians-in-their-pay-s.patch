+          rows: [...document.querySelectorAll('#chartHost .ms-crow')].map((x) => ({ name: x.querySelector('.ms-crow__name')?.textContent.trim(), sub: x.querySelector('.ms-crow__sub')?.textContent.trim() || '', aria: x.getAttribute('aria-label') || '' })),
