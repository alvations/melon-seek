From aec5de1f5b4a45856f4aae6622da8247a322ad4f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 05:10:00 +0000
Subject: [PATCH 38/72] fix-salary-6 S-1 follow-up: Juice says
 'pay-other-country' again when every place with a city record is in a country
 no row prices (Cohere's London)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
(cherry picked from commit 34623196e2c9dff96db226dc9fbff5c5f8ac093a)
---
 server/juice.js           | 14 +++++++++++++-
 test/fix-salary-6.test.js | 15 +++++++++++++++
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/server/juice.js b/server/juice.js
index ecf6548..c949015 100644
--- a/server/juice.js
+++ b/server/juice.js
@@ -1516,7 +1516,19 @@ export function attachJuice(job, cities, opts = {}) {
     const own = matches.filter((m) => posted.has(m.location.rawName || m.location.name));
     // None of the posted places has a city record (Sacramento): no Juice, as for any place
     // without one, never Juice at a place the pay was not posted for.
-    if (!own.length && job.locations.some((l) => l && posted.has(l.rawName || l.name))) return job;
+    if (!own.length && job.locations.some((l) => l && posted.has(l.rawName || l.name))) {
+      // S-1 follow-up (fix-salary-6): when every place with a city record is in a country none of the posting's rows
+      // prices (London on Cohere's "Canada" and "United States" rows, whose own places have no city record), the pay
+      // is another country's, and the posting says so, as it did before its rows were tied to their places.
+      const hc = typeof s.country === 'string' && /^[A-Z]{2}$/.test(s.country) ? s.country : null;
+      const rows = (Array.isArray(s.ranges) ? s.ranges : []).filter((r) => r && Number.isFinite(Number(r.min)));
+      const prices = (m) => (m.city.currency === cur && (!hc || m.city.country === hc))
+        || rows.some((r) => String(r.currency || cur).toUpperCase() === m.city.currency && (!r.country || r.country === m.city.country));
+      if (!matches.some(prices)) {
+        job.juiceMissing = noJuiceReason('pay-other-country', { currency: cur, country: matches.some((m) => m.city.currency === cur) ? hc : null, places: matches.map((m) => m.location.name || m.city.name) });
+      }
+      return job;
+    }
     if (own.length) matches.splice(0, matches.length, ...own);
   }
   // The pay's own country: the one its pay line names (salary.country, "Ireland: €72000"),
diff --git a/test/fix-salary-6.test.js b/test/fix-salary-6.test.js
index 6673b3c..9e0ee42 100644
--- a/test/fix-salary-6.test.js
+++ b/test/fix-salary-6.test.js
@@ -246,6 +246,21 @@ test('S-1 main site: Ashby rows named for places are tied to them (cohere:14aef6
   assert.equal(payAt(j, at(j, 'Remote')), null, 'no row is posted for Remote');
 });
 
+test('S-1 follow-up: rows tied to places with no city record still say why another country\'s place gets no Juice (cohere:0342fd5f, London)', () => {
+  const locations = locsOf(['United States', 'Canada', 'London', 'Remote']);
+  const payRanges = [
+    { min: 375000, max: 465000, currency: 'CAD', interval: 'year', label: 'Canada' },
+    { min: 335000, max: 410000, currency: 'USD', interval: 'year', label: 'USA - New York, Washington and California' },
+    { min: 265000, max: 330000, currency: 'USD', interval: 'year', label: 'USA - All Other States' },
+  ];
+  const sal = deriveSalary({ title: 'Head of Corporate Development', text: '', html: '', salary: { min: 375000, max: 465000, currency: 'CAD', interval: 'year', text: 'CA$375K – CA$465K • Offers Equity • Multiple Ranges' }, payRanges }, locations);
+  assert.ok(sal.ranges.some((r) => (r.locations || []).length), 'the rows are tied to "Canada" and "United States"');
+  const j = attachJuice({ id: 'cohere:0342fd5f-3760-4dcb-b026-333c7b63fc8d', title: 'Head of Corporate Development', locations, salary: sal }, CITIES);
+  assert.equal(j.juice, null);
+  assert.equal(j.juiceMissing?.code, 'pay-other-country', 'London is in a country no row prices (it said nothing once the rows were tied)');
+  assert.match(j.juiceMissing.text, /Canadian dollars/);
+});
+
 test('S-1 main site: Scale AI\'s unnamed Greenhouse rows are named and tied by the text that states them', () => {
   const text = 'For pay transparency purposes, the base salary range for this full-time position in the locations of San Francisco, New York, Seattle is:\n$180,000 — $259,000 USD\nThe base salary range for this full-time position in the locations of Hawaii, Washington DC, Texas, Colorado is:\n$162,400 — $233,000 USD\nThe base salary range for this full-time position in the location of St. Louis is:\n$135,200 — $194,000 USD\n';
   const locations = locsOf(['San Francisco, CA', 'St. Louis, MO', 'New York, NY', 'Washington, DC']);
