-   visually hidden "Group:" label does. Map view and Insights keep the stats line's median (the map has no caption). */
-:root[data-mode="chart"] .stats-line :is(.stat--median, .stat-sep:has(+ .stat--median)) {
-  position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
-}
+/* D-2: the median once on the screen, in the chart's own caption, in Chart view at every size (app.js syncStatsFold
+   moves the stats line's median, and on the phone layout short of a tablet the whole line, to .sr-only: the sheet's count
+   row has the count, the caption's Details the share, and a screen reader keeps the summary). Tablets and wider show the
+   count and the share; Map view and Insights keep the stats line's median (the map has no caption). */
 @media (max-width: 860px) {
-  :root[data-mode="chart"]:not([data-fit="tablet"]) .stats-line {
-    position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap;
-  }
   :root[data-mode="chart"][data-fit="tablet"] .stats-line { flex: 1 1 auto; }
   :root[data-mode="chart"][data-fit="tablet"] .stats-line :is(.stat--count, .stat--share, .stat-sep:not(:has(+ .stat--median))) { display: inline; }
   :root[data-mode="chart"][data-fit="tablet"] .viz-controls { width: auto; }
