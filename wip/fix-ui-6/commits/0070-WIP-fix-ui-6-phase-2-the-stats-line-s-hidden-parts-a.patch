 test/e2e/fix-density.e2e.js        |  6 ++++--
 test/e2e/fix-phone-controls.e2e.js |  3 ++-
 test/e2e/fix-ui-6.e2e.js           |  3 +++
 6 files changed, 42 insertions(+), 16 deletions(-)

diff --git a/public/app.js b/public/app.js
index 0490b81..33520ea 100644
--- a/public/app.js
+++ b/public/app.js
@@ -3129,6 +3129,7 @@ function setFit() {
   root.dataset.fit = fit;
   const twoScreens = matchMedia('(horizontal-viewport-segments: 2)').matches || matchMedia(DUO_SPANNED).matches;
   root.toggleAttribute('data-chart-fold', fit === 'short' || fit === 'compact' || (fit === 'wide' && twoScreens && h < 700));
+  syncStatsFold();
 }
 
 /**
@@ -3306,6 +3307,24 @@ function renderKpis() {
   chart?.setNotes?.(fold ? details : []);
   renderNote(el, { line: [...line.flatMap((p, i) => (i ? [h('span', { class: 'stat-sep', 'aria-hidden': 'true' }, '·'), p] : [p])), noPay], details: fold ? [] : details, key: 'stats-line' });
   requestAnimationFrame(fitStatsLine);
+  syncStatsFold();
+}
+/**
+ * ux-density-6 D-2 (fix-ui-6 phase 2): in Chart view the chart's caption says the median, so the stats line's median leaves
+ * the screen, and on the phone layout short of a tablet the whole line (the sheet's count row has the count, the caption's
+ * Details the share). Both stay for a screen reader (.sr-only): the stats line is the page's summary. Map view and
+ * Insights keep it. Run after each render of the line and when the size class changes.
+ */
+function syncStatsFold() {
+  const el = $('#statsLine');
+  if (!el) return;
+  const chart = S.m === 'chart';
+  el.classList.toggle('sr-only', chart && isMobile() && document.documentElement.dataset.fit !== 'tablet');
+  for (const m of el.querySelectorAll('.stat--median')) {
+    m.classList.toggle('sr-only', chart);
+    const sep = m.previousElementSibling;
+    if (sep?.classList.contains('stat-sep')) sep.classList.toggle('sr-only', chart);
+  }
 }
 let statsNotes = []; // UX-57: the stats line's facts, for the chart notes
 
@@ -3348,8 +3367,13 @@ function fitStatsLine() {
     const mids = [];
     for (const x of line.getClientRects()) { if (x.width < 0.5) continue; const m = Math.round(x.top + x.height / 2); if (!mids.some((t) => Math.abs(t - m) < 6)) mids.push(m); }
     const r = document.createRange();
-    r.selectNodeContents(line);
-    for (const x of r.getClientRects()) { if (x.width < 0.5) continue; const m = Math.round(x.top + x.height / 2); if (!mids.some((t) => Math.abs(t - m) < 6)) mids.push(m); }
+    // fix-ui-6 (ux-density-6 D-2): the parts moved off the screen (.sr-only, syncStatsFold) take no line.
+    const walk = document.createTreeWalker(line, NodeFilter.SHOW_TEXT);
+    for (let n = walk.nextNode(); n; n = walk.nextNode()) {
+      if (n.parentElement?.closest('.sr-only')) continue;
+      r.selectNodeContents(n);
+      for (const x of r.getClientRects()) { if (x.width < 0.5) continue; const m = Math.round(x.top + x.height / 2); if (!mids.some((t) => Math.abs(t - m) < 6)) mids.push(m); }
+    }
     return mids.length;
   };
   // The text itself changes (as note.js fitLine does), so what the line says is what it shows.
