diff --git a/test/e2e/fix-salary-6.e2e.js b/test/e2e/fix-salary-6.e2e.js
new file mode 100644
index 0000000..fa99539
--- /dev/null
+++ b/test/e2e/fix-salary-6.e2e.js
@@ -0,0 +1,237 @@
+// fix-salary-6 (fix wave 6, 2026-10-24; docs/process/fix-salary-6.md): S-1, pay posted for two or more countries, checked on
+// the built site. Chromium against the static build (BETA_QA_DIST, else dist/ from `npm run build`), served under
+// /melon-seek/ like GitHub Pages; other hosts are aborted. The cases are the persona reviewer's three Google postings
+// (persona-beta-2-45-54) on the 2026-10-16 crawl; a test skips when its posting is gone from a later crawl. On e800c43's
+// build the card read "Pay posted for Germany only" under a Milan filter and the drawer "Posted for Germany, not Milan".
+// "[phone]" measures the lines this lane changed (the card's pill and the line under it, the drawer's figure and its
+// line) at every entry of test/e2e/phone-sizes.mjs with fix-phone-text's own scanner (scanText).
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import zlib from 'node:zlib';
+import { ROOT, assert, assertEq, skip } from './harness.js';
+import { ALL_SIZES, contextFor } from './phone-sizes.mjs';
+import { scanText, CAPTION_SEL } from './fix-phone-text.e2e.js';
+
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const MIME = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.csv': 'text/csv', '.txt': 'text/plain', '.woff2': 'font/woff2' };
+const linesAt = (width) => (width < 360 ? 2 : 1); // fix-phone-text's rule
+const SHOTS = path.join(ROOT, 'docs', 'screenshots', 'fix-salary-6');
+
+let shared = null;
+/** Serve the build under /melon-seek/ (gzip, like Pages); null without a beta build. One server for the whole file. */
+async function serveDist() {
+  if (shared) return shared;
+  const dist = path.resolve(process.env.BETA_QA_DIST || path.join(ROOT, 'dist'));
+  if (!fs.existsSync(path.join(dist, 'beta', 'index.html')) || !fs.existsSync(path.join(dist, 'beta', 'api', 'jobs'))) return null;
+  const server = http.createServer((req, res) => {
+    const u = new URL(req.url, 'http://x');
+    if (!u.pathname.startsWith('/melon-seek/')) { res.writeHead(302, { location: '/melon-seek/' }); return res.end(); }
+    let p;
+    try { p = path.join(dist, decodeURIComponent(u.pathname.slice('/melon-seek/'.length))); } catch { res.writeHead(400); return res.end(); }
+    if (p !== dist && !p.startsWith(dist + path.sep)) { res.writeHead(403); return res.end(); }
+    if (fs.existsSync(p) && fs.statSync(p).isDirectory()) p = path.join(p, 'index.html');
+    if (!fs.existsSync(p)) { res.writeHead(404); return res.end(); }
+    const type = MIME[path.extname(p)] || 'application/octet-stream';
+    const body = fs.readFileSync(p);
+    const gz = /text|javascript|json|svg|csv/.test(type) && /gzip/.test(req.headers['accept-encoding'] || '') && body.length > 1024;
+    res.writeHead(200, { 'content-type': type, ...(gz ? { 'content-encoding': 'gzip' } : {}) });
+    res.end(gz ? zlib.gzipSync(body) : body);
+  });
+  await new Promise((r) => server.listen(0, '127.0.0.1', r));
+  server.unref();
+  const origin = `http://127.0.0.1:${server.address().port}`;
+  shared = { origin, dist, beta: `${origin}/melon-seek/beta`, main: `${origin}/melon-seek` };
+  return shared;
+}
+
+const DESKTOP = { name: 'desktop', width: 1280, height: 800 };
+const SIZES = [ALL_SIZES.find((d) => d.width === 375 && d.height === 812), ALL_SIZES.find((d) => d.width === 352 && d.height === 355), DESKTOP];
+
+/** A fresh page; `device` is a phone-sizes.mjs entry or DESKTOP. */
+async function open(ctx, device = DESKTOP) {
+  const st = await serveDist();
+  if (!st) skip('no beta build (npm run build, or BETA_QA_DIST=<dir>)');
+  const engine = ctx.browser.browserType?.().name() || 'chromium';
+  const context = await ctx.browser.newContext(device === DESKTOP ? { viewport: { width: device.width, height: device.height }, colorScheme: 'light', deviceScaleFactor: 1 }
+    : { ...contextFor(device, engine), colorScheme: 'light' });
+  ctx.cleanup.push(() => context.close().catch(() => {}));
+  await context.route((u) => !u.href.startsWith(st.origin) && !u.href.startsWith('data:') && !u.href.startsWith('blob:'), (r) => r.abort('blockedbyclient'));
+  const page = await context.newPage();
+  const errors = [];
+  page.on('pageerror', (e) => errors.push(e.message));
+  return { st, page, errors };
+}
+const ready = (page) => page.waitForFunction(() => {
+  const t = document.querySelector('#resultsTitle');
+  return t && !/Loading/.test(t.textContent) && /\d/.test(t.textContent) && document.querySelector('#resultsList .card[data-id]');
+}, null, { timeout: 120000 });
+async function board(page, base, hash) {
+  await page.goto('about:blank');
+  await page.goto(`${base}/#${hash}`);
+  await ready(page);
+  await sleep(600);
+}
+const text = (page, sel) => page.locator(sel).first().evaluate((e) => (e.textContent || '').replace(/\s+/g, ' ').trim()).catch(() => null);
+/** Open a posting from the board in view (a hash change keeps the list and the filter). */
+async function drawer(page, hash, id) {
+  await page.evaluate((h) => { location.hash = h; }, `${hash}&job=${encodeURIComponent(id)}`);
+  await page.waitForFunction(() => document.querySelector('#drawer.is-open #drawerTitle'), null, { timeout: 30000 });
+  await sleep(700);
+}
+/** The posting as the app holds it (getJobs, as the UI sees it), or null. */
+async function appJob(page, base, company, id) {
+  return page.evaluate(`(async () => {
+    const api = await import(${JSON.stringify(`${base}/api.js`)});
+    const res = await api.getJobs({ company: ${JSON.stringify(company)} });
+    const j = res.jobs.find((x) => x.id === ${JSON.stringify(id)});
+    return j ? { id: j.id, title: j.title, salary: j.salary } : null;
+  })()`);
+}
+
+// The reviewer's cases: the place picked, the line posted for it, and every line the posting gives.
+const CASES = [
+  { id: 'google:111420466312159942', place: 'Milan', pill: '€124K–127K', lines: ['Germany', 'Italy'], was: 'Pay posted for Germany only' },
+  { id: 'google:123907061523063494', place: 'Paris', pill: /^€42K(\/year)?$/, lines: ['Ireland', 'Germany', 'France'], was: 'Pay posted for Ireland only' },
+  { id: 'google:111289074672640710', place: 'Dublin', pill: '€116K–118K', lines: ['Ireland', 'Netherlands'], was: 'Pay posted for the Netherlands only' },
+];
+
+async function checkCase(ctx, device, c) {
+  const { st, page, errors } = await open(ctx, device);
+  const hash = `c=google&l=${encodeURIComponent(c.place)}`;
+  await board(page, st.beta, hash);
+  const j = await appJob(page, st.beta, 'google', c.id);
+  if (!j || !j.salary) skip(`${c.id} is not in this build's Google list`);
+  const rows = (j.salary.ranges || []).map((r) => r.label);
+  assertEq(rows.join(', '), c.lines.join(', '), `${c.id}: the posting's lines as rows (it kept one country's line)`);
+  // The card: the place's own line, not "Pay posted for … only".
+  const card = page.locator(`#resultsList .card[data-id="${c.id}"]`);
+  await card.first().scrollIntoViewIfNeeded().catch(() => {});
+  assert(await card.count(), `${c.id} is not listed under l=${c.place}`);
+  const pill = (await card.first().locator('.sal-pill').innerText()).trim();
+  assert(!/only$/.test(pill), `${device.name}: the card still reads "${pill}" (it was "${c.was}")`);
+  assert(typeof c.pill === 'string' ? pill === c.pill : c.pill.test(pill), `${device.name} ${c.id}: the card reads "${pill}", want ${c.pill}`);
+  // The drawer: the same figure, posted for the place, and every country's line in Pay by place.
+  await drawer(page, hash, c.id);
+  const amt = await text(page, '#drawer .d-sal-amt');
+  assert(typeof c.pill === 'string' ? amt === c.pill : c.pill.test(amt), `${device.name} ${c.id}: the drawer reads "${amt}"`);
+  const sub = await text(page, '#drawer .d-sal-top .muted');
+  assert(sub.startsWith(`Posted for ${c.place} · EUR`), `${device.name} ${c.id}: the line under the figure reads "${sub}"`);
+  const note = await text(page, '#drawer .d-pay-note');
+  assert(!/Posted for [^,]+, not /.test(note), `${device.name} ${c.id}: the pay note still says "${note.slice(0, 120)}"`);
+  const places = await text(page, '#drawer .d-sal-places');
+  for (const l of c.lines) assert(places && places.includes(l), `${device.name} ${c.id}: Pay by place has no ${l} line: "${places}"`);
+  const chips = await page.locator('#drawer .pay-labels .pay-label').allInnerTexts();
+  assert(!chips.includes('Several pay ranges'), `${device.name} ${c.id}: "Several pay ranges" beside Pay by place: ${chips.join(' | ')}`);
+  fs.mkdirSync(SHOTS, { recursive: true });
+  await page.locator('#drawer .d-salary').first().screenshot({ path: path.join(SHOTS, `${c.place.toLowerCase()}-${device.width}x${device.height}.png`) }).catch(() => {});
+  assert(!errors.length, errors.join('; '));
+}
+
+export function registerFixSalary6Tests(suite) {
+  for (const device of SIZES) {
+    for (const c of CASES) {
+      suite.test(`fix-salary-6: [S-1] ${device.name === 'desktop' ? 'desktop' : device.name} ${device.width}x${device.height}: l=${c.place} prices ${c.id} on its own line, on the card and in the drawer`, (ctx) => checkCase(ctx, device, c));
+    }
+  }
+
+  suite.test('fix-salary-6: [S-1] with no filter, the Milan posting shows the span of its two lines and both lines in Pay by place', async (ctx) => {
+    const { st, page } = await open(ctx);
+    await board(page, st.beta, 'c=google');
+    const c = CASES[0];
+    if (!(await appJob(page, st.beta, 'google', c.id))) skip(`${c.id} is not in this build`);
+    await drawer(page, 'c=google', c.id);
+    assertEq(await text(page, '#drawer .d-sal-amt'), '€124K–153K', `${c.id} drawer figure`);
+    assert((await text(page, '#drawer .d-sal-top .muted')).startsWith('2 places · EUR'), `${c.id}: "${await text(page, '#drawer .d-sal-top .muted')}"`);
+    const places = await text(page, '#drawer .d-sal-places');
+    assert(/Germany\s*€150K–153K/.test(places) && /Italy\s*€124K–127K/.test(places), `${c.id}: Pay by place "${places}"`);
+  });
+
+  suite.test('fix-salary-6: [S-1] a line in another currency: Toronto is priced in CAD on Google\'s Canadian line, the card with no filter keeps the US line', async (ctx) => {
+    const { st, page } = await open(ctx);
+    const id = 'google:100176223677620934';
+    await board(page, st.beta, 'c=google&l=Toronto');
+    if (!(await appJob(page, st.beta, 'google', id))) skip(`${id} is not in this build`);
+    const pill = (await page.locator(`#resultsList .card[data-id="${id}"] .sal-pill`).first().innerText()).trim();
+    assertEq(pill, 'CA$150K–153K', `${id} under l=Toronto`);
+    await drawer(page, 'c=google&l=Toronto', id);
+    assert((await text(page, '#drawer .d-sal-top .muted')).startsWith('Posted for Toronto · CAD'), `${id}: "${await text(page, '#drawer .d-sal-top .muted')}"`);
+    await board(page, st.beta, 'c=google');
+    const all = (await page.locator(`#resultsList .card[data-id="${id}"] .sal-pill`).first().innerText().catch(() => '')).trim();
+    if (all) assertEq(all, '$147K–210K', `${id} with no filter: the US line, never a USD–CAD span`);
+  });
+
+  suite.test('fix-salary-6: [S-1] a line for a place the job doesn\'t list is in the drawer\'s pay Details, as posted (Microsoft "across Spain" on a Dublin job)', async (ctx) => {
+    const { st, page } = await open(ctx);
+    const id = 'microsoft:1970393556939627';
+    await board(page, st.beta, 'c=microsoft');
+    const j = await appJob(page, st.beta, 'microsoft', id);
+    if (!j) skip(`${id} is not in this build`);
+    assertEq(JSON.stringify((j.salary.unlisted || []).map((u) => [u.label, u.min, u.max, u.currency])), JSON.stringify([['Spain', 38000, 59700, 'EUR']]), `${id} salary.unlisted`);
+    await drawer(page, 'c=microsoft', id);
+    await page.evaluate(() => { for (const d of document.querySelectorAll('#drawer details')) d.open = true; });
+    await sleep(300);
+    const note = await text(page, '#drawer .d-pay-note');
+    assert(note.includes('The posting also gives pay for Spain: €38K–59.7K; this role isn’t listed there.'), `${id}: the pay Details "${note.slice(0, 400)}"`);
+    assertEq(await text(page, '#drawer .d-sal-amt'), '€49.2K–71.4K', `${id}: the figure stays Ireland's`);
+  });
+
+  suite.test('fix-salary-6: [S-1] main site: Cohere\'s rows named for places price them under a Location filter (it priced none)', async (ctx) => {
+    const { st, page } = await open(ctx);
+    await board(page, st.main, 'c=cohere&l=Toronto');
+    const list = await page.evaluate(`(async () => {
+      const api = await import(${JSON.stringify(`${st.main}/api.js`)});
+      const res = await api.getJobs({ company: 'cohere' });
+      return res.jobs.filter((j) => j.salary && (j.salary.ranges || []).some((r) => (r.locations || []).some((l) => /Toronto/.test(l)))).map((j) => ({ id: j.id, r: j.salary.ranges.find((r) => (r.locations || []).some((l) => /Toronto/.test(l))) }));
+    })()`);
+    if (!list.length) skip('no Cohere posting with a Toronto row in this build');
+    const c = list[0];
+    const pill = (await page.locator(`#resultsList .card[data-id="${c.id}"] .sal-pill`).first().innerText().catch(() => '')).trim();
+    assert(pill && !/only$/.test(pill) && /^CA\$/.test(pill), `${c.id} under l=Toronto reads "${pill}" (its "${c.r.label}" row is ${c.r.min}–${c.r.max} ${c.r.currency})`);
+    ctx.notes.push(`fix-salary-6 main site: ${list.length} Cohere postings price Toronto on a row of their own`);
+  });
+
+  suite.test('fix-salary-6: [S-1] nothing is dropped: every board lists the same postings, and every Google and Microsoft posting with pay keeps it', async (ctx) => {
+    const { st, page } = await open(ctx);
+    await board(page, st.beta, 'c=google');
+    const bad = [];
+    for (const slug of ['google', 'microsoft', 'nvidia', 'meta']) {
+      const r = await page.evaluate(`(async () => {
+        const api = await import(${JSON.stringify(`${st.beta}/api.js`)});
+        const res = await api.getJobs({ company: ${JSON.stringify(slug)} });
+        return { n: res.jobs.length, paid: res.jobs.filter((j) => j.salary).length, rows: res.jobs.reduce((a, j) => a + ((j.salary && j.salary.ranges) || []).length, 0), unlisted: res.jobs.reduce((a, j) => a + ((j.salary && j.salary.unlisted) || []).length, 0) };
+      })()`);
+      const list = JSON.parse(fs.readFileSync(path.join(st.dist, 'beta', 'api', 'jobs', `${slug}.json`), 'utf8')).jobs.length;
+      if (r.n !== list) bad.push(`${slug}: ${r.n} postings in the app, ${list} in the list`);
+      ctx.notes.push(`fix-salary-6: ${slug} ${r.n} postings, ${r.paid} with pay, ${r.rows} pay rows, ${r.unlisted} lines for unlisted places`);
+    }
+    assert(!bad.length, bad.join('; '));
+  });
+
+  // [phone] The lines this lane changed, at every phone size: the card's pill and the line under it, the drawer's figure
+  // and its line, for Milan (EUR) and Toronto (CAD).
+  for (const d of ALL_SIZES) {
+    suite.test(`fix-salary-6: [phone] ${d.name} ${d.width}x${d.height}: the card's and the drawer's pay lines for a place's own line are ${linesAt(d.width) === 1 ? 'one line' : 'at most two lines'}, never cut`, async (ctx) => {
+      const { st, page, errors } = await open(ctx, d);
+      const bad = [];
+      const measure = async (sel, where) => {
+        if (!(await page.locator(sel).count())) { bad.push(`${where}: ${sel} not shown`); return; }
+        const r = await page.evaluate(scanText, { roots: [sel], captionSel: `${CAPTION_SEL}, ${sel}`, allow: [], words: 12, maxLines: linesAt(d.width) });
+        for (const m of r.lines) bad.push(`${where} ${m.sel}: ${m.lines} lines, ${m.words} words: "${m.text}"`);
+        for (const m of r.cut) bad.push(`${where} ${m.sel}: cut by ${m.over} px: "${m.text}"`);
+      };
+      for (const [hash, id] of [['c=google&l=Milan', CASES[0].id], ['c=google&l=Toronto', 'google:100176223677620934']]) {
+        await board(page, st.beta, hash);
+        if (!(await appJob(page, st.beta, 'google', id))) continue;
+        const card = `#resultsList .card[data-id="${id}"]`;
+        await page.locator(card).first().scrollIntoViewIfNeeded().catch(() => {});
+        await measure(`${card} .sal-pill`, `${hash} card`);
+        await drawer(page, hash, id);
+        await measure('#drawer .d-sal-amt', `${hash} drawer`);
+        await measure('#drawer .d-sal-top .muted', `${hash} drawer`);
+      }
+      assert(!bad.length, bad.join('; '));
+      assert(!errors.length, errors.join('; '));
+    });
+  }
+}
