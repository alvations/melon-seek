diff --git a/public/app.js b/public/app.js
index 3e84c50..7d9bc3c 100644
--- a/public/app.js
+++ b/public/app.js
@@ -4986,8 +4986,9 @@ function drawerContent(job) {
     : fullHourly ? `from ${postedMoney(sal.min / 2080, sal.currency)} an hour`
     : term ? `${term.amount}${perText(term.per)}` : isMinimum(job) ? `from ${money(sal.min, sal.currency)}` : salaryRange(sal);
   // P-2 (fix-data-6): the heading gives a yearly figure the posting states exactly ("€46,400", "$119,800–234,700"), as
-  // fixed-term and part-time pay already are; where that doesn't fit one line (280 px), the card's rounded figure.
-  const exactText = !sal || !statedYearly(sal) || shiftR || partHourly || term ? null : phExact ? phExact.range
+  // fixed-term and part-time pay already are; where that doesn't fit one line (280 px), the card's rounded figure. A
+  // programme's yearly rates by place ("$39,695–44,115/year", amazon:10502807) too, as its Pay by place rows are.
+  const exactText = !sal || !statedYearly(sal) || shiftR || partHourly || (term && !ph) ? null : phExact ? phExact.range
     : isMinimum(job) ? `from ${postedMoney(sal.min, sal.currency)}` : postedPair(sal.min, sal.max ?? sal.min, sal.currency);
   const subText = !sal ? null : (ph?.picked ? `Posted for ${ph.picked.label} · ` : ph?.sub ? `${ph.sub} · ` : '') + (partHourly ? `${cur} · part-time, paid by the hour` : fullHourly ? `${cur} · paid by the hour`
     : term?.fixed ? `${cur} · ${term.unstated ? 'length not stated' : `for ${termText(term.weeks)}`}` : term ? `${cur} · ${programText(job, term)}` : `${cur} · per year`);
diff --git a/test/e2e/fix-app.e2e.js b/test/e2e/fix-app.e2e.js
index 1fd5240..2ea0d15 100644
--- a/test/e2e/fix-app.e2e.js
+++ b/test/e2e/fix-app.e2e.js
@@ -146,11 +146,15 @@ export function registerFixAppTests(suite) {
     const lowMeta = (slug, body) => { if (body.meta) body.meta.compstimate = { ...(body.meta.compstimate || {}), medianAbsPctError: 31, n: 400 }; };
     const { page, errors } = await openFx(ctx, { hash: 'c=anthropic', patch: lowMeta });
     // T-19 (fix-data-6): the first role without pay gets no estimate, so this skipped on every run. The page's own
-    // estimate (compstimateForJob) picks the first candidate that has one.
+    // estimate (compstimateForJob) and what may be shown of it (estimateView, as the drawer decides) pick the first
+    // candidate the drawer shows an estimate for (one in another country than its comparables shows none).
     const pick = await page.evaluate(async ({ ids }) => {
       const api = await import('./api.js'); const m = await import('./features/compstimate.js');
       const res = await api.getJobs({ company: 'anthropic' });
-      for (const id of ids) { const j = res.jobs.find((x) => x.id === id); const r = j && m.compstimateForJob(res.jobs, j); if (r && r.mid != null) return id; }
+      for (const id of ids) {
+        const j = res.jobs.find((x) => x.id === id); const r = j && m.compstimateForJob(res.jobs, j);
+        if (r && r.mid != null && m.estimateView(r, { company: 'Anthropic', meta: res.meta }).ok) return id;
+      }
       return null;
     }, { ids: noPay.map((j) => j.id) });
     if (!pick) skip(`none of Anthropic's ${noPay.length} roles without pay gets an estimate`);
diff --git a/test/e2e/fix-pay-at-place.e2e.js b/test/e2e/fix-pay-at-place.e2e.js
index 57769c6..742306f 100644
