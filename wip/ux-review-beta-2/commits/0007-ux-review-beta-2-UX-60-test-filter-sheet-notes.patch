---
 test/e2e/beta-ux-review-2.e2e.js | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/test/e2e/beta-ux-review-2.e2e.js b/test/e2e/beta-ux-review-2.e2e.js
index 3939418..e9c1b61 100644
--- a/test/e2e/beta-ux-review-2.e2e.js
+++ b/test/e2e/beta-ux-review-2.e2e.js
@@ -423,6 +423,18 @@ export function registerBetaUxReview2Tests(suite) {
     assert(box.left >= 8 && box.top >= 6, `"${box.text}" sits ${box.left} px from the box's left edge and ${box.top} px from its top (styles.css .d-juice { padding: 0 } overrides .d-juice--none)`);
   });
 
+  // ------------------------------------------------------------------ UX-60
+  suite.test('Beta UX review 2: [UX-60] on a phone the filter sheet\'s notes are one line each (Salary, Location, Seniority: 18 to 23 words, 2 to 3 lines today)', async (ctx) => {
+    const s = await session(ctx, 'p390', { boards: ['google'] });
+    await s.go('c=google');
+    await s.page.evaluate(() => document.querySelector('#filtersToggle')?.click());
+    await sleep(800);
+    const found = await measure(s.page, '#filterBody .fnote');
+    if (!found.length) skip('no notes in the filter sheet');
+    const bad = overBudget(found, 'filters');
+    assert(!bad.length, `${bad.length} filter note(s) over the budget (one line, ${WORDS} words):\n  ${bad.join('\n  ')}`);
+  });
+
   // ------------------------------------------------------------------ UX-54
   suite.test('Beta UX review 2: [UX-54] the search box shows its whole placeholder at 360 px ("Search rol")', async (ctx) => {
     const s = await session(ctx, 'p360', { boards: ['apple'] });
