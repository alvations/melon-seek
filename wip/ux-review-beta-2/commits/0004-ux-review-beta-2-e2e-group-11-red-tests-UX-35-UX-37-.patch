+// Round-3 UX and frontend design review of the beta site (docs/process/ux-review-beta-2.md), on the 2026-10-16
+// crawl with every board whole (Amazon 22,179 postings). Chromium against the static build: BETA_QA_DIST, else
+// dist/, served under /melon-seek/ like GitHub Pages; other hosts are aborted (no basemap).
+// Each test tagged "[UX-n]" encodes an objective problem from that review (text cut off or overflowing, labels
+// that cannot be told apart, the same number shown two ways, a secondary line over the density budget: one line
+// on a phone, at most 12 words) and fails until it is fixed. Matters of taste are in the log, not here.
+// Every test skips when the build or the board it needs is missing.
+//   node scripts/e2e.js --grep='^Beta UX review 2'
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import { ROOT, assert, skip } from './harness.js';
+
+const VIEWPORTS = {
+  d1440: { viewport: { width: 1440, height: 900 } },
+  p390: { viewport: { width: 390, height: 844 }, isMobile: true, hasTouch: true, deviceScaleFactor: 2 },
+  p360: { viewport: { width: 360, height: 740 }, isMobile: true, hasTouch: true, deviceScaleFactor: 2 },
+};
+const WORDS = 12;
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const MIME = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.csv': 'text/csv', '.txt': 'text/plain', '.woff2': 'font/woff2' };
+
+function distDir() { return path.resolve(process.env.BETA_QA_DIST || path.join(ROOT, 'dist')); }
+let shared = null;
+/** Serve the build under /melon-seek/ (one server for the whole group); null without a beta build. */
+async function serveDist() {
+  if (shared) return shared;
+  const dist = distDir();
+  if (!fs.existsSync(path.join(dist, 'beta', 'index.html')) || !fs.existsSync(path.join(dist, 'beta', 'api', 'jobs'))) return null;
+  const server = http.createServer((req, res) => {
+    const u = new URL(req.url, 'http://x');
+    if (!u.pathname.startsWith('/melon-seek/')) { res.writeHead(302, { location: '/melon-seek/' }); return res.end(); }
+    let rel;
+    try { rel = decodeURIComponent(u.pathname.slice('/melon-seek/'.length)); } catch { res.writeHead(400); return res.end(); }
+    let p = path.join(dist, rel);
+    if (p !== dist && !p.startsWith(dist + path.sep)) { res.writeHead(403); return res.end(); }
+    if (fs.existsSync(p) && fs.statSync(p).isDirectory()) p = path.join(p, 'index.html');
+    if (!fs.existsSync(p)) { res.writeHead(404); return res.end(); }
+    res.writeHead(200, { 'content-type': MIME[path.extname(p)] || 'application/octet-stream' });
+    res.end(fs.readFileSync(p));
+  });
+  await new Promise((r) => server.listen(0, '127.0.0.1', r));
+  server.unref();
+  shared = { origin: `http://127.0.0.1:${server.address().port}`, dist };
+  shared.beta = `${shared.origin}/melon-seek/beta`;
+  return shared;
+}
+/** True when the build has a list file for this beta board. */
+const hasBoard = (st, slug) => fs.existsSync(path.join(st.dist, 'beta', 'api', 'jobs', `${slug}.json`));
+
+async function ready(page, timeout = 90000) {
+  await page.waitForFunction(() => { const t = document.querySelector('#resultsTitle'); return t && t.querySelector('strong') && !/Loading/.test(t.textContent); }, null, { timeout });
+  await sleep(600);
+}
+
+/** A fresh context at `vp`; `go(hash)` opens /beta/#<hash> and waits for the list. */
+async function session(ctx, vp, { theme = 'light', boards = [], route = null } = {}) {
+  const st = await serveDist();
+  if (!st) skip('no beta build (npm run build, or BETA_QA_DIST=<dir>)');
+  for (const b of boards) if (!hasBoard(st, b)) skip(`no ${b} list in this build`);
+  const context = await ctx.browser.newContext({ ...VIEWPORTS[vp], colorScheme: theme });
+  ctx.cleanup.push(() => context.close().catch(() => {}));
+  await context.route((u) => !u.href.startsWith(st.origin) && !u.href.startsWith('data:') && !u.href.startsWith('blob:'), (r) => r.abort('blockedbyclient'));
+  if (route) await route(context, st);
+  const page = await context.newPage();
+  const errors = [];
+  page.on('pageerror', (e) => errors.push(e.message));
+  return {
+    st, page, errors,
+    async go(hash, settle = 700) {
+      await page.goto('about:blank');
+      await page.goto(`${st.beta}/#${hash}`);
+      await ready(page);
+      await sleep(settle);
+    },
+    /** The board's jobs through the app's own api.js (only after a go()). */
+    jobs(slug) {
+      return page.evaluate(async ({ base, slug }) => {
+        const r = await (await import(`${base}/api.js`)).getJobs({ company: slug });
+        return { mode: r.mode, jobs: r.jobs.map((j) => ({ id: j.id, title: j.title, department: j.department, salary: j.salary, seniority: j.seniority })) };
+      }, { base: st.beta, slug });
+    },
+  };
+}
+
+/**
+ * Each visible element of `sel`: its text, words, line boxes and whether it is cut off (scrollWidth > clientWidth
+ * with overflow hidden or an ellipsis). An .ms-note is measured by its line, without its Details button.
+ */
+function measure(page, sel) {
+  return page.evaluate((sel) => [...document.querySelectorAll(sel)].filter((e) => {
+    const b = e.getBoundingClientRect();
+    return b.width > 0 && b.height > 0 && getComputedStyle(e).visibility !== 'hidden' && !e.closest('[hidden]');
+  }).map((e) => {
+    const lineEl = e.classList.contains('ms-note') ? e.querySelector(':scope > .ms-note__line') || e : e;
+    const text = (lineEl.innerText || '').replace(/\s+/g, ' ').trim();
+    const range = document.createRange();
+    range.selectNodeContents(lineEl);
+    const mids = [];
+    for (const x of range.getClientRects()) {
+      if (x.width < 0.5 || x.height < 0.5) continue;
+      const m = x.top + x.height / 2;
+      if (!mids.some((t) => Math.abs(t - m) < 6)) mids.push(m);
+    }
+    const cs = getComputedStyle(lineEl);
+    return {
+      sel, text,
+      words: text.split(' ').filter((w) => /[\p{L}\p{N}]/u.test(w)).length,
+      lines: mids.length,
+      cut: lineEl.scrollWidth > lineEl.clientWidth + 1 && (/hidden|clip/.test(cs.overflow + cs.overflowX) || cs.textOverflow === 'ellipsis'),
+    };
+  }), sel);
+}
+function overBudget(found, where, { words = WORDS, lines = 1 } = {}) {
+  const bad = [];
+  for (const m of found) {
+    const why = [m.lines > lines ? `${m.lines} lines` : '', m.words > words ? `${m.words} words` : '', m.cut ? 'cut off' : ''].filter(Boolean);
+    if (why.length) bad.push(`${where} ${m.sel}: ${why.join(', ')}: "${m.text.slice(0, 160)}"`);
+  }
+  return bad;
+}
+
+/** Raise the phone's results sheet to full height. */
+async function raiseSheet(page) {
+  for (let i = 0; i < 3 && (await page.evaluate(() => document.body.dataset.sheet)) !== 'full'; i++) {
+    await page.evaluate(() => document.querySelector('#sheetHandle')?.click());
+    await sleep(600);
+  }
+}
+
+/** In the page: the text an ellipsized element really shows (canvas-measured with its own font). */
+const VISIBLE_TEXT_FN = `(el) => {
+  const text = el.textContent.replace(/\\s+/g, ' ').trim();
+  const cs = getComputedStyle(el);
+  if (!(el.scrollWidth > el.clientWidth + 1) || cs.textOverflow !== 'ellipsis') return text;
+  const c = document.createElement('canvas').getContext('2d');
+  c.font = cs.font || (cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily);
+  const w = el.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
+  let k = text.length;
+  while (k > 0 && c.measureText(text.slice(0, k) + '\\u2026').width > w) k--;
+  return text.slice(0, k).trimEnd() + '\\u2026';
+}`;
+
+export function registerBetaUxReview2Tests(suite) {
+  // ------------------------------------------------------------------ UX-37
+  suite.test('Beta UX review 2: [UX-37] a role with a pay range per place shows the same range in its drawer as on its card (Amazon "$60K–129K · 4 places" vs "$83K–117K"; Microsoft)', async (ctx) => {
+    const s = await session(ctx, 'd1440', { boards: ['amazon', 'microsoft'] });
+    const bad = [];
+    for (const slug of ['amazon', 'microsoft']) {
+      await s.go(`c=${slug}`);
+      const { jobs } = await s.jobs(slug);
+      // The first postings whose own min/max is narrower than the span of the place ranges it lists.
+      const picks = jobs.filter((j) => {
+        const rs = j.salary?.ranges;
+        if (!rs || rs.length < 2) return false;
+        const lo = Math.min(...rs.map((r) => +r.min)), hi = Math.max(...rs.map((r) => +(r.max ?? r.min)));
+        return lo < j.salary.min - 1 || hi > j.salary.max + 1;
+      }).slice(0, 2);
+      if (!picks.length) continue;
+      for (const j of picks) {
+        await s.go(`c=${slug}&q=${encodeURIComponent(j.title)}`, 400);
+        const card = s.page.locator(`#resultsList article.card[data-id="${j.id}"]`);
+        if (!(await card.count())) { bad.push(`${j.id}: card not listed for a search of its title`); continue; }
+        const pill = (await card.locator('.sal-pill, .pay-pill, [class*=pill]').first().textContent()).trim();
+        await card.click();
+        await s.page.waitForSelector('#drawer .d-sal-amt', { timeout: 15000 });
+        await sleep(400);
+        const head = (await s.page.locator('#drawer .d-sal-amt').first().innerText()).replace(/\s+/g, ' ').trim();
+        const cardRange = pill.split(' · ')[0];
+        // Either the same span as the card, or a headline that names the place its range is for.
+        const names = (j.salary.ranges || []).map((r) => r.label).filter(Boolean);
+        if (head !== cardRange && !names.some((n) => head.includes(n))) bad.push(`${slug} "${j.title}": card "${pill}", drawer headline "${head}" (one place's range, no place named)`);
+        await s.page.keyboard.press('Escape');
+      }
+    }
+    assert(!bad.length, `the drawer's headline disagrees with the card:\n  ${bad.join('\n  ')}`);
+  });
+
+  // ------------------------------------------------------------------ UX-38
+  suite.test('Beta UX review 2: [UX-38] no two department labels show the same visible text (Amazon "Project/Program/Produ…" twice in the filter list and the phone chart)', async (ctx) => {
+    const bad = [];
+    {
+      const s = await session(ctx, 'd1440', { boards: ['amazon'] });
+      await s.go('c=amazon');
+      const shown = await s.page.evaluate((fn) => {
+        const vis = eval(fn);
+        const sec = [...document.querySelectorAll('#filterBody .check-label')].filter((e) => e.getBoundingClientRect().width > 0);
+        return sec.map((e) => ({ full: e.textContent.trim(), shown: vis(e) }));
+      }, VISIBLE_TEXT_FN);
+      const by = new Map();
+      for (const x of shown) { if (!by.has(x.shown)) by.set(x.shown, new Set()); by.get(x.shown).add(x.full); }
+      for (const [v, fulls] of by) if (fulls.size > 1) bad.push(`1440 filter list: "${v}" stands for ${[...fulls].map((f) => `"${f}"`).join(' and ')}`);
+    }
+    {
+      const s = await session(ctx, 'p390', { boards: ['amazon'] });
+      await s.go('c=amazon');
+      const shown = await s.page.evaluate((fn) => {
+        const vis = eval(fn);
+        return [...document.querySelectorAll('#chartHost .ms-crow__name')].filter((e) => e.getBoundingClientRect().width > 0).map((e) => ({ full: e.textContent.replace(/[▴▾]/g, '').trim(), shown: vis(e) }));
+      }, VISIBLE_TEXT_FN);
+      const by = new Map();
+      for (const x of shown) { if (!by.has(x.shown)) by.set(x.shown, new Set()); by.get(x.shown).add(x.full); }
+      for (const [v, fulls] of by) if (fulls.size > 1) bad.push(`390 chart rows: "${v}" stands for ${[...fulls].map((f) => `"${f}"`).join(' and ')}`);
+    }
+    assert(!bad.length, `labels cut to the same text:\n  ${bad.join('\n  ')}`);
+  });
+
+  // ------------------------------------------------------------------ UX-39
+  suite.test('Beta UX review 2: [UX-39] on a phone, Amazon\'s first-page preview shows a real card on the first screen while the whole list loads', async (ctx) => {
+    let release;
+    const held = new Promise((r) => { release = r; });
+    const s = await session(ctx, 'p390', {
+      boards: ['amazon'],
+      // Hold the whole list (not the preview) so the preview state lasts.
+      route: (context) => context.route(/\/beta\/api\/jobs\/amazon\.json/, async (r) => { await Promise.race([held, sleep(30000)]); await r.continue().catch(() => {}); }),
+    });
+    if (!fs.existsSync(path.join(s.st.dist, 'beta', 'api', 'preview', 'amazon.json'))) skip('no Amazon first-page preview in this build');
+    ctx.cleanup.push(() => release());
+    s.page.goto(`${s.st.beta}/#c=amazon`).catch(() => {});
+    await s.page.waitForFunction(() => /Loading/.test(document.querySelector('#resultsTitle')?.textContent || '') && document.querySelectorAll('#resultsList article.card').length > 0, null, { timeout: 30000 });
+    await sleep(800);
+    const seen = await s.page.evaluate(() => {
+      const cards = [...document.querySelectorAll('#resultsList article.card')];
+      const onScreen = cards.filter((c) => {
+        const r = c.getBoundingClientRect();
+        if (r.bottom <= 0 || r.top >= innerHeight - 8 || r.height < 20) return false;
+        const y = Math.min(innerHeight - 4, r.top + Math.min(r.height / 2, 24));
+        const hit = document.elementFromPoint(r.left + r.width / 2, y);
+        return !!hit && c.contains(hit);
+      });
+      return { cards: cards.length, onScreen: onScreen.length, sheet: document.body.dataset.sheet || '', title: document.querySelector('#resultsTitle')?.textContent.trim() };
+    });
+    release();
+    assert(seen.onScreen > 0, `while "${seen.title}", ${seen.cards} preview cards are in the list but none is on the first screen (sheet: "${seen.sheet}"): the phone shows only the chart skeleton`);
+  });
+
+  // ------------------------------------------------------------------ UX-42
+  suite.test('Beta UX review 2: [UX-42] a circle\'s count fits inside its circle (Microsoft "118" 22.2 px in a 21.5 px circle; NVIDIA "115", "191")', async (ctx) => {
+    const bad = [];
+    for (const vp of ['d1440', 'p390']) {
+      const s = await session(ctx, vp, { boards: ['microsoft', 'nvidia', 'google'] });
+      for (const slug of ['microsoft', 'nvidia', 'google']) {
+        await s.go(`c=${slug}`);
+        const wide = await s.page.evaluate(() => [...document.querySelectorAll('#chartHost .ms-bin:not(.ms-bin--overflow) .ms-bin__dot')].flatMap((dot) => {
+          const t = dot.textContent.trim();
+          if (!t) return [];
+          const range = document.createRange(); range.selectNodeContents(dot);
+          const tw = range.getBoundingClientRect().width, dw = dot.getBoundingClientRect().width;
+          return tw > dw - 2 ? [`"${t}" ${tw.toFixed(1)} px of text in a ${dw.toFixed(1)} px circle`] : [];
+        }));
+        for (const w of wide) bad.push(`${vp} ${slug}: ${w}`);
+      }
+    }
+    assert(!bad.length, `counts wider than their circle (1 px inset each side):\n  ${bad.join('\n  ')}`);
+  });
+
+  // ------------------------------------------------------------------ UX-44
+  suite.test('Beta UX review 2: [UX-44] on a phone the stats line never shows a lone "Details" with no text (roles in view with no pay)', async (ctx) => {
+    const s = await session(ctx, 'p390', { boards: ['google'] });
+    await s.go('c=google');
+    const { jobs } = await s.jobs('google');
+    const paid = new Set(jobs.filter((j) => j.salary).map((j) => j.title));
+    const counts = new Map();
+    for (const j of jobs) if (!j.salary && !paid.has(j.title)) counts.set(j.title, (counts.get(j.title) || 0) + 1);
+    // A search whose every result has no pay (the cards all read "No pay listed").
+    let st = null, title = null;
+    for (const t of [...counts].sort((a, b) => b[1] - a[1]).map((x) => x[0]).filter((x) => x.length > 12).slice(0, 6)) {
+      await s.go(`c=google&q=${encodeURIComponent(t)}`);
+      const r = await s.page.evaluate(() => {
+        const cards = [...document.querySelectorAll('#resultsList article.card')];
+        const l = document.querySelector('#statsLine');
+        const line = l?.querySelector('.ms-note__line');
+        const btn = l?.querySelector('.ms-note__more');
+        const vis = (e) => !!e && e.getBoundingClientRect().width > 0 && !e.closest('[hidden]');
+        return { cards: cards.length, unpaid: cards.filter((c) => /No pay listed/.test(c.textContent)).length, results: document.querySelector('#resultsTitle')?.textContent.trim(), line: vis(line) ? line.innerText.trim() : '', button: vis(btn) };
+      });
+      if (r.cards && r.unpaid === r.cards) { st = r; title = t; break; }
+    }
+    if (!st) skip('no Google search whose results all have no pay');
+    assert(!(st.button && !st.line), `search "${title}" (${st.results}, none with pay): the stats line is only a "Details" button`);
+  });
+
+  // ------------------------------------------------------------------ UX-45
+  suite.test('Beta UX review 2: [UX-45] the map\'s Juice legend gives the same dollar cut-offs as the list\'s Juice scale ("$96K or more" vs "Juicy: $95K or more")', async (ctx) => {
+    const s = await session(ctx, 'd1440', { boards: ['apple'] });
+    await s.go('c=apple');
+    const list = await s.page.evaluate(() => document.querySelector('#resultsList .juice-scale')?.textContent || '');
+    const lm = list.match(/Juicy: (\$[\d.]+K) or more.*?Ripe: (\$[\d.]+K)/);
+    if (!lm) skip(`no Juice scale above the list ("${list.slice(0, 80)}")`);
+    await s.go('c=apple&m=map', 1500);
+    const juice = s.page.locator('#mapHost button', { hasText: /^Juice$/ }).first();
+    if (!(await juice.count())) skip('no Juice mode on the map');
+    await juice.click();
+    await sleep(800);
+    const legend = await s.page.evaluate(() => [...document.querySelectorAll('#mapHost .ms-modes__net')].map((e) => e.textContent.trim()));
+    const juicy = legend.find((t) => /or more/.test(t))?.match(/\$[\d.]+K/)?.[0];
+    const ripe = legend.find((t) => /–/.test(t))?.match(/\$[\d.]+K/)?.[0];
+    const bad = [];
+    if (juicy !== lm[1]) bad.push(`Juicy starts at ${lm[1]} above the list and at ${juicy} in the map legend`);
+    if (ripe !== lm[2]) bad.push(`Ripe starts at ${lm[2]} above the list and at ${ripe} in the map legend`);
+    assert(!bad.length, `${bad.join('; ')} (legend: ${legend.join(' | ')})`);
+  });
+
