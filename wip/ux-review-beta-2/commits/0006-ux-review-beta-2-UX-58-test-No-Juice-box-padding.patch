Subject: [PATCH 06/10] ux-review-beta-2: UX-58 test (No Juice box padding)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 test/e2e/beta-ux-review-2.e2e.js | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/test/e2e/beta-ux-review-2.e2e.js b/test/e2e/beta-ux-review-2.e2e.js
index a435eeb..3939418 100644
--- a/test/e2e/beta-ux-review-2.e2e.js
+++ b/test/e2e/beta-ux-review-2.e2e.js
@@ -400,6 +400,29 @@ export function registerBetaUxReview2Tests(suite) {
     assert(!off.length, `Tab stops on controls that are off screen: ${off.map((o) => `"${o.name}" [${o.l}, ${o.r}]`).join(', ')}`);
   });
 
+  // ------------------------------------------------------------------ UX-58
+  suite.test('Beta UX review 2: [UX-58] the drawer\'s "No Juice" box keeps its padding (the text runs into its border today)', async (ctx) => {
+    const s = await session(ctx, 'p390', { boards: ['amazon'] });
+    await s.go('c=amazon');
+    const { jobs } = await s.jobs('amazon');
+    // A stated minimum in a town with no cost data (fix wave 5's Casirate d'Adda posting), else any minimum.
+    const cands = jobs.filter((j) => j.salary?.kind === 'minimum').slice(0, 6);
+    let box = null;
+    for (const j of cands) {
+      await s.go(`c=amazon&job=${encodeURIComponent(j.id)}`, 900);
+      box = await s.page.evaluate(() => {
+        const b = document.querySelector('#drawer .d-juice--none');
+        const p = b?.querySelector('.juice-none');
+        if (!b || !p || !b.getBoundingClientRect().width) return null;
+        const br = b.getBoundingClientRect(), pr = p.getBoundingClientRect();
+        return { id: location.hash, left: Math.round(pr.left - br.left), top: Math.round(pr.top - br.top), text: p.textContent.trim().slice(0, 60) };
+      });
+      if (box) break;
+    }
+    if (!box) skip('no Amazon drawer with a "No Juice" box in this build');
+    assert(box.left >= 8 && box.top >= 6, `"${box.text}" sits ${box.left} px from the box's left edge and ${box.top} px from its top (styles.css .d-juice { padding: 0 } overrides .d-juice--none)`);
+  });
+
   // ------------------------------------------------------------------ UX-54
   suite.test('Beta UX review 2: [UX-54] the search box shows its whole placeholder at 360 px ("Search rol")', async (ctx) => {
     const s = await session(ctx, 'p360', { boards: ['apple'] });
