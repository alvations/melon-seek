+  // ------------------------------------------------------------------ UX-55
+  suite.test('Beta UX review 2: [UX-55] an Insights stat tile never cuts its number ("Middle half $188K–$25…" at 1440)', async (ctx) => {
+    const bad = [];
+    for (const vp of ['d1440', 'p390']) {
+      const s = await session(ctx, vp, { boards: ['apple', 'google'] });
+      for (const slug of ['apple', 'google']) {
+        await s.go(`c=${slug}&m=insights`, 1500);
+        await s.page.waitForSelector('#insightsHost .msi-stat__value', { timeout: 60000 }).catch(() => {});
+        await sleep(400);
+        for (const m of await measure(s.page, '#insightsHost .msi-stat__value')) if (m.cut) bad.push(`${vp} ${slug}: "${m.text}" cut off`);
+      }
+    }
+    assert(!bad.length, `stat values cut mid-number:\n  ${bad.join('\n  ')}`);
+  });
+
+  // ------------------------------------------------------------------ UX-56
+  suite.test('Beta UX review 2: [UX-56] at 1024 px the closed filter sheet takes no keyboard focus ("Reset", "Close filters", "Show roles" off screen)', async (ctx) => {
+    const st0 = await serveDist();
+    if (!st0) skip('no beta build (npm run build, or BETA_QA_DIST=<dir>)');
+    if (!hasBoard(st0, 'google')) skip('no google list in this build');
+    const context = await ctx.browser.newContext({ viewport: { width: 1024, height: 768 } });
+    ctx.cleanup.push(() => context.close().catch(() => {}));
+    await context.route((u) => !u.href.startsWith(st0.origin) && !u.href.startsWith('data:') && !u.href.startsWith('blob:'), (r) => r.abort('blockedbyclient'));
+    const page = await context.newPage();
+    await page.goto(`${st0.beta}/#c=google`);
+    await ready(page);
+    const closed = await page.evaluate(() => { const r = document.querySelector('#filters').getBoundingClientRect(); return r.right <= 0 || r.left >= innerWidth; });
+    if (!closed) skip('the filter column is open at 1024 px in this build');
+    const off = [];
+    for (let i = 0; i < 60; i++) {
+      await page.keyboard.press('Tab');
+      const f = await page.evaluate(() => { const e = document.activeElement; if (!e || e === document.body) return null; const r = e.getBoundingClientRect(); return { name: (e.innerText || e.getAttribute('aria-label') || e.id || '').trim().replace(/\s+/g, ' ').slice(0, 30), l: Math.round(r.left), r: Math.round(r.right), on: r.right > 0 && r.left < innerWidth && r.bottom > 0 && r.top < innerHeight }; });
+      if (f && !f.on && !off.some((o) => o.name === f.name)) off.push(f);
+    }
+    assert(!off.length, `Tab stops on controls that are off screen: ${off.map((o) => `"${o.name}" [${o.l}, ${o.r}]`).join(', ')}`);
+  });
+
