From e57151ffa360bb7371e07d2d53f2b331a5a54114 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 17 Oct 2026 15:43:39 +0000
Subject: [PATCH 22/56] Integration: fix-viz-5's patches: UX-36 Group select
 reads "No grouping"; build-market uses shared.js notBasePay (one rule for the
 market cells and the browser's medians)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 public/index.html       |  2 +-
 scripts/build-market.js | 12 +++---------
 2 files changed, 4 insertions(+), 10 deletions(-)

diff --git a/public/index.html b/public/index.html
index 775b5d9..062b930 100644
--- a/public/index.html
+++ b/public/index.html
@@ -131,7 +131,7 @@
               <option value="department">Department</option>
               <option value="location">Location</option>
               <option value="seniority">Seniority</option>
-              <option value="none">None</option>
+              <option value="none">No grouping</option>
             </select>
           </label>
         </div>
diff --git a/scripts/build-market.js b/scripts/build-market.js
index c342d7b..e650c4d 100644
--- a/scripts/build-market.js
+++ b/scripts/build-market.js
@@ -68,7 +68,7 @@ import path from 'node:path';
 import { fileURLToPath, pathToFileURL } from 'node:url';
 import { roleFamily } from '../public/features/compstimate.js';
 import { displayLevel, levelKey } from '../public/features/roles.js';
-import { isOTE, isInternLike, payCountry } from '../public/features/shared.js';
+import { isOTE, isInternLike, payCountry, notBasePay } from '../public/features/shared.js';
 import { toUSD, FX_AS_OF, hasFx } from '../public/viz/palette.js';
 
 export const MARKET_FORMAT = 'melon-market-1';
@@ -109,14 +109,8 @@ export function usdMid(salary) {
  * minimum, "from €46K"), 'shiftPay' (hourly pay including the highest shift differential) or 'partTime'
  * (part-time hourly pay at 2,080 hours). Pure; reads only job.salary.
  */
-export function notBasePay(job) {
-  const s = job && job.salary;
-  if (!s) return null;
-  if (s.kind === 'minimum') return 'minimum';
-  if (s.includesShiftDifferential === true) return 'shiftPay';
-  if (s.partTime === true) return 'partTime';
-  return null;
-}
+// fix-viz-5: one rule for the market cells and every median the browser draws (public/features/shared.js).
+export { notBasePay };
 export const NOT_BASE_KINDS = Object.freeze(['minimum', 'shiftPay', 'partTime']);
 
 /** The home country: most salaried postings, then the US, then the alphabet. */
