From b0feb055a4720d8341bff566bd5903fcaf92646a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 05:21:41 +0000
Subject: [PATCH 062/100] fix-app-6: V-44 at the Razr cover (from fix-ui-6): a
 short map's 'N postings list no place' line is short, the sentence in its
 title

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
(cherry picked from commit 29df67d9d7eed98acf73e4b3f5ec39e58671f0d0)
---
 public/viz/map.js         |  8 +++++++-
 test/e2e/fix-app-6.e2e.js | 22 ++++++++++++++++++++++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/public/viz/map.js b/public/viz/map.js
index 8bab661..3e0823e 100644
--- a/public/viz/map.js
+++ b/public/viz/map.js
@@ -549,8 +549,14 @@ export function createMap(container, { onSelect, onAreaSelect, onColorModeChange
   let unplaced = 0;
   function drawUnplaced() {
     unplacedEl.hidden = !unplaced;
-    unplacedEl.textContent = unplaced ? `${plural(unplaced, 'posting')} ${unplaced === 1 ? 'lists' : 'list'} no place, so not on the map` : '';
+    const long = unplaced ? `${plural(unplaced, 'posting')} ${unplaced === 1 ? 'lists' : 'list'} no place, so not on the map` : '';
+    // fix-app-6 (fix-ui-6's Razr cover screen, 352x355: the map is about 123 px tall): the long line covered the pins, so a
+    // short map gets the short one; the whole sentence stays in its title.
+    const short = unplaced && container.getBoundingClientRect().height < 220;
+    unplacedEl.textContent = short ? `${shortCount(unplaced)} with no place` : long;
+    unplacedEl.title = long;
   }
+  map.on('resize', () => { if (unplaced) drawUnplaced(); });
 
   // "Pay | Juice" segmented control (+ the Juice legend when active)
   let colorMode = COLOR_MODES.includes(initialMode) ? initialMode : 'pay';
diff --git a/test/e2e/fix-app-6.e2e.js b/test/e2e/fix-app-6.e2e.js
index c5dbe9b..48df718 100644
--- a/test/e2e/fix-app-6.e2e.js
+++ b/test/e2e/fix-app-6.e2e.js
@@ -444,6 +444,28 @@ export function registerFixApp6Tests(suite) {
     });
   }
 
+  suite.test('fix-app-6: [V-44 at the Razr cover, from fix-ui-6] Meta\'s map at 352x355: the "N postings list no place" line is short and leaves the pins clear', async (ctx) => {
+    const d = ALL_SIZES.find((x) => x.width === 352 && x.height === 355);
+    const { st, page, errors } = await open(ctx, { device: d });
+    await board(page, st, 'c=meta&m=map');
+    await page.locator('#mapHost .ms-pin').first().waitFor({ timeout: 60000 }).catch(() => {});
+    await sleep(1500);
+    const r = await page.evaluate(() => {
+      const e = document.querySelector('#mapHost .ms-map__unplaced');
+      if (!e || e.hidden) return null;
+      const b = e.getBoundingClientRect();
+      const pins = [...document.querySelectorAll('#mapHost .ms-pin')].map((p) => p.getBoundingClientRect()).filter((p) => p.width && p.height);
+      const over = pins.filter((p) => p.left < b.right && p.right > b.left && p.top < b.bottom && p.bottom > b.top).length;
+      return { text: e.textContent, title: e.title, w: Math.round(b.width), over, pins: pins.length };
+    });
+    if (!r) skip('every Meta posting lists a place in this build');
+    assert(/^[\d.,K]+ with no place$/.test(r.text), `the line reads "${r.text}" (${r.w} px)`);
+    assert(/lists? no place, so not on the map/.test(r.title), `its title "${r.title}"`);
+    assert(!r.over, `the line covers ${r.over} of ${r.pins} pins`);
+    await shot(page, 'v44-razr-cover-meta-map');
+    noErrors(errors);
+  });
+
   // [phone] Every line this lane added or changed, at every phone size: the stats line and the chart caption over Canadian
   // pay (Amazon interns in Vancouver) and over part-time hourly pay (Apple), and Insights' tiles.
   for (const d of ALL_SIZES) {
