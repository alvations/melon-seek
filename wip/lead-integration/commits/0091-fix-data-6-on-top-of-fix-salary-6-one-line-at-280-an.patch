   return { payHeadline, unlistedNotes: typeof unlistedNotes === 'function' ? unlistedNotes : null, pickedLevels: typeof pickedLevels === 'function' ? pickedLevels : null };`)(formatMoney, payAt, (c) => ({ US: 'the US', ES: 'Spain' }[c] || c), place);
