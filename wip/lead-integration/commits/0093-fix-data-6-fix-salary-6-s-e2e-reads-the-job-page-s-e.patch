---
 test/e2e/fix-salary-6.e2e.js | 17 ++++++++++-------
 1 file changed, 10 insertions(+), 7 deletions(-)

diff --git a/test/e2e/fix-salary-6.e2e.js b/test/e2e/fix-salary-6.e2e.js
index 6b2fb59..3d58d0f 100644
--- a/test/e2e/fix-salary-6.e2e.js
+++ b/test/e2e/fix-salary-6.e2e.js
@@ -92,10 +92,12 @@ async function appJob(page, base, company, id) {
 }
 
 // The reviewer's cases: the place picked, the line posted for it, and every line the posting gives.
+// fix-data-6 P-2: the job page writes a stated yearly figure as posted (`drawer`), the card rounds it (`pill`); on a phone
+// the heading may fall back to the card's figure where the exact one would wrap.
 const CASES = [
-  { id: 'google:111420466312159942', place: 'Milan', pill: '€124K–127K', lines: ['Germany', 'Italy'], was: 'Pay posted for Germany only', other: 'Germany' },
-  { id: 'google:123907061523063494', place: 'Paris', pill: /^€42K(\/year)?$/, lines: ['Ireland', 'Germany', 'France'], was: 'Pay posted for Ireland only', other: 'Ireland' },
-  { id: 'google:111289074672640710', place: 'Dublin', pill: '€116K–118K', lines: ['Ireland', 'Netherlands'], was: 'Pay posted for the Netherlands only', other: 'Netherlands' },
+  { id: 'google:111420466312159942', place: 'Milan', pill: '€124K–127K', drawer: '€124,000–127,000', lines: ['Germany', 'Italy'], was: 'Pay posted for Germany only', other: 'Germany' },
+  { id: 'google:123907061523063494', place: 'Paris', pill: /^€42K(\/year)?$/, drawer: /^€41,500(\/year)?$/, lines: ['Ireland', 'Germany', 'France'], was: 'Pay posted for Ireland only', other: 'Ireland' },
+  { id: 'google:111289074672640710', place: 'Dublin', pill: '€116K–118K', drawer: '€116,000–118,000', lines: ['Ireland', 'Netherlands'], was: 'Pay posted for the Netherlands only', other: 'Netherlands' },
 ];
 
 async function checkCase(ctx, device, c) {
@@ -122,7 +124,8 @@ async function checkCase(ctx, device, c) {
   await drawer(page, hash, c.id);
   await shot('drawer', page.locator('#drawer .d-salary').first());
   const amt = await text(page, '#drawer .d-sal-amt');
-  if (!want(amt)) bad.push(`the drawer reads "${amt}"`);
+  const exact = (v) => (typeof c.drawer === 'string' ? v === c.drawer : c.drawer.test(v));
+  if (!(exact(amt) || (device !== DESKTOP && want(amt)))) bad.push(`the drawer reads "${amt}"`);
   const sub = await text(page, '#drawer .d-sal-top .muted');
   if (!sub || !sub.startsWith(`Posted for ${c.place} · EUR`)) bad.push(`the line under the figure reads "${sub}"`);
   const note = await text(page, '#drawer .d-pay-note');
@@ -151,10 +154,10 @@ export function registerFixSalary6Tests(suite) {
     const c = CASES[0];
     if (!(await appJob(page, st.beta, 'google', c.id))) skip(`${c.id} is not in this build`);
     await drawer(page, 'c=google', c.id);
-    assertEq(await text(page, '#drawer .d-sal-amt'), '€124K–153K', `${c.id} drawer figure`);
+    assertEq(await text(page, '#drawer .d-sal-amt'), '€124,000–153,000', `${c.id} drawer figure (as posted, fix-data-6 P-2)`);
     assert((await text(page, '#drawer .d-sal-top .muted')).startsWith('2 places · EUR'), `${c.id}: "${await text(page, '#drawer .d-sal-top .muted')}"`);
     const places = await text(page, '#drawer .d-sal-places');
-    assert(/Germany\s*€150K–153K/.test(places) && /Italy\s*€124K–127K/.test(places), `${c.id}: Pay by place "${places}"`);
+    assert(/Germany\s*€150,000–153,000/.test(places) && /Italy\s*€124,000–127,000/.test(places), `${c.id}: Pay by place "${places}"`);
   });
 
   suite.test('fix-salary-6: [S-1] a line in another currency: Toronto is priced in CAD on Google\'s Canadian line, the card with no filter keeps the US line', async (ctx) => {
@@ -184,7 +187,7 @@ export function registerFixSalary6Tests(suite) {
     const note = await text(page, '#drawer .d-pay-note');
     assert(note.includes('The posting also gives pay for Spain: €38K–59.7K; this role isn’t listed there.'), `${id}: the pay Details "${note.slice(0, 400)}"`);
     const amt = await text(page, '#drawer .d-sal-amt');
-    assert(/^€49(\.2)?K–71(\.4)?K$/.test(amt), `${id}: the figure is Ireland's €49,200–71,400, it reads "${amt}"`);
+    assertEq(amt, '€49,200–71,400', `${id}: the figure is Ireland's €49,200–71,400, as posted (fix-data-6 P-2)`);
   });
 
   suite.test('fix-salary-6: [S-1] main site: Cohere\'s rows named for places price them under a Location filter (it priced none)', async (ctx) => {
