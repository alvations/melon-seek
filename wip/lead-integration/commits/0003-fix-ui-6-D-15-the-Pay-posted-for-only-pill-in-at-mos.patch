+/**
+ * fix-ui-6 (the lead, 2026-10-24, with ux-density-6's D checks): the "Pay posted for … only" pill in at most two lines at
+ * every size. It wraps by design beside the title (styles.css, max-width 10.5em, fix3-app BP-2); one that takes more
+ * lines there ("Pay posted for Santa Clara, Sunnyvale and 3 more only": four) widens to 15.5em (.is-wide; on a phone it
+ * then goes under the title, styles.css's card-top wrap), and only past that takes the shorter forms (`forms`, one place
+ * named, then fix-data-6's "For … only" and "Posted for other places"). Measured once laid out, by one shared observer,
+ * and again when its size changes (a font that loads late).
+ */
+let pillObserver = null;
+function pillLines(el) {
+  const r = document.createRange();
+  r.selectNodeContents(el);
+  const mids = [];
+  for (const x of r.getClientRects()) { if (x.width < 0.5) continue; const m = x.top + x.height / 2; if (!mids.some((t) => Math.abs(t - m) < 6)) mids.push(m); }
+  return mids.length;
+}
+function refitPill(el) {
+  const forms = el._pillForms;
+  el.classList.remove('is-wide');
+  if (el.textContent !== forms[0]) el.textContent = forms[0];
+  if (pillLines(el) <= 2) return;
+  el.classList.add('is-wide');
+  for (const f of forms) {
+    if (el.textContent !== f) el.textContent = f;
+    if (pillLines(el) <= 2) return;
+  }
+}
+function fitPill(el, forms) {
+  if (!forms?.length || typeof ResizeObserver !== 'function') return el;
+  el._pillForms = forms;
+  pillObserver ??= new ResizeObserver((entries) => {
+    for (const { target } of entries) {
+      if (!target.isConnected) { pillObserver.unobserve(target); continue; }
+      const w = target.getBoundingClientRect().width;
+      if (w < 1 || Math.abs(w - (target._pillW ?? -1)) < 0.5) continue;
+      refitPill(target);
+      target._pillW = target.getBoundingClientRect().width;
+    }
+  });
+  pillObserver.observe(el);
+  return el;
+}
+
