From a3d25cd4292bdb336d400ecc8ff9a5103212420f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 10:10:52 +0000
Subject: [PATCH 099/100] fix-ui-6: UX-17 measures the edge chips and the
 chart's texts where they are drawn (inside every box that clips them)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The gate on 505a4df failed UX-17 at p390 on Google: "‹1" at y 658-676 "touches" the notes line
"2,513 with pay · 1,308 without" (gap -1.0 px). That chip is on the row Technical Solutions, which runs past the bottom
of the rows' scroll box (it ends at y 654; the notes line sits under it, at 654-690): the box clips the chip, so it is
not drawn there (elementFromPoint at its centre is the notes line). The test measured bounding boxes, ignoring the clip.
It now intersects each chip and each text with the boxes that clip them; the off-screen check still uses the whole
chip. A sweep of every phone size, p390, 1024 and 1440 (Google and Apple, this head's build): 3 such clipped overlaps
(390x844 twice, 393x852), none on screen. The chart is unchanged: a visible chip is inside the rows' box and the notes
line is outside it, so they cannot meet.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
(cherry picked from commit d2c0fc65395ff67bd7395ac89100f1a3553bebc0)
---
 test/e2e/beta-ux-review.e2e.js | 22 ++++++++++++++++++----
 1 file changed, 18 insertions(+), 4 deletions(-)

diff --git a/test/e2e/beta-ux-review.e2e.js b/test/e2e/beta-ux-review.e2e.js
index dc83c25..f92fa30 100644
--- a/test/e2e/beta-ux-review.e2e.js
+++ b/test/e2e/beta-ux-review.e2e.js
@@ -133,18 +133,32 @@ export function registerBetaUxReviewTests(suite) {
         const r = await page.evaluate(() => {
           const out = [];
           const W = document.documentElement.clientWidth;
+          // fix-ui-6 (2026-10-24): what is on screen, inside every box that clips it. The chart's rows scroll in a box
+          // the notes line sits under; a row partly past that box's bottom has its chip clipped away, not drawn on the
+          // line (Google at p390: "‹1" at y 658–676 under a box that ends at 654, measured as touching the line).
+          const shown = (el, q) => {
+            let v = { left: q.left, right: q.right, top: q.top, bottom: q.bottom };
+            for (let e = el.parentElement; e; e = e.parentElement) {
+              if (getComputedStyle(e).overflow === 'visible') continue;
+              const b = e.getBoundingClientRect();
+              v = { left: Math.max(v.left, b.left), right: Math.min(v.right, b.right), top: Math.max(v.top, b.top), bottom: Math.min(v.bottom, b.bottom) };
+            }
+            return v.right - v.left > 0.5 && v.bottom - v.top > 0.5 ? v : null;
+          };
           const texts = [];
           const walker = document.createTreeWalker(document.querySelector('#chartHost'), NodeFilter.SHOW_TEXT);
           let n;
           while ((n = walker.nextNode())) {
             if (!n.textContent.trim() || n.parentElement.closest('.ms-bin')) continue;
             const rg = document.createRange(); rg.selectNodeContents(n);
-            for (const q of rg.getClientRects()) texts.push({ t: n.textContent.trim(), q });
+            for (const box of rg.getClientRects()) { const q = shown(n.parentElement, box); if (q) texts.push({ t: n.textContent.trim(), q }); }
           }
           for (const ch of document.querySelectorAll('.ms-bin__chip')) {
-            const r = ch.getBoundingClientRect();
-            if (!r.width) continue;
-            if (r.left < -0.5 || r.right > W + 0.5) out.push(`"${ch.textContent}" runs off the screen [${Math.round(r.left)}, ${Math.round(r.right)}] of ${W}`);
+            const all = ch.getBoundingClientRect();
+            if (!all.width) continue;
+            if (all.left < -0.5 || all.right > W + 0.5) out.push(`"${ch.textContent}" runs off the screen [${Math.round(all.left)}, ${Math.round(all.right)}] of ${W}`);
+            const r = shown(ch, all);
+            if (!r) continue;
             for (const { t, q } of texts) {
               if (q.bottom <= r.top || q.top >= r.bottom) continue;
               const gap = q.right <= r.left ? r.left - q.right : q.left >= r.right ? q.left - r.right : -1;
