diff --git a/test/viz-even.test.js b/test/viz-even.test.js
new file mode 100644
index 0000000..4ce9004
--- /dev/null
+++ b/test/viz-even.test.js
@@ -0,0 +1,136 @@
+// viz-even lane (docs/process/viz-even.md): the user, 2026-10-11, "Are you sure the salary range of the big tech
+// are correct?! They don't look correct and kinda all span too evenly." The numbers are the companies' own; part
+// of the even look was the chart's drawing. Pure parts:
+//   - placeCircles: a Clusters circle stands at the median midpoint of the postings it holds, not at the centre
+//     of a fixed $50K bin, and circles only merge when they would touch;
+//   - rangeKey / stackRanges: postings with the same Ranges bar are one row with their count.
+// Browser checks on the real boards: test/e2e/viz-even.e2e.js.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { placeCircles, rangeKey, stackRanges } from '../public/viz/chart.js';
+
+// The old drawing: $50K bins from $0, one circle per bin at the bin's centre.
+const oldCentre = (mid, binW = 50000) => Math.floor(mid / binW) * binW + binW / 2;
+const median = (xs) => { const s = xs.slice().sort((a, b) => a - b), n = s.length; return n % 2 ? s[(n - 1) / 2] : (s[n / 2 - 1] + s[n / 2]) / 2; };
+const rep = (mid, n, extra = {}) => Array.from({ length: n }, (_, i) => ({ mid, id: `${mid}-${i}`, ...extra }));
+// A 1440px chart: $0 to $400K over 480px (1.2 px per $1K), like Google's Clusters plot.
+const x = (v) => (v / 400000) * 480;
+const FULL = () => 34; // two full-size circles: 16 + 16 + 2
+const sized = (maxN) => (a, b) => Math.max(24, Math.max(4.5, 16 * Math.sqrt(a / maxN)) + Math.max(4.5, 16 * Math.sqrt(b / maxN)) + 2);
+
+test('[viz-even] a circle stands at the median midpoint of its postings, not at a bin centre (Google, Software Engineering)', () => {
+  // Google's own bands for the row, 2026-10-16: midpoints $178.5K, $213K, $253.5K and $313K.
+  const items = [...rep(178500, 118), ...rep(213000, 128), ...rep(253500, 200), ...rep(313000, 61)];
+  const cs = placeCircles(items, { x, need: sized(200) });
+  assert.deepEqual(cs.map((c) => c.at), [178500, 213000, 253500, 313000], 'one circle per posted band, at the band');
+  assert.deepEqual(cs.map((c) => c.items.length), [118, 128, 200, 61]);
+  for (const c of cs) assert.equal(c.at, median(c.items.map((p) => p.mid)), 'at is the median of its postings');
+  // The old view drew these four at $175K, $225K, $275K and $325K: 50K apart whatever the data.
+  assert.deepEqual(cs.map((c) => oldCentre(c.at)), [175000, 225000, 275000, 325000]);
+  const gaps = cs.slice(1).map((c, i) => c.at - cs[i].at);
+  assert.deepEqual(gaps, [34500, 40500, 59500], 'the gaps between circles are the gaps between the bands');
+});
+
+test('[viz-even] two bands in one old $50K bin get their own circles; one band split by a bin edge stays one', () => {
+  // Product Management: $167.5K (8) and $199.5K (27) shared the "$150K-$200K" circle, drawn at $175K.
+  const pm = placeCircles([...rep(167500, 8), ...rep(199500, 27)], { x, need: sized(27) });
+  assert.deepEqual(pm.map((c) => [c.at, c.items.length]), [[167500, 8], [199500, 27]]);
+  // $199K and $201K: the old bin edge at $200K drew them 60px apart; they are one concentration.
+  const edge = placeCircles([...rep(199000, 20), ...rep(201000, 30)], { x, need: sized(50) });
+  assert.equal(edge.length, 1, 'one circle');
+  assert.equal(edge[0].at, 201000, 'at their median');
+  assert.equal(edge[0].lo, 199000);
+  assert.equal(edge[0].hi, 201000);
+  assert.notEqual(oldCentre(199000), oldCentre(201000), 'the old bins split them');
+});
+
+test('[viz-even] no two circles are closer than they need to be apart, and every posting is in exactly one', () => {
+  // A spread of midpoints like Amazon's (many near-identical bands) plus a few lone ones.
+  let seed = 20261016;
+  const rnd = () => { seed = (seed * 1103515245 + 12345) % 2147483648; return seed / 2147483648; };
+  const items = [];
+  for (let i = 0; i < 3000; i++) items.push({ id: `a${i}`, mid: 60000 + Math.round(rnd() * 300) * 1000 });
+  items.push(...rep(143700 / 2 + 194400 / 2, 875), ...rep(80450, 391));
+  const maxN = 1300;
+  const need = sized(maxN);
+  const cs = placeCircles(items, { x, need });
+  for (let k = 1; k < cs.length; k++) {
+    const gap = x(cs[k].at) - x(cs[k - 1].at);
+    assert.ok(gap >= need(cs[k - 1].items.length, cs[k].items.length) - 1e-9, `circles ${k - 1} and ${k} are ${gap.toFixed(1)}px apart`);
+    assert.ok(cs[k - 1].hi < cs[k].lo, 'circles hold runs of neighbouring midpoints, in order');
+  }
+  const ids = cs.flatMap((c) => c.items.map((p) => p.id));
+  assert.equal(ids.length, items.length, 'nothing dropped');
+  assert.equal(new Set(ids).size, items.length, 'nothing counted twice');
+  for (const c of cs) assert.equal(c.at, median(c.items.map((p) => p.mid)));
+});
+
+test('[viz-even] small circles may sit closer than big ones; a lone circle is never closer than the 24px touch target', () => {
+  // Three lone postings 25px apart: three circles (4.5px each). The same spacing between two big bands merges them.
+  const lone = placeCircles([{ mid: 100000 }, { mid: 120834 }, { mid: 141668 }], { x, need: sized(400) });
+  assert.equal(lone.length, 3);
+  const big = placeCircles([...rep(100000, 400), ...rep(120834, 400)], { x, need: sized(400) });
+  assert.equal(big.length, 1, 'two full-size circles 25px apart would overlap');
+  const tight = placeCircles([{ mid: 100000 }, { mid: 115000 }], { x, need: sized(400) });
+  assert.equal(tight.length, 1, '18px apart is under the touch target');
+  // At full size (the first planning pass) the threshold is 34px whatever the counts.
+  assert.equal(placeCircles([{ mid: 100000 }, { mid: 125000 }], { x, need: FULL }).length, 1);
+  assert.equal(placeCircles([{ mid: 100000 }, { mid: 130000 }], { x, need: FULL }).length, 2);
+});
+
+test('[viz-even] closest first: the result does not depend on the input order', () => {
+  const items = [...rep(150000, 5), ...rep(170000, 3), ...rep(178000, 9), ...rep(205000, 2), ...rep(211000, 4), ...rep(260000, 1)];
+  const a = placeCircles(items, { x, need: sized(9) }).map((c) => [c.at, c.items.length]);
+  const b = placeCircles(items.slice().reverse(), { x, need: sized(9) }).map((c) => [c.at, c.items.length]);
+  assert.deepEqual(a, b);
+  assert.deepEqual(placeCircles([], { x, need: FULL }), []);
+  assert.deepEqual(placeCircles(rep(99000, 4), { x, need: FULL }).map((c) => [c.at, c.lo, c.hi, c.items.length]), [[99000, 99000, 99000, 4]]);
+});
+
+/* ---------------------------------------------------------------- Ranges */
+
+const bar = (id, lo, hi, extra = {}) => ({ job: { id }, key: 'Software Engineering', cur: 'USD', lo, hi, mid: (lo + hi) / 2, ote: false, span: null, partTime: false, ...extra });
+
+test('[viz-even] Ranges: postings with the same posted range are one row with their count (Microsoft IC4 $119,800-$234,700)', () => {
+  const items = [
+    ...Array.from({ length: 95 }, (_, i) => bar(`se${i}`, 119800, 234700)),
+    ...Array.from({ length: 32 }, (_, i) => bar(`pm${i}`, 119800, 234700, { key: 'Product Management' })),
+    bar('ic5', 142800, 274800),
+    ...Array.from({ length: 3 }, (_, i) => bar(`se-late${i}`, 119800, 234700)),
+  ].sort((a, b) => b.mid - a.mid);
+  const rows = stackRanges(items);
+  assert.deepEqual(rows.map((r) => [r.p.key, r.p.lo, r.n]), [
+    ['Software Engineering', 142800, 1],
+    ['Software Engineering', 119800, 98],
+    ['Product Management', 119800, 32],
+  ], 'one row per bar and colour; the count is every posting with that bar');
+  const ids = rows.flatMap((r) => r.items.map((p) => p.job.id));
+  assert.equal(ids.length, items.length, 'every posting is in a row');
+  assert.equal(new Set(ids).size, items.length);
+  assert.equal(rows[1].p.job.id, 'se0', 'the row stands for its first posting');
+});
+
+test('[viz-even] Ranges: a different bar is a different row (currency, midpoint, on-target earnings, levels, part-time)', () => {
+  const base = bar('a', 100000, 150000);
+  const levels = (l4, l5) => ({ kind: 'levels', tiers: [{ label: 'Level 4', min: l4[0], max: l4[1] }, { label: 'Level 5', min: l5[0], max: l5[1] }] });
+  const variants = [
+    bar('b', 100000, 150000, { cur: 'EUR' }),
+    bar('c', 100000, 150000, { mid: 130000 }),
+    bar('d', 100000, 150000, { ote: true }),
+    bar('e', 100000, 150000, { span: levels([100000, 130000], [120000, 150000]) }),
+    bar('f', 100000, 150000, { span: levels([100000, 125000], [118000, 150000]) }),
+    bar('g', 100000, 150000, { partTime: true }),
+    bar('h', 100000, 150000, { key: 'Sales' }),
+  ];
+  const keys = new Set([base, ...variants].map(rangeKey));
+  assert.equal(keys.size, 8, 'eight different bars');
+  assert.equal(rangeKey(bar('z', 100000, 150000)), rangeKey(base), 'the same bar on another posting');
+  const e2 = bar('e2', 100000, 150000, { span: levels([100000, 130000], [120000, 150000]) });
+  assert.equal(rangeKey(e2), rangeKey(variants[3]), 'the same two levels');
+  assert.equal(stackRanges([base, ...variants, bar('z', 100000, 150000)]).find((r) => r.p === base).n, 2);
+  // The colour a bar is drawn in: departments past the legend's seven share the "Other" colour, so their
+  // bars with one posted range are one row (Anduril posts $146,000-$194,000 in hundreds of departments).
+  const small = [bar('o1', 146000, 194000, { key: 'People : Recruiting' }), bar('o2', 146000, 194000, { key: 'Finance : FP&A' })];
+  assert.equal(stackRanges(small).length, 2, 'by department, two bars');
+  assert.deepEqual(stackRanges(small, (p) => rangeKey(p, 'Other')).map((r) => r.n), [2], 'drawn in one colour, one row');
+});
