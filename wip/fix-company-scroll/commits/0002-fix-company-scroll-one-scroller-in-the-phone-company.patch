From 0f1cb7095bb0aa9131968bd32e5c2a28a61c5450 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 13:29:24 +0000
Subject: [PATCH 2/4] fix-company-scroll: one scroller in the phone company
 sheet (search pinned, list fills the sheet); --vvt for a panned visual
 viewport; no repaint of identical rows

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 public/app.js                      | 11 ++++++++++-
 public/styles.css                  | 24 ++++++++++++++++++++++--
 test/e2e/fix-company-scroll.e2e.js |  4 ++--
 3 files changed, 34 insertions(+), 5 deletions(-)

diff --git a/public/app.js b/public/app.js
index bd8022c..d340bd1 100644
--- a/public/app.js
+++ b/public/app.js
@@ -1505,9 +1505,17 @@ function makeCompanyMenu() {
     if (e.key === 'ArrowDown') { e.preventDefault(); items[Math.min(items.length - 1, i + 1)]?.focus(); }
     if (e.key === 'ArrowUp') { e.preventDefault(); if (i <= 0) input.focus(); else items[i - 1].focus(); }
   });
+  let painted = null;
   function sync() {
     const q = input.value.trim().toLowerCase();
     const all = allCompanies().filter((c) => !q || `${c.name} ${c.board} ${c.source}`.toLowerCase().includes(q));
+    const saved = listSaved().filter((x) => !q || x.name.toLowerCase().includes(q));
+    // fix-company-scroll: syncPopover runs on every render (a beta board's live check settling, a saved
+    // board loading); rebuilding identical rows under a finger can cut a touch scroll short, so only a
+    // change repaints.
+    const key = JSON.stringify([S.c, all.map((c) => [c.slug, c.name, c.custom, c.live, companyColor(c)]), saved.map((x) => [x.id, x.name, savedNewCount(x)])]);
+    if (key === painted && list.childElementCount) return;
+    painted = key;
     // D-25 / M-21: the beta site's big-tech boards (static `live: false`: their own careers sites) come
     // first, under their own heading, instead of last below the fold; the main site keeps one list.
     const builtins = all.filter((c) => !c.custom);
@@ -1527,7 +1535,6 @@ function makeCompanyMenu() {
     }, h('span', { class: 'dot', style: `--dot:${companyColor(c)}` }), h('span', { class: 'company-item-name' }, c.name),
     c.slug === S.c ? h('span', { class: 'company-item-check', 'aria-hidden': 'true' }, '✓') : null)))));
     if (!groups.length) list.append(h('p', { class: 'fnote' }, 'No matching company — add its job board below.'));
-    const saved = listSaved().filter((x) => !q || x.name.toLowerCase().includes(q));
     if (saved.length) {
       list.prepend(group('Saved searches', saved.map((x) => {
         const n = savedNewCount(x);
@@ -4201,8 +4208,10 @@ function bindKeyboardInsets() {
     document.body.classList.toggle('kb-open', open);
     document.body.classList.toggle('kb-search', open && document.activeElement?.id === 'search'); // M-12: lift the peek row
     document.documentElement.style.setProperty('--vvh', `${Math.round(vv.height)}px`);
+    document.documentElement.style.setProperty('--vvt', `${Math.max(0, Math.round(vv.offsetTop || 0))}px`); // fix-company-scroll: iOS pans the visual viewport
   });
   vv.addEventListener('resize', sync);
+  vv.addEventListener('scroll', sync);
   document.addEventListener('focusin', (e) => {
     sync();
     if (isMobile() && e.target.matches?.('#filters input, #popover input')) setTimeout(() => revealField(e.target), 300);
diff --git a/public/styles.css b/public/styles.css
index 6880ea2..606fbeb 100644
--- a/public/styles.css
+++ b/public/styles.css
@@ -1185,9 +1185,26 @@ html[data-mode="insights"] .viz-controls { display: none; }
   .popover, .popover--more, .popover--board, .popover--badge, .popover--company {
     width: 100%; max-height: 82vh; max-height: 82dvh; padding-bottom: env(safe-area-inset-bottom);
   }
-  body.kb-open .popover { top: calc(8px + env(safe-area-inset-top)) !important; bottom: auto; max-height: calc(var(--vvh, 60vh) - 16px); border-radius: 16px; }
+  /* --vvt: how far iOS has panned the visual viewport down (keyboard up); the sheet follows it, so it is never above the screen. */
+  body.kb-open .popover { top: calc(var(--vvt, 0px) + 8px + env(safe-area-inset-top)) !important; bottom: auto; max-height: calc(var(--vvh, 60vh) - 16px); border-radius: 16px; }
   .pop-head .icon-btn { width: var(--m-row); height: var(--m-row); }
-  .pop-body, .company-list { overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
+  /* fix-company-scroll: every bottom sheet has ONE scroll box. Nested scroll boxes (the company list's
+     340px box inside the scrolling .pop-body, both overscroll-contained) left the list's end below the
+     sheet's visible area whenever the sheet was short: a swipe on the list never reached .pop-body, so
+     the last companies could not be reached (iOS Safari's toolbars and keyboard make that the common case).
+     `pinch-zoom` is unknown to Safari, which then keeps the default (auto); others get pan-y + zoom. */
+  .popover { overscroll-behavior: contain; }
+  .pop-body { min-height: 0; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
+  .pop-head { flex: none; }
+  /* The company sheet: the search is pinned at the top, the list fills the rest and is the only scroller. */
+  .popover--company .pop-body { flex: 1 1 auto; display: flex; flex-direction: column; overflow: hidden; padding-bottom: 10px; }
+  .popover--company .company-menu { flex: 1 1 auto; min-height: 0; }
+  .popover--company .fsearch-wrap, .popover--company .company-menu > .btn { flex: none; }
+  .popover--company .company-list {
+    flex: 1 1 auto; min-height: 0; max-height: none; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding-bottom: 6px;
+    touch-action: pan-y pinch-zoom;
+  }
+  body.kb-open .popover--company .company-menu > .btn { display: none; }   /* typing: the list gets the room; back when the keyboard closes */
   .company-item { min-height: var(--m-row); font-size: 15px; }
   .company-item-board { font-size: 12px; }
   .popover input, .popover select, .board-form input, .board-form select { font-size: 16px; min-height: var(--m-row); }
@@ -1229,6 +1246,9 @@ html[data-mode="insights"] .viz-controls { display: none; }
   .ms-chart__hist, .ms-chart__foot { display: none; }   /* landscape: rows matter more than the strip and notes */
   .results-head { min-height: 40px; }
   .sheet-handle { height: 20px; }
+  /* fix-company-scroll: a landscape keyboard leaves ~150px; the company list keeps it (the title returns when it closes). */
+  body.kb-open .popover--company .pop-head { display: none; }
+  body.kb-open .popover--company .pop-body { padding-top: 10px; }
 }
 
 /* Touch screens: no sticky hover looks after a tap; press feedback instead. */
diff --git a/test/e2e/fix-company-scroll.e2e.js b/test/e2e/fix-company-scroll.e2e.js
index 89e22be..52d2f8d 100644
--- a/test/e2e/fix-company-scroll.e2e.js
+++ b/test/e2e/fix-company-scroll.e2e.js
@@ -132,8 +132,8 @@ function assertSheet(g, label, { scroller = 'company-list' } = {}) {
   assert(g.sheet.top >= -0.5 && g.sheet.bottom <= g.viewBottom + 0.5, `the sheet sits inside the visible viewport (${g.sheet.top}–${g.sheet.bottom} of ${g.viewBottom}) — ${tag}`);
   assert(g.list.bottom <= g.viewBottom + 0.5, `the list's bottom edge is on screen — ${tag}`);
   assert(g.list.height >= 80, `the list shows at least two rows (${g.list.height}px) — ${tag}`);
-  assert(g.last && g.last.bottom > g.list.top && g.last.bottom <= g.list.bottom + 0.5, `scrolled to its end, the end of the content is visible — ${tag}`);
-  if (g.lastItem) assert(g.lastItem.top >= g.list.top - 0.5 && g.lastItem.bottom <= g.list.bottom + 0.5, `the last company is fully visible at the end — ${tag}`);
+  assert(g.last && g.last.bottom > g.list.top && g.last.bottom <= g.list.bottom + 1, `scrolled to its end, the end of the content is visible — ${tag}`);
+  if (g.lastItem) assert(g.lastItem.top >= g.list.top - 0.5 && g.lastItem.bottom <= g.list.bottom + 1, `the last company is fully visible at the end — ${tag}`);
 }
 
 export function registerFixCompanyScrollTests(suite) {
