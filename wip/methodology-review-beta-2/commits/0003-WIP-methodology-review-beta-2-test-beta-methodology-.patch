+// Methodology and sources review of the beta site, round 3 (docs/process/methodology-review-beta-2.md).
+// Findings MR-23 to MR-42, on the lead's reviewer build of 6178be7 with the 2026-10-16 crawl (every board
+// whole: Amazon 22,179, Apple 4,851, Google 3,821, NVIDIA 2,711, Microsoft 2,435, Meta 1,208, Netflix 414;
+// main-site Anduril 2,537). Each test encodes a missing registry entry, a stale as-of date or value, a number
+// shown without the caveat or source it needs, or a line of docs that no longer matches the code.
+// They run as to-dos, the project's convention (test/beta-methodology.test.js): a failing to-do is reported
+// but does not turn CI red. The fix that makes one pass removes `todo` from it.
+// Every test reads only the repo (code, docs, data/freshness.json) or builds its own small input; none needs
+// the crawl data. Owner: the methodology-review-beta-2 agent. test/beta-methodology.test.js (round 2) is not
+// touched; its open to-dos (MR-4, MR-21, MR-22) are listed in the log.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { staleness } from '../scripts/refresh/lib.js';
+import { loadFigureInputs, figureContext, renderFigure } from '../scripts/methodology-figures.js';
+import { buildMarket } from '../scripts/build-market.js';
+import { isFixedTerm } from '../public/features/shared.js';
+import { FX_PER_USD as PALETTE_FX } from '../public/viz/palette.js';
+import { MAX_ANNUAL, payAreaOf } from '../server/salary.js';
+import { geocode, GAZETTEER_SIZE } from '../server/geo.js';
+import { listCompanies } from '../server/companies.js';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+const read = (rel) => fs.readFileSync(path.join(ROOT, rel), 'utf8');
+const REG = JSON.parse(read('data/freshness.json'));
+const entryOf = (id) => REG.entries.find((e) => e.id === id);
+const REG_TEXT = JSON.stringify(REG);
+const REVIEW_DAY = new Date('2026-10-16T19:55:00Z'); // the reviewer build's time (the crawl: 11:58-12:45 UTC)
+const todo = (id) => ({ todo: `${id}: docs/process/methodology-review-beta-2.md` });
+const section = (text, head) => {
+  const i = text.indexOf(head);
+  assert.ok(i >= 0, `no "${head}" heading (the doc moved; update this test)`);
+  const j = text.indexOf('\n## ', i + head.length);
+  return text.slice(i, j < 0 ? undefined : j);
+};
+/** file:line of the first line declaring `const NAME` (or containing `needle`); fails loudly if the code moved. */
+function lineOf(file, name) {
+  const lines = read(file).split('\n');
+  const i = lines.findIndex((l) => new RegExp(`\\bconst ${name}\\b`).test(l));
+  assert.ok(i >= 0, `${file}: no "const ${name}" (renamed or removed; update this test)`);
+  return `${file}:${i + 1}`;
+}
+
+/* -------------------------------------------------------- MR-23 (Medium) */
+// fx-per-usd is as of 2026-07-01 on a monthly cadence: 107 days old, 62 days past due on the review day
+// (run.js --staleness: STALE). Round 2's MR-4 asked for the FX refresh; it never landed. Every converted
+// figure (Amazon 803, Google 452, Microsoft 314, NVIDIA 39, Netflix 24, Meta 9 postings) and all non-US
+// Juice use these rates.
+test('MR-23 exchange rates are within their monthly cadence on the 2026-10-16 review day', todo('MR-23'), () => {
+  const e = entryOf('fx-per-usd');
+  const s = staleness(e, REVIEW_DAY);
+  assert.equal(s.overdue, false, `fx-per-usd as of ${e.asOf}: ${s.ageDays} days old, ${-s.dueInDays} days past due`);
+});
+
+/* -------------------------------------------------------- MR-24 (Medium) */
+// Constants added since 2026-10-11 that decide a number, label or count a user sees, with no registry entry.
+const MR24 = [
+  ['server/salary.js', 'LEGAL_MIN_ANNUAL', 'Mexico\'s legal minimum (CONASAMI MXN 315.04/day x 365) that exempts real peso pay from the floors; changes every 1 January'],
+  ['server/salary.js', 'DOLLAR_COUNTRY', 'a bare "$" in a Mexico-only posting is MXN (DQ-35), CAD in Canada, AUD, NZD, SGD, HKD'],
+  ['server/sources/apple.js', 'APPLE_PAY_STATES', 'the pay-transparency states Apple posts pay for (DQ-27): Juice and Location only there'],
+  ['server/families.js', 'FAMILIES', 'Google\'s 27 job families, read from titles (google-grouping)'],
+  ['server/keywords.js', 'AMAZON_RUNG', 'Amazon numerals: I Entry, II Mid, III-IV Senior, V+ Staff+ (DQ-36)'],
+  ['server/keywords.js', 'META_LEADERSHIP_RE', 'Meta "(Technical Leadership)" read as Staff+ (DQ-37)'],
+  ['server/keywords.js', 'GOOGLE_NUMBERED_MANAGER_RE', 'Google "Facilities Manager II" is a people manager (DQ-29)'],
+  ['server/keywords.js', 'NEAR_COPY_SHARE', 'team paragraphs repeated by many roles are not skills (fix6, 0.95)'],
+  ['server/keywords.js', 'NEAR_COPY_MIN_ROLES', 'the same rule\'s 10 roles'],
+  ['server/sources/amazon.js', 'MINIMUM_RE', 'a stated minimum is shown "from €X" (VT-17)'],
+  ['server/sources/amazon.js', 'SHIFT_RE', 'hourly pay that includes the highest shift differential (VT-18)'],
+  ['server/sources/amazon.js', 'STATED_BASE_RE', '"Pay starts at $18.05 per hour", the stated base beside it (VT-18)'],
+  ['server/sources/amazon.js', 'STATED_ANNUAL_RE', 'Austria\'s stated annual figure, 14 payments (VT-19)'],
+  ['scripts/build-static.js', 'PREVIEW_MIN_JOBS', 'boards of 10,000+ get the first-page preview ("Loading 22,179 roles…")'],
+  ['scripts/build-static.js', 'PREVIEW_SIZE', 'the ~100 postings the preview shows first'],
+  ['public/viz/palette.js', 'PAY_BREAKS', 'the map\'s Pay legend steps $100K / $150K / $200K / $300K'],
+  ['public/viz/map.js', 'MIN_PIN_PAY', 'a map pin shows a median only from 3+ postings with pay there (V-17)'],
+];
+for (const [file, name, what] of MR24) {
+  test(`MR-24 registry names ${name} (${file}; ${what})`, todo('MR-24'), () => {
+    const at = lineOf(file, name);
+    const named = name === 'FAMILIES' ? /server\/families\.js/.test(REG_TEXT) : new RegExp(`\\b${name}\\b`).test(REG_TEXT);
+    assert.ok(named, `${at} ${name} has no data/freshness.json entry`);
+  });
+}
+test('MR-24 the Mexican legal minimum has its own yearly entry with its official source (CONASAMI)', todo('MR-24'), () => {
+  const e = REG.entries.find((x) => /LEGAL_MIN_ANNUAL/.test(JSON.stringify(x.owners || [])));
+  assert.ok(e, 'no registry entry owns server/salary.js LEGAL_MIN_ANNUAL');
+  assert.match(JSON.stringify(e.source || ''), /CONASAMI|Comisi[oó]n Nacional de los Salarios M[ií]nimos|DOF/i, `${e.id}: source does not name CONASAMI or the Diario Oficial`);
+  assert.equal(e.cadence, 'yearly', `${e.id}: Mexico sets its minimum wage every January; cadence is ${e.cadence}`);
+  assert.equal(e.asOf, '2026-01-01', `${e.id}: the 2026 minimum is in force from 2026-01-01; asOf is ${e.asOf}`);
+});
+
+/* -------------------------------------------------------- MR-25 (Medium) */
+// Registry values the code has moved past.
+test('MR-25 salary-parser-bounds: MAX_ANNUAL in the registry equals the code (1,500,000 since VT-10)', todo('MR-25'), () => {
+  const v = String(entryOf('salary-parser-bounds').values);
+  const m = /MAX_ANNUAL\s+(\d[\d_]*(?:,\d{3})*)/.exec(v);
+  assert.ok(m, 'salary-parser-bounds values do not state MAX_ANNUAL');
+  assert.equal(Number(m[1].replace(/[,_]/g, '')), MAX_ANNUAL, `registry says MAX_ANNUAL ${m[1]}, server/salary.js has ${MAX_ANNUAL}`);
+});
+test('MR-25 job-salary-parsed: no 12-row cap is described (SB-3 removed it)', todo('MR-25'), () => {
+  const e = JSON.stringify(entryOf('job-salary-parsed'));
+  assert.doesNotMatch(e, /slice\(0, ?12\)/, 'job-salary-parsed still describes deriveSalary as ranges.slice(0,12)');
+});
+test('MR-25 geo-gazetteer: the registry\'s gazetteer size equals GAZETTEER_SIZE', todo('MR-25'), () => {
+  const v = String(entryOf('geo-gazetteer').values);
+  const m = /(\d+) cities, (\d+) states, (\d+) countries/.exec(v);
+  assert.ok(m, 'geo-gazetteer values do not state the gazetteer size');
+  assert.deepEqual([+m[1], +m[2], +m[3]], [GAZETTEER_SIZE.cities, GAZETTEER_SIZE.states, GAZETTEER_SIZE.countries],
+    `registry ${m[0]}; server/geo.js ${GAZETTEER_SIZE.cities} cities, ${GAZETTEER_SIZE.states} states, ${GAZETTEER_SIZE.countries} countries`);
+});
+test('MR-25 job-postings and company-registry: Amazon and Meta are no longer waiting for a first crawl', todo('MR-25'), () => {
+  const jp = String(entryOf('job-postings').values);
+  const cr = String(entryOf('company-registry').values);
+  assert.doesNotMatch(jp, /counts after their first crawl/, 'job-postings: "amazon … and meta … counts after their first crawl" (both crawled since 2026-10-11)');
+  assert.doesNotMatch(cr, /appears on \/beta\/ after its first crawl/, 'company-registry: "each appears on /beta/ after its first crawl"');
+  for (const slug of listCompanies({ channel: 'beta' }).map((c) => c.slug)) {
+    assert.match(jp, new RegExp(`\\b${slug} [\\d,]+`), `job-postings values give no count for ${slug}`);
+  }
+  assert.doesNotMatch(String(entryOf('job-postings').notes), /trimmed or capped \(jobsCapped\)/, 'job-postings notes: no board is capped since 2026-10-11');
+});
+test('MR-25 seniority-ladder: no "USER DECISION PENDING" note after BP-7 decided it ("Level not stated")', todo('MR-25'), () => {
+  assert.doesNotMatch(String(entryOf('seniority-ladder').notes), /USER DECISION PENDING/, 'seniority-ladder notes still say USER DECISION PENDING');
+});
+
+/* -------------------------------------------------------- MR-26 (Medium) */
+// The methodology page's sources table says Gross pay is "Daily · update due" on a page built hours after
+// the crawl. loadFigureInputs marks each entry stale from its hand-set asOf (job-postings 2026-10-11), while
+// run.js stalenessRows treats daily entries as 'pipeline' (refreshed by snapshot.yml / pages.yml).
+test('MR-26 the sources table does not call the job postings overdue on the build day', todo('MR-26'), async () => {
+  const before = process.env.MELON_BUILT_AT;
+  process.env.MELON_BUILT_AT = REVIEW_DAY.toISOString();
+  try {
+    const ctx = figureContext(await loadFigureInputs(ROOT));
+    const html = renderFigure('sources', ctx);
+    const row = /<tr><th scope="row"[^>]*>Gross pay<\/th>.*?<\/tr>/.exec(html);
+    assert.ok(row, 'the sources table has no Gross pay row (update this test)');
+    assert.doesNotMatch(row[0], /update due/, 'Gross pay reads "Daily · update due" though every board was read the same day');
+  } finally {
+    if (before == null) delete process.env.MELON_BUILT_AT; else process.env.MELON_BUILT_AT = before;
+  }
+});
+
+/* -------------------------------------------------------- MR-27 (Medium) */
+// The guide and the technical reference describe pay rules the code has replaced.
+const GUIDE = () => read('docs/METHODOLOGY_GUIDE.md');
+test('MR-27 guide §1: pay posted per place is scored on that place\'s own range, not the span (DQ-28, DQ-33)', todo('MR-27'), () => {
+  assert.match(read('server/juice.js'), /const placeUSD = /, 'server/juice.js no longer scores a place on its own range (update this test)');
+  const g = GUIDE();
+  assert.doesNotMatch(g, /range for each of several places or levels, the middle is taken across all of them/, 'METHODOLOGY_GUIDE.md §1 says a range per place is scored on the middle of the span');
+  assert.doesNotMatch(g, /\*\*Pay ranges for several places or levels\*\* are scored on their middle across all of them, not on the range for one place/, 'METHODOLOGY_GUIDE.md §5 says the same');
+});
+test('MR-27 guide §5: the example of a currency with no rate is not one the site converts (RON has a rate)', todo('MR-27'), () => {
+  assert.ok(PALETTE_FX.RON > 0, 'RON has no rate again (update this test)');
+  assert.doesNotMatch(GUIDE(), /no rate for \(Romanian lei, for example\)/, 'METHODOLOGY_GUIDE.md §5 names Romanian lei as unconvertible');
+});
+test('MR-27 guide: "How is the posted pay read?" covers minimums, shift pay, Austria\'s annual figure and levels/places spans', todo('MR-27'), () => {
+  const g = GUIDE();
+  const i = g.indexOf('### How is the posted pay read?');
+  const faq = g.slice(i, g.indexOf('\n### ', i + 5));
+  assert.match(faq, /minimum/i, 'the FAQ never says a stated minimum is shown as "from €X"');
+  assert.match(faq, /shift differential|shift pay/i, 'the FAQ never says some hourly figures include the highest shift differential');
+  assert.match(faq, /each place|per place|its own range/i, 'the FAQ never says a range posted per place is listed under "Pay by place"');
+});
+test('MR-27 LIVABILITY.md: no "RON has no rate anywhere", and per-place ranges are scored on their own range', todo('MR-27'), () => {
+  const l = read('docs/LIVABILITY.md');
+  assert.doesNotMatch(l, /RON \(Romanian lei\) has no rate anywhere/, 'LIVABILITY.md says RON has no rate; palette, juice and cities.json have 4.58165');
+  assert.doesNotMatch(l, /over several places \(`salary\.ranges`, Apple requisitions\) or levels \(`salary\.levels`, NVIDIA and\s+Microsoft\) is scored on the span's midpoint/,
+    'LIVABILITY.md attachJuice rules say a per-place range is scored on the span\'s midpoint (juice.js placeUSD scores each place on its own)');
+});
+
+/* -------------------------------------------------------- MR-28 (Medium) */
+// "Posted base pay" comparisons (Same role elsewhere, Compare companies, Compstimate's pool) pool Amazon's
+// stated minimums (285), figures that include the highest shift differential (636) and part-time hourly pay
+// at 2,080 hours (Amazon 83, Apple 40) with base-pay ranges of full-time roles. Only the drawer's pay block
+// says what each figure is. scripts/build-market.js companyPart leaves out interns, fixed-term pay and
+// on-target earnings only.
+test('MR-28 market comps: minimums, shift-inclusive and part-time hourly figures are not pooled as full-time base pay', todo('MR-28'), () => {
+  const loc = [{ name: 'Seattle, WA', city: 'Seattle', region: 'WA', country: 'US', lat: 47.6, lng: -122.33 }];
+  const job = (id, mid, extra = {}) => ({ id: `amazon:${id}`, title: 'Software Development Engineer', seniority: 'Mid', seniorityBasis: 'title', locations: loc,
+    salary: { min: mid, max: mid, mid, currency: 'USD', interval: 'year', ...extra } });
+  const jobs = [job(1, 200000), job(2, 200000), job(3, 200000),
+    job(4, 40000, { kind: 'minimum' }), job(5, 40000, { kind: 'minimum' }), job(6, 40000, { kind: 'minimum' }),
+    job(7, 50000, { kind: 'hourly', originalInterval: 'hour', includesShiftDifferential: true }), job(8, 50000, { kind: 'hourly', originalInterval: 'hour', includesShiftDifferential: true }),
+    job(9, 45000, { kind: 'hourly', originalInterval: 'hour', partTime: true, hoursPerWeek: 30 })];
+  const m = buildMarket([{ company: { slug: 'amazon', name: 'Amazon' }, mode: 'snapshot', jobs }], { generatedAt: '2026-10-16T00:00:00Z' });
+  const cells = m.cells.filter((c) => c[0] === 'amazon' && c[2] === 'Mid');
+  assert.ok(cells.length, 'no Amazon Mid cell (update this test)');
+  for (const c of cells) assert.equal(c[5], 200000, `cell ${c.slice(0, 3).join('/')}: median ${c[5]} from ${c[3]} postings mixes minimums, shift pay and part-time hourly pay into posted base pay`);
+});
+
