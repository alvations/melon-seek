+// Microsoft's SF Bay Area / NYC range (SB-5) is assigned by distance (PAY_AREAS, 60 km from Manhattan). Garden
+// City NY, Fort Lee NJ and Paramus NJ geocode to their state's centre, so 4 postings price them at the national
+// range, below the posted NYC-metro range (microsoft:1970393556650765 "Pay by place: Redmond, Garden City, Boston").
+test('MR-40 NYC-metro towns are placed in Microsoft\'s NYC pay area', todo('MR-40'), () => {
+  for (const s of ['Garden City, NY, US', 'Fort Lee, NJ, US', 'Paramus, NJ, US']) {
+    const [loc] = geocode(s);
+    assert.equal(payAreaOf(loc), 'nyc', `${s} geocodes to ${loc.lat},${loc.lng} (its state's centre), outside the 60 km NYC area`);
+  }
+});
+
+/* -------------------------------------------------------- MR-41 (Medium) */
+// Levels: every card, the Seniority filter, Same role elsewhere ("at Senior level") and Compstimate use seven
+// buckets, each company's ladder mapped differently (Amazon "III" Senior, Google "III" Mid, Microsoft IC4
+// Senior, NVIDIA Level 3-5 Senior, Meta "(Technical Leadership)" Staff+). Neither methodology page says how.
+test('MR-41 the methodology guide explains the level buckets and how company ladders map to them', todo('MR-41'), () => {
+  const g = GUIDE();
+  assert.match(g, /Staff\+/, 'METHODOLOGY_GUIDE.md never explains the level buckets (Entry, Mid, Senior, Staff+, Manager, Director+, Intern)');
+  assert.match(g, /Level not stated/, 'METHODOLOGY_GUIDE.md never says what "Level not stated" means');
+});
+test('MR-41 the "Mid" chip\'s example does not contradict Amazon\'s ladder ("III" is Senior at Amazon)', todo('MR-41'), () => {
+  const line = read('public/app.js').split('\n').find((l) => /^\s*Mid: 'A mid level the posting names/.test(l));
+  if (!line) return; // reworded
+  assert.doesNotMatch(line, /“III”/, 'SEN_TIP.Mid gives "III" as a mid level; server/keywords.js AMAZON_RUNG makes Amazon\'s III Senior');
+});
