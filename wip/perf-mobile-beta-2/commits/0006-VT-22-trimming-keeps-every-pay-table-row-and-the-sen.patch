From 161a472bb6229ae2975013f2ad8739f9e089ff0a Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 11 Oct 2026 22:47:45 +0000
Subject: [PATCH 06/15] VT-22: trimming keeps every pay-table row and the
 sentence above it (fix5-data's patch, applied); VT-22 test un-todo'd

No trimming drops a posting or a pay row (the user's no-cut rule).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 scripts/snapshot.js         | 17 +++++++++++++++--
 test/beta-vetting-2.test.js |  2 +-
 2 files changed, 16 insertions(+), 3 deletions(-)

diff --git a/scripts/snapshot.js b/scripts/snapshot.js
index 681204b..ac053a7 100644
--- a/scripts/snapshot.js
+++ b/scripts/snapshot.js
@@ -37,7 +37,14 @@ export const MAX_BETA_SNAPSHOT_BYTES = 40 * 1024 * 1024;
 const TRIM_STEPS = [6000, 4000, 2500, 1500, 800];
 const PAY_HINT_RE = /salary|base pay|pay range|range for this role|compensation|\$\s?\d|\d\s?(?:USD|CAD|GBP|EUR)\b/i;
 
-/** First `n` characters of an HTML description (cut at a tag boundary) plus its pay paragraphs. */
+// VT-22 (fix wave 5, fix5-data): one row of a per-place pay table ("USA, TX, Wink - 30.91 - 54.18 USD
+// hourly", server/sources/amazon.js PAY_LINE_RE). Every row is kept, so the stored text still holds the
+// pay the site shows for each place; the sentence above the table (a minimum, a shift differential) is
+// one of the pay paragraphs.
+const PAY_ROW_RE = /\s-\s+\d[\d,]*(?:\.\d+)?(?:\s*-\s*\d[\d,]*(?:\.\d+)?)?\s+[A-Z]{3}\s+(?:annually|hourly|monthly|weekly|per year|per hour|per month)\s*(?:<|$)/i;
+const PAY_SENTENCE_RE = /\bminimum\s+(?:gross\s+)?(?:basic\s+|base\s+)?(?:pay\s+)?salary\b|\bshift\s+differential\b|\bpay\s+starts\s+at\b|\bstarting\s+pay\b|\bgross\s+annually\b/i;
+
+/** First `n` characters of an HTML description (cut at a tag boundary) plus its pay paragraphs and every pay-table row. */
 export function trimDescription(html, n) {
   const s = String(html || '');
   if (s.length <= n) return s;
@@ -45,7 +52,13 @@ export function trimDescription(html, n) {
   if (cut < n * 0.6) cut = n;
   const head = s.slice(0, cut);
   const chunks = s.slice(cut).split(/(?=<(?:p|li|div|h[1-6]|br)\b)/i);
-  const pay = chunks.filter((c) => PAY_HINT_RE.test(c) && c.length < 3000).slice(0, 4).join('');
+  // In page order: every table row, every sentence that says what the figures are, and up to 4 other pay paragraphs.
+  let others = 0;
+  const pay = chunks.filter((c) => {
+    if (c.length >= 3000) return false;
+    if (PAY_ROW_RE.test(c) || PAY_SENTENCE_RE.test(c)) return true;
+    return PAY_HINT_RE.test(c) && others++ < 4;
+  }).join('');
   return `${head}<p>[…] Full description on the posting page.</p>${pay}`;
 }
 
diff --git a/test/beta-vetting-2.test.js b/test/beta-vetting-2.test.js
index 5105810..2a54dbe 100644
--- a/test/beta-vetting-2.test.js
+++ b/test/beta-vetting-2.test.js
@@ -164,7 +164,7 @@ test('VT-21 a team name with "CEO" or a "Chief Engineer" facilities role is not
 // text, so the drawer's description does not contain the pay it shows and a re-derivation or a
 // reviewer cannot find it (amazon:10566737 "Data Center Technician": "USA, TX, Wink - 30.91 - 54.18
 // USD hourly" is cut after the three Mississippi rows). Owner: scripts/snapshot.js trimDescription.
-test('VT-22 trimming a description keeps every row of its pay table', TODO, () => {
+test('VT-22 trimming a description keeps every row of its pay table', () => {
   const rows = ['USA, MS, Canton - 27.83 - 48.75 USD hourly', 'USA, MS, Vickburg - 27.83 - 48.75 USD hourly', 'USA, MS, Vicksburg - 27.83 - 48.75 USD hourly', 'USA, TX, Wink - 30.91 - 54.18 USD hourly'];
   const html = `<p>${'Data center work. '.repeat(300)}</p><p>The base salary range for this position is listed below.</p>${rows.map((r) => `<p>${r}</p>`).join('')}`;
   const cut = trimDescription(html, 4000);
