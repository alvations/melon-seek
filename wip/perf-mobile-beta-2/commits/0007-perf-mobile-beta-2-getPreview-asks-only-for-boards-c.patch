From ad8964793469487832ca5ade8198662f246df515 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 16:42:51 +0000
Subject: [PATCH 07/12] perf-mobile-beta-2: getPreview asks only for boards
 config.js lists (window.MELON_PREVIEWS), so small boards make no 404 request

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 .../process/scripts/perf-mobile-beta-2-equal-check.mjs |  3 +++
 public/api.js                                          |  1 +
 scripts/build-static.js                                |  4 +++-
 test/perf-mobile-beta-2.test.js                        | 10 +++++++++-
 4 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/docs/process/scripts/perf-mobile-beta-2-equal-check.mjs b/docs/process/scripts/perf-mobile-beta-2-equal-check.mjs
index 6e2ee7a..7835b53 100644
--- a/docs/process/scripts/perf-mobile-beta-2-equal-check.mjs
+++ b/docs/process/scripts/perf-mobile-beta-2-equal-check.mjs
@@ -14,6 +14,9 @@ let n = 0;
 async function load(site, apiFile) {
   globalThis.MELON_STATIC = true;
   globalThis.MELON_LIVE_SOURCES = [];
+  // config.js's list of boards with a first-page preview (build-static.js#previewPreloadJs)
+  const pdir = path.join(site, 'api', 'preview');
+  globalThis.MELON_PREVIEWS = fs.existsSync(pdir) ? fs.readdirSync(pdir).map((f) => f.replace(/\.json$/, '')) : [];
   globalThis.fetch = async (url) => {
     const u = String(url);
     if (/^[a-z]+:\/\//i.test(u)) throw new TypeError('Failed to fetch');
diff --git a/public/api.js b/public/api.js
index 6b635d2..55afcde 100644
--- a/public/api.js
+++ b/public/api.js
@@ -929,6 +929,7 @@ export async function getPreview(params, { signal } = {}) {
   const p = toParams(params);
   if (!p.company || p.source || p.board) return null;
   const slug = String(p.company).toLowerCase();
+  if (!Array.isArray(g.MELON_PREVIEWS) || !g.MELON_PREVIEWS.includes(slug)) return null; // config.js lists the boards that have one
   const listPath = `api/jobs/${encodeURIComponent(slug)}.json`;
   if (bundleCache.has(listPath) || memCache.has(slug)) return null; // the list is in memory: no wait to cover
   const path = `api/preview/${encodeURIComponent(slug)}.json`;
diff --git a/scripts/build-static.js b/scripts/build-static.js
index 7231ab3..3165ee7 100644
--- a/scripts/build-static.js
+++ b/scripts/build-static.js
@@ -542,7 +542,9 @@ export function listPreloadJs(slugs, lastKey, first = slugs[0]) {
  * `previewSlugs`: the companies with an api/preview/<slug>.json.
  */
 export function previewPreloadJs(previewSlugs, slugs, lastKey, first = slugs[0]) {
-  return `// Preload the first company's preview (scripts/build-static.js#previewPreloadJs; docs/process/perf-mobile-beta-2.md).
+  return `// The companies with a first-page preview, and the first one's early fetch (scripts/build-static.js#previewPreloadJs;
+// docs/process/perf-mobile-beta-2.md). api.js#getPreview asks only for these.
+window.MELON_PREVIEWS = ${JSON.stringify(previewSlugs)};
 (function (previewSlugs, slugs, lastKey, first) {
   ${OPENING_COMPANY_JS}
   ${EARLY_FETCH_JS}
diff --git a/test/perf-mobile-beta-2.test.js b/test/perf-mobile-beta-2.test.js
index a945182..f0e4df9 100644
--- a/test/perf-mobile-beta-2.test.js
+++ b/test/perf-mobile-beta-2.test.js
@@ -54,6 +54,7 @@ after(() => {
 });
 
 let n = 0;
+const fetched = []; // every URL the stand-in fetch() was asked for
 /** The built api.js, with fetch() served from the site's files plus `extra` { path: body }. */
 async function siteApi(extra = {}) {
   globalThis.MELON_STATIC = true;
@@ -61,6 +62,7 @@ async function siteApi(extra = {}) {
   globalThis.fetch = async (url) => {
     const u = String(url).split(/[?#]/)[0];
     if (/^[a-z]+:\/\//i.test(u)) throw new TypeError('Failed to fetch');
+    fetched.push(u);
     if (u in extra) return new Response(JSON.stringify(extra[u]), { status: 200, headers: { 'content-type': 'application/json' } });
     const file = path.join(DIST, decodeURIComponent(u));
     if (!file.startsWith(DIST) || !fs.existsSync(file) || fs.statSync(file).isDirectory()) return new Response('{"error":"Not found"}', { status: 404 });
@@ -276,6 +278,7 @@ test('the preview holds the list\'s own postings, and getPreview gives them as g
   assert.deepEqual(prev.preview.colorCounts, [...counts]);
   const companies = [...readJson(DIST, 'api', 'companies.json'), { slug: 'zz', name: 'Zz', source: 'amazon', board: 'zz', color: '#ff9900', live: false }];
   const api = await siteApi({ 'api/companies.json': companies, 'api/jobs/zz.json': rt(split.list), 'api/preview/zz.json': rt(prev) });
+  globalThis.MELON_PREVIEWS = ['zz', 'anthropic']; // config.js lists the boards with a preview
   const p = await api.getPreview('zz');
   const res = await api.getJobs('zz');
   const byId = new Map(res.jobs.map((j) => [j.id, j]));
@@ -286,7 +289,12 @@ test('the preview holds the list\'s own postings, and getPreview gives them as g
   // No preview once the list is in memory, for an unknown slug, or when there is no file.
   assert.equal(await api.getPreview('zz'), null);
   assert.equal(await api.getPreview('nope'), null);
-  assert.equal(await api.getPreview('anthropic'), null);
+  assert.equal(await api.getPreview('anthropic'), null, 'listed but no file: null');
+  globalThis.MELON_PREVIEWS = [];
+  fetched.length = 0;
+  assert.equal(await api.getPreview('anduril'), null);
+  assert.ok(!fetched.some((u) => u.includes('api/preview/')), 'a board config.js does not list is never asked for (no 404s)');
+  delete globalThis.MELON_PREVIEWS;
   // A small board gets none.
   assert.equal(previewList(splitPayload({ ...board, jobs: board.jobs.slice(0, 300) }, api0, vetSalaries), api0), null);
 });
