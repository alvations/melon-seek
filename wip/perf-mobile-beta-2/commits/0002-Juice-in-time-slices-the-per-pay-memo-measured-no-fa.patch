++// readableTitle is pure and runs once per posting in app.js#prepare, before the first card: about
++// 0.3 s at 4x CPU for Amazon's 22,415 postings, whose titles repeat (docs/process/perf-mobile-beta-2.md).
++// Results are memoized like expandTitle's.
++const READABLE = new Map();
++
+ /**
+  * Title for display: role abbreviations written out, and a "(FDE)" that only repeats the words
+  * before it ("Forward Deployed Engineer (FDE)") dropped. The posted title is kept by the caller.
+@@ -131,6 +136,15 @@
+  * @returns {string}
+  */
+ export function readableTitle(title) {
++  const key = String(title || '');
++  let t = READABLE.get(key);
++  if (t === undefined) {
++    if (READABLE.size >= EXPANDED_MAX) READABLE.clear();
++    READABLE.set(key, (t = readable(key)));
++  }
++  return t;
++}
++function readable(title) {
+   // UX-32: a list number left at the front of a posted title ("8. Mixed Signal Design Engineer") is not part
+   // of the role's name; the drawer still shows the posted title ("Posted as …").
+   let t = String(title || '').replace(/^\s*\d{1,2}[.)]\s+(?=[A-Za-z])/, '');
diff --git a/docs/process/scripts/perf-mobile-beta-2-title-check.mjs b/docs/process/scripts/perf-mobile-beta-2-title-check.mjs
new file mode 100644
