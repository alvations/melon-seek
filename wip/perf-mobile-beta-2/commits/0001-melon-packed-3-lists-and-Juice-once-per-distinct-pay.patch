+const hasSections = (s) => !!s && ((s.responsibilities || []).length > 0 || (s.fit || []).length > 0);
+function commonPrefix(strs) {
+  if (!strs.length) return '';
+  let p = strs[0];
+  for (const s of strs) { while (!s.startsWith(p)) p = p.slice(0, -1); if (!p) break; }
+  return p;
