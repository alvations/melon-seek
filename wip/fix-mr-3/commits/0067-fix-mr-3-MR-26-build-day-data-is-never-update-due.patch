From 0412b39e2c84c72b63dcc7df237f048f273a170e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 13:35:21 +0000
Subject: [PATCH 67/81] fix-mr-3: MR-26 build-day data is never "update due"

lib.js isPipelineEntry/shownOverdue: a daily entry (the postings) is the pipeline's own data, read by the build
that shows it. One rule for run.js (stalenessRows, genericResult), the methodology's sources table
(loadFigureInputs) and api/freshness.json (publicFreshness: stale false, no staleAfter).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 scripts/methodology-figures.js |  5 +++--
 scripts/refresh/derived.js     |  8 +++++---
 scripts/refresh/lib.js         | 12 ++++++++++++
 scripts/refresh/run.js         |  6 +++---
 4 files changed, 23 insertions(+), 8 deletions(-)

diff --git a/scripts/methodology-figures.js b/scripts/methodology-figures.js
index a19f37b..1999edf 100644
--- a/scripts/methodology-figures.js
+++ b/scripts/methodology-figures.js
@@ -579,11 +579,12 @@ export async function loadFigureInputs(root, { citiesFile = null } = {}) {
   try { freshness = JSON.parse(await readFile(path.join(root, 'data', 'freshness.json'), 'utf8')); } catch { freshness = null; }
   if (freshness && Array.isArray(freshness.entries)) {
     // The sources table's "update due": staleness at the build time (MELON_BUILT_AT pins it), as api/freshness.json.
+    // MR-26: never for a daily pipeline entry (the postings), which the build itself has just read (lib.js shownOverdue).
     try {
-      const { staleness } = await import(pathToFileURL(path.join(root, 'scripts', 'refresh', 'lib.js')).href);
+      const { shownOverdue } = await import(pathToFileURL(path.join(root, 'scripts', 'refresh', 'lib.js')).href);
       const t = Date.parse(process.env.MELON_BUILT_AT || '');
       const now = Number.isFinite(t) ? new Date(t) : new Date();
-      freshness = { ...freshness, entries: freshness.entries.map((e) => (e && e.id && !e.retired ? { ...e, stale: !!staleness(e, now).overdue } : e)) };
+      freshness = { ...freshness, entries: freshness.entries.map((e) => (e && e.id && !e.retired ? { ...e, stale: shownOverdue(e, now) } : e)) };
     } catch { /* no refresh lib: no status column */ }
   }
   return { juice, cities, freshness };
diff --git a/scripts/refresh/derived.js b/scripts/refresh/derived.js
index 65e2daf..33ad10e 100644
--- a/scripts/refresh/derived.js
+++ b/scripts/refresh/derived.js
@@ -40,7 +40,7 @@ import os from 'node:os';
 import path from 'node:path';
 import crypto from 'node:crypto';
 import { fileURLToPath, pathToFileURL } from 'node:url';
-import { result, errorResult, staleness, isoDate, addDays, extractConst, ROOT } from './lib.js';
+import { result, errorResult, staleness, isPipelineEntry, isoDate, addDays, extractConst, ROOT } from './lib.js';
 import * as EX from './examples.js';
 
 export const MODULE = Object.freeze({
@@ -632,8 +632,10 @@ export function publicFreshness(registry, { now = new Date() } = {}) {
     out.source = e.source ? { name: e.source.name || null, url: e.source.url || null } : null;
     out.cadence = e.cadence || null;
     out.lastChecked = e.lastChecked || null;
-    out.stale = !!s.overdue;
-    out.staleAfter = s.dueInDays == null ? null : isoDate(addDays(now, s.dueInDays));
+    // MR-26: a daily pipeline entry (the postings) is as fresh as the build that read it: never stale, no staleAfter.
+    const pipeline = isPipelineEntry(e);
+    out.stale = !pipeline && !!s.overdue;
+    out.staleAfter = pipeline || s.dueInDays == null ? null : isoDate(addDays(now, s.dueInDays));
     return out;
   });
   // Always a document (entries [] without a registry): the site fetches it, and a 404 would be a console error.
diff --git a/scripts/refresh/lib.js b/scripts/refresh/lib.js
index 9b417cb..c01fc22 100644
--- a/scripts/refresh/lib.js
+++ b/scripts/refresh/lib.js
@@ -114,6 +114,18 @@ export function staleness(entry, now = new Date()) {
   return { ageDays: asOfAge, checkedDays: checkedAge, reviewedDays: reviewedAge, dueInDays, reviewDueInDays, dueReason, overdue: dueInDays != null && dueInDays < 0, cadenceDays, graceDays };
 }
 
+/**
+ * MR-26 (fix-mr-3): a daily entry is the job pipeline's own data. snapshot.yml crawls the boards and pages.yml builds
+ * the site from that crawl, so a page is never built from postings older than its build, whatever the entry's
+ * hand-set asOf says. run.js reports such an entry as 'pipeline', and nothing the site shows (the methodology's
+ * sources table, api/freshness.json) calls it "update due".
+ */
+export const isPipelineEntry = (entry) => !!entry && entry.cadence === 'daily';
+/** Past due at `now` as the site says it: staleness(entry).overdue, and never for a pipeline entry (MR-26). */
+export function shownOverdue(entry, now = new Date()) {
+  return !isPipelineEntry(entry) && !!staleness(entry, now).overdue;
+}
+
 // ---------------------------------------------------------------- text and numbers
 
 const ENT = { amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", nbsp: ' ', euro: '€', pound: '£', yen: '¥', ndash: '–', mdash: '—', rsquo: '’', lsquo: '‘', ldquo: '“', rdquo: '”', hellip: '…', middot: '·', times: '×', shy: '', minus: '−', thinsp: ' ', ensp: ' ', emsp: ' ' };
diff --git a/scripts/refresh/run.js b/scripts/refresh/run.js
index c1bf1e6..ee56d24 100644
--- a/scripts/refresh/run.js
+++ b/scripts/refresh/run.js
@@ -36,7 +36,7 @@ import path from 'node:path';
 import { execFileSync } from 'node:child_process';
