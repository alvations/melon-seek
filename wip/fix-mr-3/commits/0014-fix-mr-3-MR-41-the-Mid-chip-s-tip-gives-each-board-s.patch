From 63caf685edc8079c35243e8349cc51fa31510202 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 13:36:37 +0000
Subject: [PATCH 14/29] fix-mr-3: MR-41 the Mid chip's tip gives each board's
 own example of a mid level

Amazon III is Senior and Google II is Entry, so MID_EXAMPLE names one per board (Google III, Amazon II,
Microsoft IC3, NVIDIA Level 2, Netflix L4, else II or L4); the test reads each through jobSeniority.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 public/app.js         | 10 +++++++++-
 test/fix-mr-3.test.js |  5 +++--
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/public/app.js b/public/app.js
index f90ff40..6708e32 100644
--- a/public/app.js
+++ b/public/app.js
@@ -79,10 +79,18 @@ const SENIORITY_ORDER = ['Intern', 'Entry', 'Mid', 'Senior', 'Staff+', 'Manager'
 const SENIORITY_SHOWN = DISPLAY_LEVEL_ORDER;
 const senKey = (j) => displayLevel(j);
 const senLabel = (k) => levelLabel(k);
+/**
+ * MR-41 (fix-mr-3): a mid level each board names, read on its own ladder (server/keywords.js): Amazon's "III" is
+ * Senior and Google's "II" is Entry, so no one numeral holds on every board. Microsoft and NVIDIA name the level in
+ * the pay sentence ("IC3 - The typical base pay range …", "… for Level 2"). test/fix-mr-3.test.js reads each one
+ * through jobSeniority.
+ */
+const MID_EXAMPLE = Object.freeze({ google: 'III', amazon: 'II', microsoft: 'IC3', nvidia: 'Level 2', netflix: 'L4', other: ['II', 'L4'] });
+const midTip = () => `A mid level the posting names (for example ${[].concat(MID_EXAMPLE[data?.company?.slug] || MID_EXAMPLE.other).map((x) => `“${x}”`).join(' or ')})`;
 const SEN_TIP = {
   'Staff+': 'Staff, principal or distinguished level',
   'Director+': 'Director, head of, vice president or chief',
-  Mid: 'A mid level the posting names (for example “III” or “L4”)',
+  get Mid() { return midTip(); },
   [NOT_STATED]: 'The posting’s title names no level',
 };
 /* The Seniority filter in the link (s=, roles.js levelKey): "Level not stated" keeps its old value 'Mid', so
diff --git a/test/fix-mr-3.test.js b/test/fix-mr-3.test.js
index b3b33a7..89a804c 100644
--- a/test/fix-mr-3.test.js
+++ b/test/fix-mr-3.test.js
@@ -86,9 +86,10 @@ test('MR-41 the Mid tip\'s example is a mid level on every board\'s own ladder',
       assert.deepEqual([got.level, got.basis === 'default' ? 'default' : 'stated'], ['Mid', 'stated'], `${slug}: the tip's example “${ex}” reads ${got.level} (${got.basis})`);
     }
   }
-  const tipLine = APP.split('\n').find((l) => /\bMid: /.test(l) && /mid level the posting names/.test(l));
+  const tipLine = APP.split('\n').find((l) => /mid level the posting names/.test(l) && !/^\s*(?:\/\/|\*)/.test(l));
   assert.ok(tipLine, 'public/app.js: no Mid tip (update this test)');
-  assert.doesNotMatch(tipLine, /“III” or “L4”/, 'the Mid tip still names “III”, which is Senior at Amazon');
+  assert.doesNotMatch(tipLine, /“III”/, 'the Mid tip still names “III” on every board, which is Senior at Amazon');
+  assert.match(tipLine, /MID_EXAMPLE/, 'the Mid tip does not use the board\'s own example');
 });
 
 /* ------------------------------------------------------------- MR-40 */
