From 9fa0ab2f66dfad0ad9946c562e0bb76300e01afb Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 13:06:49 +0000
Subject: [PATCH 25/81] e2e: relaunch the browser when it dies mid-run;
 fix-density's one-row legend rule is for phones only (D-51)

Twice a full run's Chromium closed near test 750 (2026-10-17), and every later test failed on
"browser has been closed". The harness now calls ctx.ensureBrowser() before each test; scripts/e2e.js
relaunches a closed browser and reports how often. fix-density's 1440 check asked for a one-row Ranges
legend; D-51 (desktop QA round 4, fix-viz-5) makes it wrap from 861 px up, so the one-row rule is the
phones' only.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 scripts/e2e.js              | 11 ++++++++++-
 test/e2e/fix-density.e2e.js |  4 +++-
 test/e2e/harness.js         |  3 +++
 3 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/scripts/e2e.js b/scripts/e2e.js
index a615e70..c40b6ac 100644
--- a/scripts/e2e.js
+++ b/scripts/e2e.js
@@ -71,10 +71,18 @@ const ctx = { baseUrl: server.baseUrl, data: {}, notes: [], cleanup: [], pw, bro
 registerApiTests(suite);
 
 let browser = null;
+let relaunches = 0;
 if (!apiOnly) {
   const executablePath = findChromium();
-  browser = await pw.chromium.launch({ headless: !args.has('--headed'), executablePath });
+  const launch = () => pw.chromium.launch({ headless: !args.has('--headed'), executablePath });
+  browser = await launch();
   ctx.browser = browser;
+  ctx.ensureBrowser = async () => {
+    if (ctx.browser.isConnected()) return;
+    relaunches += 1;
+    console.log(`  ! the browser closed; relaunching it (${relaunches})`);
+    browser = ctx.browser = await launch();
+  };
   console.log(`e2e: playwright ${playwrightInfo.path}`);
   console.log(`e2e: chromium ${browser.version()} (${executablePath || 'playwright default'})`);
   registerUiTests(suite);
@@ -127,6 +135,7 @@ try {
   await server.stop();
 }
 const failed = results.filter((r) => !r.ok);
+if (relaunches) console.log(`e2e: the browser was relaunched ${relaunches} time(s) after closing`);
 if (ctx.notes.length) {
   console.log('\ne2e notes (non-fatal observations):');
   for (const n of [...new Set(ctx.notes)]) console.log(`  * ${n}`);
diff --git a/test/e2e/fix-density.e2e.js b/test/e2e/fix-density.e2e.js
index ec9ed18..e9b2b36 100644
--- a/test/e2e/fix-density.e2e.js
+++ b/test/e2e/fix-density.e2e.js
@@ -157,7 +157,9 @@ export function registerFixDensityTests(suite) {
         await go(p, `${base}#c=${slug}&v=ranges`);
         check(await measure(p, '#chartHost .ms-chart__foot'), bad, 'ranges');
         const legend = await p.evaluate(() => { const l = document.querySelector('#chartHost .ms-chart__legend'); if (!l || l.hidden) return null; const b = l.getBoundingClientRect(); return { h: Math.round(b.height), scrolls: l.scrollWidth > l.clientWidth + 1, tab: l.tabIndex }; });
-        if (legend && legend.h > 26) bad.push(`ranges legend: ${legend.h}px tall, more than one row`);
+        // D-51 (desktop QA round 4, fix-viz-5): from 861 px up the legend wraps so every key shows without a hidden
+        // sideways scroll; one row is the phone rule only.
+        if (legend && legend.h > 26 && phone) bad.push(`ranges legend: ${legend.h}px tall, more than one row`);
         if (legend && legend.scrolls && legend.tab !== 0) bad.push('ranges legend: scrolls sideways but cannot take keyboard focus');
         // Map: the Pay legend's note.
         await go(p, `${base}#c=${slug}&m=map`, 1800);
diff --git a/test/e2e/harness.js b/test/e2e/harness.js
index 849d421..c2afc28 100644
--- a/test/e2e/harness.js
+++ b/test/e2e/harness.js
@@ -153,6 +153,9 @@ export function createSuite() {
       try {
         for (const t of tests) {
           if (grep && !grep.test(t.name)) continue;
+          // A browser that died in an earlier test (it did twice near test 750 of a full run, 2026-10-17)
+          // is relaunched here, so one crash fails one test, not every test after it.
+          if (ctx.ensureBrowser) await ctx.ensureBrowser();
           const start = Date.now();
           current = { stray: [] };
           let timer;
