     const near = (a, b) => Math.abs(a - b) <= Math.max(1000, b * 0.01);
-    assert(shown && near(shown[0], lo) && near(shown[1], hi),
-      `${j.id} "${j.title}" is listed in ${j.locations.map((l) => l.name).join(' and ')}, whose rows span $${Math.round(lo / 1000)}K–${Math.round(hi / 1000)}K, but the card reads "${pill}": it includes ${none.map((r) => `"${r.label}" $${Math.round(r.min / 1000)}K–${Math.round((r.max ?? r.min) / 1000)}K`).join(' and ')}, rows tied to no place the posting lists (${found.length} such postings)`);
+    assert(shown && near(shown[0], alo) && near(shown[1], ahi), `${j.id}: the card reads "${pill}", not the span of every posted row ($${Math.round(alo / 1000)}K–${Math.round(ahi / 1000)}K)`);
