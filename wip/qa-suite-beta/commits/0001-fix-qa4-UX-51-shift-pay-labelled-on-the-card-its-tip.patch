+  if (sr.upTo) return `up to ${one(sr.hi)}`;
+  return hourly ? `${postedPair(sr.lo / 2080, sr.hi / 2080, s.currency)}${per}` : moneyRange(sr.lo, sr.hi, s.currency);
+}
