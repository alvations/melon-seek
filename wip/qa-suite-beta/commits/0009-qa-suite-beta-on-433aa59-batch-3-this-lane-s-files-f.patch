+    const sorted = await page.evaluate((t) => t.slice().sort((a, b) => a.localeCompare(b)), titles);
+    if (JSON.stringify(titles) !== JSON.stringify(sorted)) bad.push(`title: "${titles.find((t, i) => t !== sorted[i])}" is out of order`);
+  }
+
