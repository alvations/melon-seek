From 925a582a9537d55db220eee6cf47fb23d6450559 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 14:33:32 +0000
Subject: [PATCH 13/13] qa-suite-beta: e2e header IDs; CI e2e job gets a 240 s
 per-test limit for a cold cache

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 docs/process/patches/qa-suite-beta-ci-e2e.diff | 7 +++++--
 test/e2e/beta-coverage.e2e.js                  | 4 ++--
 2 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/docs/process/patches/qa-suite-beta-ci-e2e.diff b/docs/process/patches/qa-suite-beta-ci-e2e.diff
index 5f24dbe..504c568 100644
--- a/docs/process/patches/qa-suite-beta-ci-e2e.diff
+++ b/docs/process/patches/qa-suite-beta-ci-e2e.diff
@@ -66,10 +66,10 @@ index 0000000..4915453
 +process.exit(unexpected.length || unfinished.length || stale.length ? 1 : 0);
 diff --git a/.github/workflows/e2e.yml b/.github/workflows/e2e.yml
 new file mode 100644
-index 0000000..0d38a17
+index 0000000..c1b93f2
 --- /dev/null
 +++ b/.github/workflows/e2e.yml
-@@ -0,0 +1,116 @@
+@@ -0,0 +1,119 @@
 +name: E2E suite (sharded)
 +
 +# The full browser suite (node scripts/e2e.js, about 900 tests and 2 hours on one machine) ran nowhere in CI until
@@ -153,6 +153,9 @@ index 0000000..0d38a17
 +      - name: node scripts/e2e.js --shard=${{ matrix.shard }}/4
 +        env:
 +          NODE_PATH: ${{ github.workspace }}/node_modules
++          # A fresh runner has a cold data/cache: the server re-normalizes every board the crawl stored at an older
++          # normalizer version (D-20 took 101 s of the default 120 s on a cold cache, qa-suite-beta section 6).
++          E2E_TEST_TIMEOUT: '240000'
 +        run: |
 +          set -o pipefail
 +          timings=""; [ -f test/e2e/timings.log ] && timings="--timings=test/e2e/timings.log"
diff --git a/test/e2e/beta-coverage.e2e.js b/test/e2e/beta-coverage.e2e.js
index 3fc7ea4..3594c8c 100644
--- a/test/e2e/beta-coverage.e2e.js
+++ b/test/e2e/beta-coverage.e2e.js
@@ -5,8 +5,8 @@
 //   - every beta board (from the registry, so a board added later is covered) is in the build, and its count on
 //     screen equals its list and its CSV: a board the build dropped fails here instead of skipping everywhere [T-5];
 //   - Apply on every board, Amazon and Meta included, goes to the posting on that company's own host [T-1];
-//   - the pay filter (minimum, maximum, "only with pay") on every board [T-2];
-//   - the sorts (Highest pay, Lowest pay, Title A–Z) on every board [T-3];
+//   - per board: the pay filter (minimum, maximum, "only with pay") [T-2], the Listed filter and the Juice grades
+//     [T-16], and every sort (Highest pay, Lowest pay, Most juice, Title A–Z) [T-3];
 //   - search lists title matches first on the big boards [T-6];
 //   - a deep link survives a reload, and Back / Forward walk the filter history, on Amazon [T-7];
 //   - at every size in phone-sizes.mjs, the phone flow a job seeker uses: the list opens full, a tapped card opens
-- 
