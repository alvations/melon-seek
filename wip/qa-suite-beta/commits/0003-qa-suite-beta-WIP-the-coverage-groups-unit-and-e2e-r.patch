+  suite.test('Beta coverage: the pay filter on every big-tech board shows exactly the roles whose approx-USD pay meets it (minimum, maximum, "only with pay")', async (ctx) => {
+    const { page, errors, base } = await open(ctx, { hash: `c=${BETA[0].slug}` });
