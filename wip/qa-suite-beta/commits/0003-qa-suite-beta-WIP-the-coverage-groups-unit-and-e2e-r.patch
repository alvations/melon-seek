+// Test-suite QA for the beta site (docs/process/qa-suite-beta.md, 2026-10-23): checks that the suites cover what they
+// say they cover. Tests named [T-n] encode a gap in the suites themselves; each is a `todo` until the owning test file
+// or scripts/e2e.js is fixed (docs/process/patches/qa-suite-beta-*.diff), so it shows in `npm test` without turning CI
+// red. The rest are guards that pass today. Nothing here needs data or a browser; the one data check skips without
+// both the beta snapshots and a beta build.
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+
+const ROOT = path.join(path.dirname(fileURLToPath(import.meta.url)), '..');
+const read = (...p) => fs.readFileSync(path.join(ROOT, ...p), 'utf8');
+const E2E = path.join(ROOT, 'test', 'e2e');
+const e2eFiles = () => fs.readdirSync(E2E).filter((f) => f.endsWith('.e2e.js')).sort();
+const todo = (id) => ({ todo: `${id}: docs/process/qa-suite-beta.md` });
+
+const { listCompanies } = await import(pathToFileURL(path.join(ROOT, 'server', 'companies.js')).href);
+/** The boards the beta site shows: the registry's non-paused beta companies. */
+const BETA = listCompanies({ channel: 'beta' }).filter((c) => c.channel === 'beta').map((c) => c.slug).sort();
+
+/** Files run on their own (a CLI, a WebKit job), never through scripts/e2e.js. Each needs its reason. */
+const STANDALONE = {
+  // (none today: links.e2e.js says "Register from scripts/e2e.js", and is not; see [T-4])
+};
+
+test('beta-coverage: the registry has the seven big-tech boards the brief names, none paused', () => {
+  assert.deepEqual(BETA, ['amazon', 'apple', 'google', 'meta', 'microsoft', 'netflix', 'nvidia']);
+});
+
+test('beta-coverage: every registered e2e group is imported from a file that exists (scripts/e2e.js)', () => {
+  const src = read('scripts', 'e2e.js');
+  const imports = [...src.matchAll(/import \{ (\w+) \} from '\.\.\/test\/e2e\/([\w.-]+\.js)';/g)];
+  assert.ok(imports.length > 30, `only ${imports.length} imports found: the pattern no longer matches scripts/e2e.js`);
+  for (const [, fn, file] of imports) {
+    assert.ok(fs.existsSync(path.join(E2E, file)), `${file} is imported but missing`);
+    if (fn === 'createSuite') continue;
+    assert.match(read('test', 'e2e', file), new RegExp(`export function ${fn}\\b`), `${file} exports no ${fn}`);
+    if (/^register/.test(fn)) assert.match(src, new RegExp(`\\b${fn}\\(suite\\)`), `${fn} is imported but never called`);
+  }
+});
+
+test('[T-4] every e2e file with a register function runs in the full suite (links.e2e.js never does)', todo('T-4'), () => {
+  const src = read('scripts', 'e2e.js');
+  const missing = [];
+  for (const f of e2eFiles()) {
+    const fns = [...read('test', 'e2e', f).matchAll(/export function (register\w+)\(/g)].map((m) => m[1]);
+    if (!fns.length || STANDALONE[f]) continue;
+    for (const fn of fns) if (!new RegExp(`\\b${fn}\\(suite\\)`).test(src)) missing.push(`${f} ${fn}`);
+  }
+  assert.deepEqual(missing, [], `never run by node scripts/e2e.js: ${missing.join(', ')}`);
+});
+
+/**
+ * Arrays and objects in the e2e files that list big-tech boards: `const NAME = [...]` / `{ slug: ... }` holding at least
+ * four of the seven slugs. A list that holds four or more means "the big-tech boards"; it must hold all seven, or a
+ * board added later (Amazon and Meta, 2026-10-11) is never tested by it.
+ */
+function boardLists() {
+  const out = [];
+  for (const f of e2eFiles()) {
+    const src = read('test', 'e2e', f);
+    for (const m of src.matchAll(/const (\w+) = (\[[^\]\n]*\]|\{[^}\n]*\})/g)) {
+      const slugs = [...new Set([...m[2].matchAll(/['"]?\b(amazon|apple|google|meta|microsoft|netflix|nvidia)\b['"]?\s*[:,\]}'"]/g)].map((x) => x[1]))];
+      if (slugs.length >= 4) out.push({ file: f, name: m[1], slugs });
+    }
+  }
+  return out;
+}
+
+test('beta-coverage: the e2e files still declare their board lists the way this check reads them', () => {
+  const lists = boardLists();
+  assert.ok(lists.length >= 6, `found ${lists.length} board lists: ${lists.map((l) => `${l.file} ${l.name}`).join(', ')}`);
+  assert.ok(lists.some((l) => l.file === 'fix-phone-text.e2e.js' && l.slugs.length === 7), 'fix-phone-text.e2e.js BOARDS (all seven) not found');
+});
+
+test('[T-1] every e2e list of "the big-tech boards" names all seven (Amazon and Meta are missing from three)', todo('T-1'), () => {
+  const short = boardLists().filter((l) => BETA.some((s) => !l.slugs.includes(s)))
+    .map((l) => `${l.file} ${l.name} lacks ${BETA.filter((s) => !l.slugs.includes(s)).join(', ')}`);
+  assert.deepEqual(short, [], short.join('; '));
+});
+
+test('beta-coverage: the WebKit phone smoke and the Chromium phone matrix name every beta board or read the registry', () => {
+  const wf = read('.github', 'workflows', 'webkit-phone.yml');
+  const m = /phone-smoke\.mjs[^\n]*--boards ([\w,]+)/.exec(wf);
+  assert.ok(m, 'webkit-phone.yml runs phone-smoke.mjs with --boards');
+  assert.deepEqual(m[1].split(',').sort(), BETA, 'the WebKit phone smoke boards');
+});
+
+test('beta-coverage: phone-sizes.mjs lists 21 distinct sizes, each a touch phone with a viewport, DPR and user agent', async () => {
+  const { ALL_SIZES, contextFor } = await import(pathToFileURL(path.join(E2E, 'phone-sizes.mjs')).href);
+  assert.ok(ALL_SIZES.length >= 19, `${ALL_SIZES.length} sizes`);
+  const keys = ALL_SIZES.map((d) => `${d.name} ${d.width}x${d.height}`);
+  assert.equal(new Set(keys).size, keys.length, 'sizes are distinct');
+  assert.equal(new Set(ALL_SIZES.map((d) => d.name)).size, ALL_SIZES.length, 'names are distinct (tests are named by them)');
+  for (const d of ALL_SIZES) {
+    const o = contextFor(d);
+    assert.ok(o.viewport.width >= 280 && o.viewport.height >= 300 && o.deviceScaleFactor >= 1 && o.hasTouch && o.isMobile, d.name);
+    assert.match(o.userAgent, /iPhone|Android/, d.name);
+  }
+  assert.ok(ALL_SIZES.some((d) => d.width === 280), 'the folded Fold (280 px)');
+  assert.ok(ALL_SIZES.some((d) => d.width === 352 && d.height === 355), 'the Razr cover screen');
+  assert.ok(ALL_SIZES.some((d) => d.width > d.height), 'a landscape posture');
+});
+
+/** e2e files whose tests loop over every phone size (ALL_SIZES, or PHONES with POSTURES). */
+function sizeLoopFiles() {
+  return e2eFiles().filter((f) => /for \(const \w+ of (\[\.\.\.)?(ALL_SIZES|PHONES)\b/.test(read('test', 'e2e', f)));
+}
+test('beta-coverage: the phone checks that run at every size are the ones this suite\'s phone map lists', () => {
+  const files = sizeLoopFiles();
+  for (const f of ['phone-matrix.e2e.js', 'fix-phone-text.e2e.js', 'fix-phone-controls.e2e.js', 'beta-coverage.e2e.js']) {
+    assert.ok(files.includes(f), `${f} no longer loops over every phone size (found: ${files.join(', ')})`);
+  }
+});
+
+test('beta-coverage: the harness keeps its per-test timeout and context cleanup', () => {
+  const h = read('test', 'e2e', 'harness.js');
+  assert.match(h, /E2E_TEST_TIMEOUT/, 'per-test timeout');
+  assert.match(h, /ctx\.cleanup/, 'contexts a failed test left open are closed');
+});
+
+test('[T-9] a failed e2e test prints how long it ran (only passing tests print a time today)', todo('T-9'), () => {
+  const h = read('test', 'e2e', 'harness.js');
+  // The pass line prints `(${Date.now() - start}ms)`; the fail line must too, or a run's time cannot be split by group.
+  const failLine = /console\.log\(`  \\u2717 \$\{t\.name\}([^`]*)`/.exec(h);
+  assert.ok(failLine, 'the fail line is printed');
+  assert.match(failLine[1], /ms\)/, `the fail line prints no duration: ${failLine[0]}`);
+});
+
+test('[T-10] scripts/e2e.js can split a run (--shard=i/n) and list tests without running them (--list)', todo('T-10'), () => {
+  const src = read('scripts', 'e2e.js');
+  assert.match(src, /--shard/, 'no --shard option');
+  assert.match(src, /--list/, 'no --list option');
+});
+
+test('[T-5] the e2e run fails when a board\'s tests all skip because the build lacks that board', todo('T-5'), () => {
+  // Every beta group skips its tests when a board's list is missing from the build ("no <slug> list in this build").
+  // A beta gate that drops Amazon turns dozens of Amazon tests into skips and the run stays green. scripts/e2e.js should
+  // fail (or the coverage group's build check should) when a board the registry lists has no list in the build.
+  const src = read('scripts', 'e2e.js');
+  assert.match(src, /E2E_ALLOW_SKIPS|maxSkips|skipped.*exit|exit.*skipped/, 'skips never fail the run');
+});
+
+/* -------------------------------------------------------------------------------------------- real data (local) */
+
+const SNAP = process.env.MELON_BETA_SNAPSHOT_DIR === '' ? null : path.resolve(process.env.MELON_BETA_SNAPSHOT_DIR || path.join(ROOT, 'data', 'beta', 'snapshots'));
+const DIST = path.resolve(process.env.E2E_DIST || process.env.BETA_QA_DIST || path.join(ROOT, 'dist'));
+const haveData = SNAP && BETA.every((s) => fs.existsSync(path.join(SNAP, `${s}.json`)));
+const haveBuild = fs.existsSync(path.join(DIST, 'beta', 'api', 'jobs'));
+
+test('beta-coverage: the build publishes every beta board with every posting of its snapshot (none dropped, none added)',
+  { skip: !(haveData && haveBuild) && 'needs data/beta/snapshots and a beta build (dist/, E2E_DIST or BETA_QA_DIST)' }, async () => {
+    const { unpackJobs } = await import(pathToFileURL(path.join(ROOT, 'public', 'api.js')).href);
+    const bad = [];
+    for (const slug of BETA) {
+      const snap = JSON.parse(fs.readFileSync(path.join(SNAP, `${slug}.json`), 'utf8'));
+      const want = (snap.jobs || []).length;
+      const f = path.join(DIST, 'beta', 'api', 'jobs', `${slug}.json`);
+      if (!fs.existsSync(f)) { bad.push(`${slug}: not in the build (${want} postings in the snapshot)`); continue; }
+      const got = unpackJobs(JSON.parse(fs.readFileSync(f, 'utf8'))).length;
+      if (got !== want) bad.push(`${slug}: ${got} in the build, ${want} in the snapshot`);
+      const pv = path.join(DIST, 'beta', 'api', 'preview', `${slug}.json`);
+      if (fs.existsSync(pv)) {
+        const total = JSON.parse(fs.readFileSync(pv, 'utf8')).preview?.total;
+        if (total !== got) bad.push(`${slug}: the preview says ${total}, the list has ${got}`);
+      }
+    }
+    assert.deepEqual(bad, [], bad.join('; '));
+  });
diff --git a/test/e2e/beta-coverage.e2e.js b/test/e2e/beta-coverage.e2e.js
new file mode 100644
index 0000000..7e4c6dc
--- /dev/null
+++ b/test/e2e/beta-coverage.e2e.js
@@ -0,0 +1,438 @@
+// Test-suite QA for the beta site (docs/process/qa-suite-beta.md, 2026-10-23): the features of /melon-seek/beta/ that
+// no other group covered on the big-tech boards, found by the coverage map in that log. Each test checks behaviour
+// against numbers computed from the build's own lists (public/api.js getJobs, the jobs the page shows, and
+// viz/palette.js toUSD, the page's own conversion), never a count pinned to one crawl.
+//   - every beta board (from the registry, so a board added later is covered) is in the build, and its count on
+//     screen equals its list and its CSV: a board the build dropped fails here instead of skipping everywhere [T-5];
+//   - Apply on every board, Amazon and Meta included, goes to the posting on that company's own host [T-1];
+//   - the pay filter (minimum, maximum, "only with pay") on every board [T-2];
+//   - the sorts (Highest pay, Lowest pay, Title A–Z) on every board [T-3];
+//   - search lists title matches first on the big boards [T-6];
+//   - a deep link survives a reload, and Back / Forward walk the filter history, on Amazon [T-7];
+//   - at every size in phone-sizes.mjs, the phone flow a job seeker uses: the list opens full, a tapped card opens
+//     its job page, the Back button and the browser's Back close it, and a tapped filter row gives "Show N roles"
+//     equal to its own count and to the list it shows [T-8]. One board per size, in turn, so all seven boards are
+//     covered on phones without loading each board at every size (the runtime finding, T-11).
+// Serves the build (E2E_DIST, else BETA_QA_DIST, else dist/) under /melon-seek/ with one server for the file (gzip
+// cached once per file). Skips without a beta build. Other hosts are aborted.
+import http from 'node:http';
+import fs from 'node:fs';
+import path from 'node:path';
+import zlib from 'node:zlib';
+import { ROOT, assert, assertEq, skip } from './harness.js';
+import { ALL_SIZES, contextFor } from './phone-sizes.mjs';
+import { COMPANIES } from '../../server/companies.js';
+
+const DESKTOP = { width: 1440, height: 900 };
+/** The boards the beta site shows: the registry's non-paused beta companies. */
+const BETA = COMPANIES.filter((c) => c.channel === 'beta' && !c.paused);
+const MAIN_BOARD = 'anduril';
+const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
+const MIME = { '.html': 'text/html; charset=utf-8', '.js': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.svg': 'image/svg+xml', '.png': 'image/png', '.csv': 'text/csv', '.txt': 'text/plain', '.woff2': 'font/woff2', '.webmanifest': 'application/manifest+json' };
+
+let shared = null;
+/** One server for the file. Bodies are read and gzipped once (Amazon's list is 6.8 MB; gzipping it per load costs CPU). */
+async function serveDist() {
+  if (shared) return shared;
+  const dist = path.resolve(process.env.E2E_DIST || process.env.BETA_QA_DIST || path.join(ROOT, 'dist'));
+  if (!fs.existsSync(path.join(dist, 'beta', 'index.html')) || !fs.existsSync(path.join(dist, 'beta', 'api', 'jobs'))) return null;
+  const cache = new Map();
+  const server = http.createServer((req, res) => {
+    const u = new URL(req.url, 'http://x');
+    if (!u.pathname.startsWith('/melon-seek/')) { res.writeHead(302, { location: '/melon-seek/' }); return res.end(); }
+    let rel;
+    try { rel = decodeURIComponent(u.pathname.slice('/melon-seek/'.length)); } catch { res.writeHead(400); return res.end(); }
+    let p = path.join(dist, rel);
+    if (p !== dist && !p.startsWith(dist + path.sep)) { res.writeHead(403); return res.end(); }
+    if (fs.existsSync(p) && fs.statSync(p).isDirectory()) p = path.join(p, 'index.html');
+    if (!fs.existsSync(p)) { res.writeHead(404); return res.end(); }
+    const type = MIME[path.extname(p)] || 'application/octet-stream';
+    let e = cache.get(p);
+    if (!e) {
+      const body = fs.readFileSync(p);
+      e = { body, gz: /text|javascript|json|svg|csv/.test(type) && body.length > 1024 ? zlib.gzipSync(body) : null };
+      cache.set(p, e);
+    }
+    const gz = e.gz && /gzip/.test(req.headers['accept-encoding'] || '');
+    res.writeHead(200, { 'content-type': type, ...(gz ? { 'content-encoding': 'gzip' } : {}) });
+    res.end(gz ? e.gz : e.body);
+  });
+  await new Promise((r) => server.listen(0, '127.0.0.1', r));
+  server.unref();
+  const origin = `http://127.0.0.1:${server.address().port}`;
+  shared = { dist, origin, beta: `${origin}/melon-seek/beta`, main: `${origin}/melon-seek` };
+  return shared;
+}
+
+/** A fresh context: `device` (a phone-sizes.mjs entry) or a desktop viewport. `hash` opens `<site>/#<hash>`. */
+async function open(ctx, { device = null, viewport = DESKTOP, hash = null, site = 'beta' } = {}) {
+  const st = await serveDist();
+  if (!st) skip('no beta build (npm run build, or E2E_DIST=<dir>)');
+  const engine = ctx.browser.browserType?.().name?.() || 'chromium';
+  const opts = device ? contextFor(device, engine) : { viewport, deviceScaleFactor: 1 };
+  const context = await ctx.browser.newContext({ ...opts, colorScheme: 'light' });
+  ctx.cleanup.push(() => context.close().catch(() => {}));
+  const external = [];
+  await context.route((u) => !u.href.startsWith(st.origin) && !u.href.startsWith('data:') && !u.href.startsWith('blob:'), (r) => { external.push(r.request().url()); return r.abort('blockedbyclient'); });
+  const page = await context.newPage();
+  const errors = [];
+  page.on('pageerror', (e) => errors.push(`pageerror: ${String(e && e.message || e).slice(0, 300)}`));
+  page.on('console', (m) => {
+    if (m.type() !== 'error') return;
+    const loc = m.location() && m.location().url;
+    if (/Failed to load resource/.test(m.text()) && (!loc || !loc.startsWith(st.origin))) return;
+    errors.push(`console.error: ${m.text().slice(0, 300)}`);
+  });
+  const base = (s = site) => (s === 'beta' ? st.beta : st.main);
+  if (hash != null) await go(page, `${base()}/#${hash}`);
+  return { st, context, page, errors, external, base };
+}
+/** Load a URL and wait for the whole list (not Amazon's first-page preview). */
+async function go(page, url) {
+  await page.goto(url, { timeout: 60000 });
+  await ready(page);
+}
+async function ready(page, timeout = 90000) {
+  await page.waitForFunction(() => {
+    const t = document.querySelector('#resultsTitle');
+    return t && !/Loading/.test(t.textContent) && /\d\s+role|No roles/.test(t.textContent.replace(/,/g, ''))
+      && (document.querySelector('#resultsList .card[data-id]') || /\b0 roles|No roles/.test(t.textContent));
+  }, null, { timeout });
+  await sleep(300);
+}
+/** Change the hash in place (the board stays loaded) and wait for the list to follow. */
+async function hashTo(page, h) {
+  const before = await page.evaluate(() => document.querySelector('#resultsTitle')?.textContent + '|' + document.querySelector('#resultsList .card[data-id]')?.dataset.id);
+  await page.evaluate((x) => { location.hash = x; }, h);
+  await page.waitForFunction((b) => document.querySelector('#resultsTitle')?.textContent + '|' + document.querySelector('#resultsList .card[data-id]')?.dataset.id !== b, before, { timeout: 15000 }).catch(() => {});
+  await ready(page);
+}
+async function count(page) {
+  const m = (await page.locator('#resultsTitle').innerText()).replace(/,/g, '').match(/(\d+)\s+role/);
+  if (!m && /No roles/.test(await page.locator('#resultsTitle').innerText())) return 0;
+  assert(m, `no role count in the results title ("${await page.locator('#resultsTitle').innerText()}")`);
+  return Number(m[1]);
+}
+const params = async (page) => new URLSearchParams(await page.evaluate(() => location.hash.slice(1)));
+const cardIds = (page, n = 30) => page.$$eval('#resultsList .card[data-id]', (els, k) => els.slice(0, k).map((e) => e.dataset.id), n);
+
+/**
+ * In the page: the board's jobs as the app gets them, with the approx-USD pay the page filters and sorts on
+ * (public/app.js prepare(): min ??= max, max ??= min, mid ??= (min + max) / 2, each through toUSD). Returns a summary,
+ * not 22,179 jobs. `ids` asks for those jobs' pay and titles.
+ */
+function boardFacts(page, base, company, ids = []) {
+  return page.evaluate(async ({ base, company, ids }) => {
+    const api = await import(`${base}/api.js`);
+    const { toUSD } = await import(`${base}/viz/palette.js`);
+    const res = await api.getJobs({ company });
+    const usd = (j) => {
+      const s = j.salary;
+      if (!s || (s.min == null && s.max == null)) return null;
+      const min = s.min ?? s.max, max = s.max ?? s.min, mid = s.mid ?? (min + max) / 2;
+      const u = { min: toUSD(min, s.currency), max: toUSD(max, s.currency), mid: toUSD(mid, s.currency) };
+      return Number.isFinite(u.min) && Number.isFinite(u.max) ? u : null;
+    };
+    const jobs = res.jobs.map((j) => ({ id: j.id, url: j.url || null, team: j.team || '', title: j.title, usd: usd(j) }));
+    const paid = jobs.filter((j) => j.usd);
+    const med = (a) => { const s = a.slice().sort((x, y) => x - y); return s.length ? s[Math.floor(s.length / 2)] : null; };
+    const want = new Set(ids);
+    return {
+      mode: res.mode, n: jobs.length, paid: paid.length,
+      medMax: med(paid.map((j) => j.usd.max)), medMin: med(paid.map((j) => j.usd.min)),
+      maxMid: paid.length ? Math.max(...paid.map((j) => j.usd.mid)) : null,
+      minMid: paid.length ? Math.min(...paid.map((j) => j.usd.mid)) : null,
+      maxes: paid.map((j) => j.usd.max), mins: paid.map((j) => j.usd.min),
+      pick: jobs.filter((j) => want.has(j.id)),
+      sampleIds: [jobs[0], jobs[Math.floor(jobs.length / 2)], jobs[jobs.length - 1]].filter(Boolean).map((j) => j.id),
+      urls: Object.fromEntries([jobs[0], jobs[Math.floor(jobs.length / 2)], jobs[jobs.length - 1]].filter(Boolean).map((j) => [j.id, j.url])),
+    };
+  }, { base, company, ids });
+}
+async function needBoard(page, base, slug) {
+  const f = await boardFacts(page, base, slug);
+  assert(f.mode === 'snapshot' || f.mode === 'cache', `${slug}: the build serves it as "${f.mode}", not its snapshot`);
+  assert(f.n > 0, `${slug}: no postings in the build`);
+  return f;
+}
+/** Records in a CSV, counting quoted newlines as part of their field (RFC 4180). */
+function csvRecords(text) {
+  let n = 0, q = false, any = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (c === '"') q = !q;
+    else if (c === '\n' && !q) { if (any) n++; any = false; continue; }
+    if (c !== '\r') any = true;
+  }
+  return n + (any ? 1 : 0);
+}
+const roundTo = (x, step) => Math.round(x / step) * step;
+const allowedHosts = (c) => new Set([...(c.postingHosts || []), ...(c.postingPrefixes || []).map((p) => new URL(p).hostname)].map((h) => h.replace(/^www\./, '')));
+
+/** A real tap at an element's centre (phones), a click elsewhere. */
+async function tap(page, locator, { dx = null } = {}) {
+  await locator.scrollIntoViewIfNeeded().catch(() => {});
+  const b = await locator.boundingBox();
+  assert(b, 'nothing to tap (no box)');
+  const touch = await page.evaluate(() => matchMedia('(pointer: coarse)').matches);
+  const x = b.x + (dx == null ? b.width / 2 : Math.min(dx, b.width - 2)), y = b.y + b.height / 2;
+  if (touch) await page.touchscreen.tap(x, y); else await page.mouse.click(x, y);
+}
+
