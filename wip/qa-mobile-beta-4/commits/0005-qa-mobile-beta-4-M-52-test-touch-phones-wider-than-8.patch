 test/e2e/beta-mobile-qa-4.e2e.js | 29 +++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/test/e2e/beta-mobile-qa-4.e2e.js b/test/e2e/beta-mobile-qa-4.e2e.js
index d2e77d0..f88cb22 100644
--- a/test/e2e/beta-mobile-qa-4.e2e.js
+++ b/test/e2e/beta-mobile-qa-4.e2e.js
@@ -262,6 +262,35 @@ export function registerBetaMobileQa4Tests(suite) {
     assert(!bad.length, `price pins that no tap can reach on the first map view:\n  ${bad.join('\n  ')}`);
   });
 
+  suite.test('Beta mobile QA 4: [M-52] touch phones wider than 860 px (iPhone 15 Pro Max landscape 932x430, Razr inner landscape 1005x412, Surface Duo spanned 1114x720) get 44 px controls and 16 px fields', async (ctx) => {
+    const IOS18 = 'Mozilla/5.0 (iPhone; CPU iPhone OS 18_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.6 Mobile/15E148 Safari/604.1';
+    // The iPhone Pro Max in landscape is not in phone-sizes.mjs; it is the iPhone most likely to be over 860 px.
+    const devices = [{ name: 'iPhone 15 Pro Max (landscape)', width: 932, height: 430, dpr: 3, ua: IOS18, platform: 'ios' }, size(1005, 412), size(1114, 720)];
+    const bad = [];
+    for (const d of devices) {
+      const { page, go } = await phone(ctx, d, { hash: 'c=apple' });
+      const ctl = await page.evaluate(() => {
+        const out = [];
+        for (const [name, sel] of [['company menu', '#companyMenuBtn'], ['search', '#search'], ['view switch', '.topbar .seg button'], ['data badge', '#dataBadge'], ['theme', '#themeBtn'], ['Filters', '#filtersToggle'], ['quick chip', '#quickChips > *'], ['sort', '#sortBy'], ['Clusters/Ranges', '#vizControls button']]) {
+          const e = [...document.querySelectorAll(sel)].find((x) => x.getClientRects().length);
+          if (!e) continue;
+          const r = e.getBoundingClientRect();
+          const fs = e.matches('input, select') ? parseFloat(getComputedStyle(e).fontSize) : null;
+          if (Math.min(r.width, r.height) < 43.5) out.push(`${name} ${Math.round(r.width)}x${Math.round(r.height)}`);
+          if (fs !== null && fs < 16) out.push(`${name} font ${fs} px`);
+        }
+        return out;
+      });
+      await go('c=apple&m=insights', 600);
+      await page.waitForSelector('#compHost input', { timeout: 60000 });
+      await sleep(600);
+      const fields = await page.evaluate(() => [...document.querySelectorAll('#compHost input, #insightsHost select')].filter((e) => e.getClientRects().length && !/checkbox|radio|hidden|range/.test(e.type)).map((e) => parseFloat(getComputedStyle(e).fontSize)).filter((f) => f < 16));
+      if (fields.length) ctl.push(`${fields.length} Insights field(s) at ${[...new Set(fields)].join('/')} px`);
+      if (ctl.length) { bad.push(`${d.name} ${d.width}x${d.height}: ${ctl.join(', ')}`); await shot(page, `e2e-M-52-wide-touch-${d.width}x${d.height}`); }
+    }
+    assert(!bad.length, `mouse-sized controls on a touch phone (iOS zooms the page into any field under 16 px):\n  ${bad.join('\n  ')}`);
+  });
+
   suite.test('Beta mobile QA 4: [M-51] the job page\'s meta line never starts or ends a line with "·" (Amazon and Meta top roles, 390 and 360)', async (ctx) => {
     const bad = [];
     for (const d of [size(390, 844), size(360, 740)]) {
