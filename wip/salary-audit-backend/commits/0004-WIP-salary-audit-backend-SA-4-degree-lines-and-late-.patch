From: Claude <noreply@anthropic.com>
Date: Fri, 16 Oct 2026 14:55:05 +0000
Subject: [PATCH 4/8] WIP salary-audit-backend: SA-4 degree lines and late
 Microsoft level paragraphs as salary.levels, SA-7 stored salary kept when
 trimming cut its pay sentence (salary-audit-data patches, normalize/salary
 hunks)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014jaqot5Ddmi7Co6CofBiyc
---
 server/normalize.js          | 11 ++++++++++-
 server/salary.js             | 19 ++++++++++++++++++-
 test/salary-pipeline.test.js | 11 +++++++++++
 3 files changed, 39 insertions(+), 2 deletions(-)

diff --git a/server/normalize.js b/server/normalize.js
index 18cd081..c0d8e20 100644
--- a/server/normalize.js
+++ b/server/normalize.js
@@ -35,7 +35,9 @@ import { vetSalaries, salaryChecks } from './vet.js';
  * compensation as 'ote', Meta salary.country, Amazon "III", Meta leadership and Microsoft IC/M
  * levels, ISO-3 country codes, "20h per week"); norm-11 = the salary audit (docs/process/salary-audit-backend.md:
  * every posted range kept (no cap at 12), Amazon "New York City" rows tied to New York, Microsoft's SF Bay
- * Area / NYC range kept per place for jobs with places inside and outside those areas). Stored
+ * Area / NYC range kept per place for jobs with places inside and outside those areas, Google degree lines
+ * and late Microsoft level paragraphs kept as salary.levels, a stored salary kept when trimming cut its
+ * pay sentence). Stored
  * snapshots are upgraded with relocateJobs (which also re-derives text-sourced pay, the
  * pay labels and the level, then re-runs the vetting gate) and rekeyBoardJobs.
  */
@@ -214,6 +216,9 @@ function relabelSalary(sal, { text, title, employmentType, countries }) {
   return payTerms(s, { text, title, employmentType, salesRole: isSalesTitle(title) });
 }
 
+/** The marker scripts/snapshot.js#trimDescription leaves where it cut a description. */
+const TRIMMED_RE = /\[…\] Full description on the posting page\./;
+
 /**
  * The salary a STORED posting gets from the current parser (norm-7, the beta fix wave:
  * DQ-5, DQ-6, DQ-8 levels, DQ-13, DQ-14, DQ-15, D-22, D-30): its text-sourced salary, or
@@ -231,6 +236,10 @@ function rederiveTextSalary(j, text) {
   // unclear") instead of the upgrade erasing the record. A plausible stored figure that the
   // text no longer supports (a union pay floor) is dropped.
   if (!fresh && sal && salaryChecks({ title: j.title, employmentType: j.employmentType }, sal).length) return undefined;
+  // SA-7 (salary audit): a stored description trimmed to fit the snapshot (scripts/snapshot.js
+  // trimDescription) may have lost the pay sentence the stored salary was read from; the trimmed text
+  // then says nothing about pay, so the stored salary is kept, never erased.
+  if (!fresh && sal && TRIMMED_RE.test(text)) return undefined;
   // A text salary that replaced a rejected structured one keeps that record and its zones.
   if (fresh && sal && sal.structuredRejected) return withPayPlaces({ ...fresh, zones: Math.max(fresh.zones || 1, sal.zones || 1), structuredRejected: sal.structuredRejected }, sal.places, j.locations);
   // The places the stored pay was posted for (DQ-27) are the adapter's knowledge, not the text's.
diff --git a/server/salary.js b/server/salary.js
index 3a5bee2..aa463b5 100644
--- a/server/salary.js
+++ b/server/salary.js
@@ -379,6 +379,8 @@ function cashCompOteBefore(before, text) {
 // $333000 (USD) + 25% bonus target + equity + benefits": a base range with the
 // extras named after it. This is pay context, and the bonus is not the amount.
 const PLUS_EXTRAS_AFTER_RE = /^\s*(?:\(?(?:USD|CAD|GBP|EUR|AUD|SGD|CHF|INR|JPY|ILS|PLN|SEK|DKK|NOK|RON|CZK)\)?\s*)?(?:per\s+(?:year|annum|hour)\s*)?(?:\+|plus\b)\s*(?:an?\s+)?(?:\d{1,3}(?:\.\d{1,2})?%\s+)?(?:annual\s+|target\s+)?(?:bonus|equity|benefits|commission|stock|rsus?)\b/i;
+// The last "<level code> - The typical base pay range …" before an amount (SA-4).
+const NATIONAL_LEVEL_RE = /\b((?:IC|M|L)\d{1,2}|ATR-?[A-Z0-9]{1,3})\s+[-–—]\s+the typical\b(?![\s\S]*\bthe typical\b)/i;
 const NATIONAL_RE = /\btypical\s+base\s+pay\s+range\s+for\s+this\s+role\s+across\s+(?:the\s+)?([A-Z][\w.]*(?:\s+[A-Z][\w.]*){0,2})\s+is\b[^$£€¥\d]{0,12}$/;
 const NATION_CODE = Object.freeze({
   'u.s': 'US', us: 'US', usa: 'US', 'united states': 'US', canada: 'CA', 'united kingdom': 'GB', uk: 'GB', 'u.k': 'GB',
@@ -426,6 +428,16 @@ function sentenceCountry(before) {
   }
   return code;
 }
+// SA-4 (salary audit): Google prices one country by degree on separate lines ("[Bachelor's degree] Canada:
+// $99000 (CAD)", "[Master's degree] Canada: $102000 (CAD)"). The bracket before the country label names the
+// line, so a span of the lines keeps each line as a level (salary.levels), as Microsoft's IC levels do.
+const LINE_BRACKET_RE = /^\s*\[([^\]\n]{2,40})\]\s*[A-Z][A-Za-z. ]{1,40}:\s*$/;
+function lineBracket(text, start) {
+  const from0 = Math.max(0, start - 120);
+  const from = from0 + text.slice(from0, start).lastIndexOf('\n') + 1;
+  const m = LINE_BRACKET_RE.exec(text.slice(from, start));
+  return m && lineLabel(text, start) ? m[1].trim() : null;
+}
 /** ISO code of the country that labels the amount's line, or null. */
 function lineCountry(text, start) {
   const l = lineLabel(text, start);
@@ -899,7 +911,12 @@ function evaluate(text, u, countries) {
   // city ranges that follow ("…in those locations is…") are not national.
   const nat = NATIONAL_RE.exec(before);
   const national = nat ? nat[1].replace(/\s+/g, ' ').toLowerCase() : null;
-  const level = national ? (/^\s*(.{2,60}?)\s+[-–—]\s+the typical\b/i.exec(before) || [])[1] || null : null;
+  // SA-4 (salary audit): when the clause starts earlier than the level's own line (Microsoft separates
+  // repeated pay paragraphs with escaped "<p></p>" tags and a pay link, so no sentence break precedes
+  // "Solution Area Specialists IC5 - The typical …"), the level code just before "- The typical" names it.
+  const level = national
+    ? (/^\s*(.{2,60}?)\s+[-–—]\s+the typical\b/i.exec(before) || [])[1] || (NATIONAL_LEVEL_RE.exec(before) || [])[1] || null
+    : lineBracket(text, gs);
   // One posting may list a national range per country ("across Ireland", "across
   // Germany"): the one for the job's own country scores highest.
   const natCode = national ? NATION_CODE[national.replace(/\.$/, '')] || null : null;
diff --git a/test/salary-pipeline.test.js b/test/salary-pipeline.test.js
index 76c429b..fa68b48 100644
--- a/test/salary-pipeline.test.js
+++ b/test/salary-pipeline.test.js
@@ -157,6 +157,17 @@ test('SB-5 the national-only and area-only cases are unchanged', () => {
   assert.deepEqual(p.cityRange, { min: 160200, max: 261000, areas: ['sf-bay', 'nyc'] });
 });
 
+// SA-4 (salary-audit-data's finding, fixed here; its Google degree-line test is in test/salary-audit.test.js).
+// microsoft:1970393556984110 "Senior Sales Specialist -Cloud & AI Platforms": two level paragraphs, IC4 and
+// IC5, separated by escaped "<p></p>" tags and a pay link, so the IC5 clause starts far before its level.
+// The span IC4 min to IC5 max was shown with only IC4 named ("Solution Area Specialists IC4: …; USD …").
+test('SA-4 Microsoft: a level paragraph after a pay link keeps its level (IC4 and IC5 both named)', () => {
+  const text = "Solution Area Specialists IC4 - The typical base pay range for this role across the U.S. is USD $107,600 - $187,500 per year. <p></p> <p>Certain roles may be eligible for benefits and other compensation. Find additional benefits and pay information here:<br/><a href=' https://careers.microsoft.com/us/en/us-corporate-pay '> https://careers.microsoft.com/us/en/us-corporate-pay </a></p><p></p> <p>Solution Area Specialists IC5 - The typical base pay range for this role across the U.S. is USD $133,000 - $222,700 per year.";
+  const p = parseSalary(text, { countries: ['US'] });
+  assert.deepEqual([p.min, p.max], [107600, 222700], 'reference: the span of the two levels');
+  assert.deepEqual((p.levels || []).map((l) => [l.label, l.min, l.max]), [['IC4', 107600, 187500], ['IC5', 133000, 222700]]);
+});
+
 /* -------------------------------------------------------------------- chart */
 // Reference (no defect): the chart plots each posting's own min, max and midpoint in approx USD,
 // exactly the served salary (the trace found 0 differences on 32,000+ postings).
